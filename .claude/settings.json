{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Edit(/README.md)",
      "Edit(/AGENTS.md)",
      "Edit(/Makefile)",
      "Edit(/**/CLAUDE.md)",
      "Edit(/.agents/skills/**)",
      "Edit(/ansible/**)",
      "Edit(/contract/**)",
      "Edit(/docs/**)",
      "Edit(/openspec/**)",
      "Edit(/scripts/**)",
      "Edit(/terraform/**)",
      "Edit(/tests/**)",
      "Edit(/tools/**)",
      "Edit(/vpnd/**)"
    ],
    "deny": [
      "Read(./secrets/local/keys/**)",
      "Read(./secrets/local/recovery/**)",
      "Read(./secrets/local/state-backups/**)",
      "Read(.env)",
      "Read(.envrc)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(//**/*.secrets.yaml)",
      "Read(//**/*.secrets.yml)",
      "Read(//**/*.sops.yaml.dec)",
      "Read(//**/*.sops.json.dec)",
      "Read(//**/vpn-blue-green.*/**)"
    ]
  }
}
