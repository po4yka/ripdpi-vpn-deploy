{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Edit(/README.md)",
      "Edit(/docs/explanation/**/*.md)",
      "Edit(/docs/how-to/**/*.md)",
      "Edit(/tests/unit/**/*.py)",
      "Edit(/vpnd/src/**/*.py)",
      "Edit(/vpnd/tests/**/*.py)"
    ],
    "deny": [
      "Read(./secrets/local/*/*/**)",
      "Read(./secrets/local/README.md)",
      "Read(./secrets/local/.*)",
      "Read(.env)",
      "Read(.envrc)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(//**/*.secrets.yaml)",
      "Read(//**/*.secrets.yml)",
      "Read(//**/*.sops.yaml.dec)",
      "Read(//**/*.sops.json.dec)",
      "Read(//**/vpn-blue-green.*/**)"
    ]
  }
}
