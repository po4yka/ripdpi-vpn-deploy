# Terraform
.terraform/
.terraform-env/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
terraform/providers/*/.terraform/
terraform/providers/*/*.tfstate
terraform/providers/*/*.tfstate.*
terraform/providers/*/*.tfplan
terraform/providers/*/environments/*.tfvars
!terraform/providers/*/environments/*.tfvars.example

# Ansible
ansible/inventory/generated.ini
*.retry
.ansible/
.ansible-cache/

# Secrets
secrets/*
!secrets/README.md
!secrets/.gitkeep
!secrets/prod.secrets.example.yaml
!secrets/.sops.yaml.example
!secrets/schema.json
.env
.envrc
.fleet.mk
*.key
*.pem
*.age
# Exception: test-only age identity (allowlisted in .gitleaks.toml)
!tests/fixtures/age-test.key

# Decrypted SOPS files
*.sops.yaml.dec
*.sops.json.dec

# Python
.venv/
venv/
__pycache__/
*.pyc

# Molecule
**/molecule/**/.molecule/
**/molecule/**/__pycache__/

# Operator-side artifacts (not for git)
state-backups/
share/
output/
tmp/
vpnd/state/
vpnd/config/*.yaml
# Client credential QR payloads
*.qr.png
*.qr.png.*

# Tasking toolchain dependencies (reproducible via make task-tools)
tools/tasking/node_modules/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# pre-commit
.pre-commit-cache/

# pytest
.pytest_cache/

# Claude Code / oh-my-claudecode local state
# Track project-scoped skills only; ignore runtime state under .claude/.
/.claude/*
!/.claude/skills/
.omc/
.omo/

# Generated deployment and Cargo SBOMs, and staged release assets
sbom/*.json
/vpnd/sbom.json
/dist/
