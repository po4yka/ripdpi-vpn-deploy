{# `_inst` is the shared admitted effective instance, never an independent legacy peer collection. #}
{%- set _listen_port = _inst.listen_port %}
{%- set _addr_v4 = _inst.address_v4 %}
{%- set _addr_v6 = _inst.address_v6 %}
[Interface]
PrivateKey = {{ _inst.server_private_key }}
Address    = {{ _addr_v4 }}, {{ _addr_v6 }}
ListenPort = {{ _listen_port }}
MTU = {{ _inst.mtu }}

# AmneziaWG obfuscation parameters (mandatory; not standard WireGuard).
Jc = {{ _inst.jc }}
Jmin = {{ _inst.jmin }}
Jmax = {{ _inst.jmax }}
S1 = {{ _inst.s1 }}
S2 = {{ _inst.s2 }}
H1 = {{ _inst.h1 }}
H2 = {{ _inst.h2 }}
H3 = {{ _inst.h3 }}
H4 = {{ _inst.h4 }}
{% for index in range(1, 6) if ("i" ~ index) in _inst %}I{{ index }} = {{ _inst["i" ~ index] }}
{% endfor %}

{% for peer in _inst.peers %}
[Peer]
# {{ peer.name }}
PublicKey  = {{ peer.public_key }}
PresharedKey = {{ peer.preshared_key }}
AllowedIPs = {{ peer.allowed_ips.values() | join(', ') }}
{% endfor -%}
