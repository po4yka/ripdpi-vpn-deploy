[Unit]
Description=Verify VPN backup with an isolated restore drill
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vpn-backup-restore-drill.sh
RuntimeDirectory=vpn-backup-restore-drill
RuntimeDirectoryMode=0700
StateDirectory=vpn-backup
StateDirectoryMode=0700
UMask=0077
# Same hardening floor as vpn-backup.service. The drill writes its runtime and
# state directories, which systemd keeps writable under ProtectSystem=strict.
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
{% if not (backup.remote.enabled | default(false)) %}
# restic takes a non-exclusive lock inside a local repository even to read it.
ReadWritePaths={{ restic_repo_dir }}
{% endif %}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
