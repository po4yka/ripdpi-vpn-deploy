#!/usr/bin/env bash
# Managed by Ansible role `backup`. Restores into private runtime storage only.
set -euo pipefail
umask 077

: "${RUNTIME_DIRECTORY:?systemd must provide RUNTIME_DIRECTORY}"
: "${STATE_DIRECTORY:?systemd must provide STATE_DIRECTORY}"

export RESTIC_PASSWORD_FILE=/etc/restic/password
{% if backup.remote.enabled | default(false) %}
export RCLONE_CONFIG=/etc/rclone/rclone.conf
REPO="rclone:{{ backup.remote.rclone_remote }}:{{ backup.remote.rclone_path }}/$(hostname)"
REPOSITORY_SOURCE="remote"
{% else %}
REPO="{{ restic_repo_dir }}"
REPOSITORY_SOURCE="local"
{% endif %}

restore_target="${RUNTIME_DIRECTORY}/restore"
snapshot_metadata=""
marker="${STATE_DIRECTORY}/restore-drill-last-success.json"
marker_tmp=""

# Claim the target atomically. A prior directory, file, or dangling symlink is
# not ours, and must fail before any cleanup is armed.
mkdir -- "$restore_target"
restore_owned=true

remove_restore() {
  if [[ "$restore_owned" == true ]]; then
    restore_owned=false
    rm -rf -- "$restore_target"
    test ! -e "$restore_target" && test ! -L "$restore_target"
  fi
}

cleanup() {
  local status=$?
  remove_restore || status=1
  if [[ -n "$snapshot_metadata" ]]; then
    rm -f -- "$snapshot_metadata" || status=1
  fi
  if [[ -n "$marker_tmp" ]]; then
    rm -f -- "$marker_tmp" || status=1
  fi
  exit "$status"
}
trap cleanup EXIT

snapshot_metadata=$(mktemp "${RUNTIME_DIRECTORY}/.snapshot.XXXXXXXXXX")
restic -r "$REPO" --no-cache snapshots --tag vpn-stack --latest 1 --json > "$snapshot_metadata"

mapfile -t snapshot < <(python3 - "$snapshot_metadata" <<'PY'
import datetime as dt
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    snapshots = json.load(handle)
if not snapshots:
    raise SystemExit("no vpn-stack snapshot")
snapshot = snapshots[-1]
snapshot_time = dt.datetime.fromisoformat(snapshot["time"].replace("Z", "+00:00"))
age = dt.datetime.now(dt.timezone.utc) - snapshot_time.astimezone(dt.timezone.utc)
if age > dt.timedelta(hours={{ backup_snapshot_max_age_hours | int }}):
    raise SystemExit(f"latest vpn-stack snapshot is stale: {age}")
print(snapshot["id"])
print(snapshot["time"])
PY
)
snapshot_id="${snapshot[0]:?snapshot id missing}"
snapshot_time="${snapshot[1]:?snapshot time missing}"

restic -r "$REPO" --no-cache restore "$snapshot_id" --target "$restore_target"

restored_path() {
  # Absolute links belong to the archived filesystem, never the live host.
  python3 - "$restore_target" "$1" <<'PY'
import os
import stat
import sys
from pathlib import Path, PurePosixPath

root = Path(sys.argv[1]).resolve(strict=True)
pending = list(PurePosixPath(sys.argv[2]).parts)
parts = []
links = 0
try:
    while pending:
        part = pending.pop(0)
        if part in ('', '.'):
            continue
        if part == '/' or (part == '..' and not parts):
            raise ValueError
        if part == '..':
            parts.pop()
            continue
        candidate = root.joinpath(*parts, part)
        info = candidate.lstat()
        if stat.S_ISLNK(info.st_mode):
            links += 1
            if links > 40:
                raise ValueError
            target = PurePosixPath(os.readlink(candidate))
            if target.is_absolute():
                parts = []
                target = target.relative_to('/')
            pending = list(target.parts) + pending
        else:
            parts.append(part)
    print(root.joinpath(*parts))
except (OSError, ValueError):
    raise SystemExit('restore drill: required artifact unavailable in snapshot') from None
PY
}

require_file() {
  local relative_path="$1"
  local artifact
  artifact="$(restored_path "$relative_path")" || return 1
  if [[ ! -f "$artifact" || ! -s "$artifact" ]]; then
    echo "restore drill: required artifact missing or empty: $relative_path" >&2
    return 1
  fi
}

require_regular_file() {
  local artifact
  artifact="$(restored_path "$1")" || return 1
  [[ -f "$artifact" ]] || return 1
}

require_directory() {
  local artifact
  artifact="$(restored_path "$1")" || return 1
  [[ -d "$artifact" ]] || return 1
}

validate_json() {
  local artifact
  artifact="$(restored_path "$1")" || return 1
  python3 -m json.tool "$artifact" >/dev/null
}

require_nonempty_directory() {
  local relative_path="$1"
  local artifact
  artifact="$(restored_path "$relative_path")" || return 1
  if [[ ! -d "$artifact" ]] ||
     ! find "$artifact" -maxdepth 1 -type f -size +0c -print -quit | grep -q .; then
    echo "restore drill: required artifact directory empty: $relative_path" >&2
    return 1
  fi
}

require_file "etc/nftables.conf"
require_file "etc/ssh/sshd_config.d/20-ansible-hardening.conf"
require_file "etc/sysctl.d/90-vpn.conf"
require_nonempty_directory "etc/systemd/system"
{% if not (vpn_subscription_only | default(false)) and ((vpn.enable_xray_reality | default(true)) or (vpn.enable_nginx_xhttp | default(true))) %}
require_file "{{ xray_etc_dir | default(xray_config_dir | default('/etc/xray')) | regex_replace('^/', '') }}/config.json"
validate_json "{{ xray_etc_dir | default(xray_config_dir | default('/etc/xray')) | regex_replace('^/', '') }}/config.json"
{% endif %}
{% if not (vpn_subscription_only | default(false)) and (vpn.enable_nginx_xhttp | default(true)) %}
require_file "etc/nginx/sites-available/vpn-xhttp.conf"
require_file "etc/nginx/tls/{{ nginx_xhttp.server_name }}.fullchain.pem"
require_file "etc/nginx/tls/{{ nginx_xhttp.server_name }}.key"
{% if nginx_xhttp.fallback_enabled | default(false) and
      (nginx_xhttp.fallback_server_name | default(nginx_xhttp.server_name)) != nginx_xhttp.server_name %}
require_file "etc/nginx/tls/{{ nginx_xhttp.fallback_server_name }}.fullchain.pem"
require_file "etc/nginx/tls/{{ nginx_xhttp.fallback_server_name }}.key"
{% endif %}
{% endif %}
{% if not (vpn_subscription_only | default(false)) and (vpn.enable_hysteria | default(true)) %}
require_file "{{ hysteria_config_dir | default('/etc/hysteria') | regex_replace('^/', '') }}/config.yaml"
require_file "{{ hysteria_config_dir | default('/etc/hysteria') | regex_replace('^/', '') }}/server.fullchain.pem"
require_file "{{ hysteria_config_dir | default('/etc/hysteria') | regex_replace('^/', '') }}/server.key"
{% endif %}
{% if not (vpn_subscription_only | default(false)) and (vpn.enable_snell | default(false)) %}
require_file "etc/snell/config.json"
validate_json "etc/snell/config.json"
{% endif %}
{% if not (vpn_subscription_only | default(false)) and (vpn.enable_amneziawg | default(true)) %}
{% for instance in amneziawg_secrets.instances %}
require_file "{{ amneziawg_config_dir | regex_replace('^/', '') }}/{{ instance.name }}.conf"
{% endfor %}
{% endif %}

{% set primary = not (vpn_subscription_only | default(false)) %}
{% if (primary and ((vpn.enable_nginx_xhttp | default(true)) or (vpn.enable_cdn_front | default(false)) or (vpn.enable_probe_matrix_target | default(false)))) or (vpn.enable_subscription_host | default(false)) or (vpn_subscription_only | default(false)) %}
require_nonempty_directory "etc/nginx"
{% endif %}
{% if primary and vpn.enable_naive | default(false) %}
require_file "{{ (naive | default({})).config_dir | default('/etc/naive') | regex_replace('^/', '') }}/Caddyfile"
require_file "{{ (naive | default({})).config_dir | default('/etc/naive') | regex_replace('^/', '') }}/server.fullchain.pem"
require_file "{{ (naive | default({})).config_dir | default('/etc/naive') | regex_replace('^/', '') }}/server.key"
{% endif %}
{% if primary and vpn.enable_hysteria_realm | default(false) %}
require_file "{{ (hysteria_realm | default({})).config_dir | default('/etc/hysteria-realm') | regex_replace('^/', '') }}/config.json"
validate_json "{{ (hysteria_realm | default({})).config_dir | default('/etc/hysteria-realm') | regex_replace('^/', '') }}/config.json"
require_file "{{ (hysteria_realm | default({})).tls_cert_path | default(((hysteria_realm | default({})).config_dir | default('/etc/hysteria-realm')) ~ '/server.fullchain.pem') | regex_replace('^/', '') }}"
require_file "{{ (hysteria_realm | default({})).tls_key_path | default(((hysteria_realm | default({})).config_dir | default('/etc/hysteria-realm')) ~ '/server.key') | regex_replace('^/', '') }}"
{% endif %}
{% if primary and vpn.enable_dns_morph_bridge | default(false) %}
require_file "{{ (dns_morph_bridge | default({})).config_dir | default('/etc/dns-morph-bridge') | regex_replace('^/', '') }}/dns-morph-bridge.yaml"
require_file "etc/unbound/unbound.conf.d/dns-morph-bridge-fwd.conf"
{% endif %}
{% for flag, settings in [
    ('cascade_ingress', cascade_ingress | default({})),
    ('cascade_egress', cascade_egress | default({})),
    ('split_hop_ingress', split_hop_ingress | default({})),
    ('split_hop_egress', split_hop_egress | default({}))] %}
{% if primary and vpn['enable_' ~ flag] | default(false) %}
require_file "etc/wireguard/{{ settings.wg_interface | default({'cascade_ingress': 'csi0', 'cascade_egress': 'cse0', 'split_hop_ingress': 'shop0', 'split_hop_egress': 'shop0'}[flag]) }}.conf"
{% endif %}
{% endfor %}
{% if primary and vpn.enable_cascade_ingress | default(false) %}
require_file "{{ (cascade_ingress | default({})).classifier_proxy_password_path | default('/etc/cascade/classifier-proxy.password') | regex_replace('^/', '') }}"
require_file "{{ (cascade_ingress | default({})).classifier_interface_path | default('/etc/cascade/classifier-interface.json') | regex_replace('^/', '') }}"
validate_json "{{ (cascade_ingress | default({})).classifier_interface_path | default('/etc/cascade/classifier-interface.json') | regex_replace('^/', '') }}"
require_file "{{ (cascade_ingress | default({})).policy_path | default('/etc/wireguard/cascade-ingress.nft') | regex_replace('^/', '') }}"
{% endif %}
{% if primary and vpn.enable_probe_matrix_target | default(false) %}
require_file "etc/probe-matrix/xray.json"
validate_json "etc/probe-matrix/xray.json"
require_file "etc/probe-matrix/mtg.toml"
require_file "etc/probe-matrix/tls.crt"
require_file "etc/probe-matrix/tls.key"
require_file "etc/nginx/sites-available/probe-matrix-tls.conf"
require_file "etc/nginx/sites-enabled/probe-matrix-tls.conf"
{% endif %}
{% if primary and vpn.enable_cdn_front | default(false) %}
require_file "etc/nginx/sites-available/cdn-front.conf"
require_file "etc/nginx/sites-enabled/cdn-front.conf"
require_file "etc/nginx/tls/{{ cdn_front.server_name }}.fullchain.pem"
require_file "etc/nginx/tls/{{ cdn_front.server_name }}.key"
require_file "{{ cdn_front.cf_prefix_dir | default('/etc/cdn-front') | regex_replace('^/', '') }}/cloudflare.real_ip"
require_file "{{ cdn_front.cf_prefix_dir | default('/etc/cdn-front') | regex_replace('^/', '') }}/cloudflare.v4"
require_file "{{ cdn_front.cf_prefix_dir | default('/etc/cdn-front') | regex_replace('^/', '') }}/cloudflare.v6"
{% if cdn_front.aop_cert_path | default('') %}
require_file "{{ cdn_front.aop_cert_path | regex_replace('^/', '') }}"
{% endif %}
{% endif %}
{% if (vpn.enable_subscription_host | default(false)) or (vpn_subscription_only | default(false)) %}
require_file "etc/nginx/sites-available/vpn-sub.conf"
require_file "etc/nginx/sites-enabled/vpn-sub.conf"
require_file "etc/nginx/conf.d/vpn-sub-ratelimit.conf"
require_file "etc/nginx/tls/subscription-host/server.key"
require_file "etc/nginx/tls/subscription-host/server.fullchain.pem"
require_directory "{{ (subscription | default({})).subscription_dir | default('/var/lib/vpn-subscription') | regex_replace('^/', '') }}"
# An empty revocation set is valid authority; absence is not.
require_regular_file "{{ (subscription | default({})).revoked_file | default('/var/lib/vpn-subscription/revoked') | regex_replace('^/', '') }}"
{% endif %}
{% if vpn.enable_watchdog | default(true) %}
require_file "etc/vpn-watchdog.env"
require_file "etc/vpn-watchdog-notifications.json"
{% if primary and vpn.enable_xray_reality | default(true) %}
require_file "etc/vpn-watchdog-reality.json"
{% endif %}
{% endif %}

# Restored files contain live credentials. Remove and verify cleanup before
# publishing any success signal.
remove_restore
rm -f -- "$snapshot_metadata"
snapshot_metadata=""

marker_tmp=$(mktemp "${STATE_DIRECTORY}/.restore-drill-last-success.json.XXXXXXXXXX")
python3 - "$marker_tmp" "$marker" "$REPOSITORY_SOURCE" "$snapshot_id" "$snapshot_time" <<'PY'
import datetime as dt
import json
import os
import sys

path, marker_path, repository_source, snapshot_id, snapshot_time = sys.argv[1:]
payload = {
    "version": 1,
    "repository_source": repository_source,
    "snapshot_id": snapshot_id,
    "snapshot_time": snapshot_time,
    "verified_at": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
}
with open(path, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, sort_keys=True)
    handle.write("\n")
os.chmod(path, 0o600)
# Atomic replacement never treats a directory (or its symlink) as a container.
os.replace(path, marker_path)
PY
marker_tmp=""
echo "restore drill: verified snapshot ${snapshot_id:0:8} from ${REPOSITORY_SOURCE} repository"
