#!/usr/bin/env bash
# Managed by Ansible role `backup`. Runs once daily via vpn-backup.timer.
set -euo pipefail

REPO="{{ restic_repo_dir }}"
export RESTIC_PASSWORD_FILE=/etc/restic/password

# This producer-owned marker is deliberately independent of the timer and
# systemd result.  It records only durable stage outcomes, never restic output
# or snapshot identities; the observability adapter is its consumer.
: "${STATE_DIRECTORY:?systemd must provide STATE_DIRECTORY}"
status_marker="${STATE_DIRECTORY}/backup-stage-status.json"
local_result="pending"
local_attempted_at=""
local_succeeded_at=""
local_failed_at=""
integrity_result="pending"
integrity_attempted_at=""
integrity_succeeded_at=""
integrity_failed_at=""
remote_result="disabled"
remote_attempted_at=""
remote_succeeded_at=""
remote_failed_at=""
active_stage=""

timestamp() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

publish_status() {
  BACKUP_STATUS_LOCAL_RESULT="$local_result" \
  BACKUP_STATUS_LOCAL_ATTEMPTED_AT="$local_attempted_at" \
  BACKUP_STATUS_LOCAL_SUCCEEDED_AT="$local_succeeded_at" \
  BACKUP_STATUS_LOCAL_FAILED_AT="$local_failed_at" \
  BACKUP_STATUS_INTEGRITY_RESULT="$integrity_result" \
  BACKUP_STATUS_INTEGRITY_ATTEMPTED_AT="$integrity_attempted_at" \
  BACKUP_STATUS_INTEGRITY_SUCCEEDED_AT="$integrity_succeeded_at" \
  BACKUP_STATUS_INTEGRITY_FAILED_AT="$integrity_failed_at" \
  BACKUP_STATUS_REMOTE_RESULT="$remote_result" \
  BACKUP_STATUS_REMOTE_ATTEMPTED_AT="$remote_attempted_at" \
  BACKUP_STATUS_REMOTE_SUCCEEDED_AT="$remote_succeeded_at" \
  BACKUP_STATUS_REMOTE_FAILED_AT="$remote_failed_at" \
  python3 - "$status_marker" <<'PY'
import json
import os
import secrets
import stat
import sys
from datetime import UTC, datetime

marker = sys.argv[1]
directory, name = os.path.split(marker)
directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
temporary_name = f".{name}.{secrets.token_hex(16)}"
temporary_fd = None
try:
    try:
        existing = os.lstat(name, dir_fd=directory_fd)
    except FileNotFoundError:
        pass
    else:
        if (
            not stat.S_ISREG(existing.st_mode)
            or existing.st_nlink != 1
            or existing.st_uid != os.geteuid()
            or stat.S_IMODE(existing.st_mode) != 0o600
        ):
            raise OSError("unsafe-existing-backup-status")
    temporary_fd = os.open(
        temporary_name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        0o600,
        dir_fd=directory_fd,
    )
    def stage(prefix: str) -> dict[str, str]:
        result = os.environ[f"BACKUP_STATUS_{prefix}_RESULT"]
        values = {"result": result}
        for key, field in (
            ("ATTEMPTED_AT", "attempted_at"),
            ("SUCCEEDED_AT", "succeeded_at"),
            ("FAILED_AT", "failed_at"),
        ):
            value = os.environ[f"BACKUP_STATUS_{prefix}_{key}"]
            if value:
                values[field] = value
        return values
    payload = {
        "version": 1,
        "updated_at": datetime.now(UTC).isoformat().replace("+00:00", "Z"),
        "local_backup": stage("LOCAL"),
        "integrity": stage("INTEGRITY"),
        "remote_copy": stage("REMOTE"),
    }
    encoded = (json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n").encode()
    view = memoryview(encoded)
    while view:
        written = os.write(temporary_fd, view)
        if written <= 0:
            raise OSError("short backup status write")
        view = view[written:]
    os.fchmod(temporary_fd, 0o600)
    os.fsync(temporary_fd)
    os.close(temporary_fd)
    temporary_fd = None
    os.replace(temporary_name, name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
    os.fsync(directory_fd)
finally:
    if temporary_fd is not None:
        os.close(temporary_fd)
    try:
        os.unlink(temporary_name, dir_fd=directory_fd)
    except FileNotFoundError:
        pass
    os.close(directory_fd)
PY
}

# Status publication must not change the backup command's own success/failure
# contract.  An unavailable marker remains observable as missing evidence.
publish_outcome() {
  publish_status || printf '%s\n' 'backup status publication failed' >&2
}

record_failure() {
  local status=$?
  if [[ "$active_stage" == "local" && "$local_result" == "pending" ]]; then
    local_result="failed"
    local_failed_at="$(timestamp)"
  elif [[ "$active_stage" == "integrity" && "$integrity_result" == "pending" ]]; then
    integrity_result="failed"
    integrity_failed_at="$(timestamp)"
  elif [[ "$active_stage" == "remote" && "$remote_result" == "pending" ]]; then
    remote_result="failed"
    remote_failed_at="$(timestamp)"
  fi
  publish_outcome
  exit "$status"
}
trap record_failure EXIT

local_attempted_at="$(timestamp)"
active_stage="local"
publish_outcome

{% set primary = not (vpn_subscription_only | default(false)) %}
{% set xray_enabled = primary and ((vpn.enable_xray_reality | default(true)) or (vpn.enable_nginx_xhttp | default(true))) %}
{% set nginx_enabled = (primary and ((vpn.enable_nginx_xhttp | default(true)) or (vpn.enable_cdn_front | default(false)) or (vpn.enable_probe_matrix_target | default(false)))) or (vpn.enable_subscription_host | default(false)) or (vpn_subscription_only | default(false)) %}
INCLUDES=(
  /etc/nftables.conf
  /etc/ssh
  /etc/sysctl.d
  /etc/systemd/system
{% if xray_enabled %}
  "{{ xray_etc_dir | default(xray_config_dir | default('/etc/xray')) }}"
{% endif %}
{% if primary and vpn.enable_hysteria | default(true) %}
  "{{ hysteria_config_dir | default('/etc/hysteria') }}"
{% endif %}
{% if primary and vpn.enable_snell | default(false) %}
  /etc/snell
{% endif %}
{% if primary and vpn.enable_amneziawg | default(true) %}
  "{{ amneziawg_config_dir | default('/etc/amnezia/amneziawg') }}"
{% endif %}
{% if nginx_enabled %}
  /etc/nginx
{% endif %}
{% if primary and vpn.enable_naive | default(false) %}
  "{{ (naive | default({})).config_dir | default('/etc/naive') }}"
{% endif %}
{% if primary and vpn.enable_hysteria_realm | default(false) %}
  "{{ (hysteria_realm | default({})).config_dir | default('/etc/hysteria-realm') }}"
{% endif %}
{% if primary and vpn.enable_dns_morph_bridge | default(false) %}
  "{{ (dns_morph_bridge | default({})).config_dir | default('/etc/dns-morph-bridge') }}"
  /etc/unbound
{% endif %}
{% if primary and ((vpn.enable_cascade_ingress | default(false)) or (vpn.enable_cascade_egress | default(false)) or (vpn.enable_split_hop_ingress | default(false)) or (vpn.enable_split_hop_egress | default(false))) %}
  /etc/wireguard
{% endif %}
{% if primary and vpn.enable_cascade_ingress | default(false) %}
  /etc/cascade
{% endif %}
{% if primary and vpn.enable_probe_matrix_target | default(false) %}
  /etc/probe-matrix
{% endif %}
{% if (vpn.enable_subscription_host | default(false)) or (vpn_subscription_only | default(false)) %}
  "{{ (subscription | default({})).subscription_dir | default('/var/lib/vpn-subscription') }}"
  "{{ (subscription | default({})).revoked_file | default('/var/lib/vpn-subscription/revoked') }}"
{% endif %}
{% if vpn.enable_watchdog | default(true) %}
  /etc/vpn-watchdog.env
  /etc/vpn-watchdog-notifications.json
{% if primary and vpn.enable_xray_reality | default(true) %}
  /etc/vpn-watchdog-reality.json
{% endif %}
{% endif %}
)

# Realm may store its TLS authority outside its configuration tree or link to
# Hysteria's files. Archive both configured entries and their actual targets;
# restic preserves symlinks rather than following them into backup content.
{% if primary and vpn.enable_hysteria_realm | default(false) %}
REALM_TLS_INPUTS=(
  "{{ (hysteria_realm | default({})).tls_cert_path | default(((hysteria_realm | default({})).config_dir | default('/etc/hysteria-realm')) ~ '/server.fullchain.pem') }}"
  "{{ (hysteria_realm | default({})).tls_key_path | default(((hysteria_realm | default({})).config_dir | default('/etc/hysteria-realm')) ~ '/server.key') }}"
)
for input in "${REALM_TLS_INPUTS[@]}"; do
  if ! target="$(python3 -c 'import pathlib, sys; print(pathlib.Path(sys.argv[1]).resolve(strict=True))' "$input" 2>/dev/null)"; then
    printf '%s\n' 'backup: required enabled TLS authority is absent' >&2
    exit 1
  fi
  INCLUDES+=("$input")
  if [[ "$target" != "$input" ]]; then INCLUDES+=("$target"); fi
done
{% endif %}

# restic may tolerate a partially unreadable tree. Required selected inputs
# must exist before snapshot/retention/integrity can publish success.
for input in "${INCLUDES[@]}"; do
  if [[ ! -e "$input" ]]; then
    printf '%s\n' 'backup: required enabled input is absent' >&2
    exit 1
  fi
done

REQUIRED_FILES=(
  /etc/nftables.conf
  /etc/ssh/sshd_config.d/20-ansible-hardening.conf
  /etc/sysctl.d/90-vpn.conf
{% if xray_enabled %}
  "{{ xray_etc_dir | default(xray_config_dir | default('/etc/xray')) }}/config.json"
{% endif %}
{% if primary and vpn.enable_hysteria | default(true) %}
  "{{ hysteria_config_dir | default('/etc/hysteria') }}/config.yaml"
  "{{ hysteria_config_dir | default('/etc/hysteria') }}/server.fullchain.pem"
  "{{ hysteria_config_dir | default('/etc/hysteria') }}/server.key"
{% endif %}
{% if primary and vpn.enable_snell | default(false) %}
  /etc/snell/config.json
{% endif %}
{% if primary and vpn.enable_amneziawg | default(true) %}
{% if (amneziawg_secrets | default({})).instances | default([]) | length > 0 %}
{% for instance in amneziawg_secrets.instances %}
  "{{ amneziawg_config_dir | default('/etc/amnezia/amneziawg') }}/{{ instance.name }}.conf"
{% endfor %}
{% else %}
  "{{ amneziawg_config_dir | default('/etc/amnezia/amneziawg') }}/{{ (amneziawg | default({})).interface | default('awg0') }}.conf"
{% endif %}
{% endif %}
{% if primary and vpn.enable_nginx_xhttp | default(true) %}
  /etc/nginx/sites-available/vpn-xhttp.conf
  /etc/nginx/tls/{{ nginx_xhttp.server_name }}.fullchain.pem
  /etc/nginx/tls/{{ nginx_xhttp.server_name }}.key
{% if nginx_xhttp.fallback_enabled | default(false) and (nginx_xhttp.fallback_server_name | default(nginx_xhttp.server_name)) != nginx_xhttp.server_name %}
  /etc/nginx/tls/{{ nginx_xhttp.fallback_server_name }}.fullchain.pem
  /etc/nginx/tls/{{ nginx_xhttp.fallback_server_name }}.key
{% endif %}
{% endif %}
{% if primary and vpn.enable_naive | default(false) %}
  "{{ (naive | default({})).config_dir | default('/etc/naive') }}/Caddyfile"
  "{{ (naive | default({})).config_dir | default('/etc/naive') }}/server.fullchain.pem"
  "{{ (naive | default({})).config_dir | default('/etc/naive') }}/server.key"
{% endif %}
{% if primary and vpn.enable_hysteria_realm | default(false) %}
  "{{ (hysteria_realm | default({})).config_dir | default('/etc/hysteria-realm') }}/config.json"
  "${REALM_TLS_INPUTS[@]}"
{% endif %}
{% if primary and vpn.enable_dns_morph_bridge | default(false) %}
  "{{ (dns_morph_bridge | default({})).config_dir | default('/etc/dns-morph-bridge') }}/dns-morph-bridge.yaml"
  /etc/unbound/unbound.conf.d/dns-morph-bridge-fwd.conf
{% endif %}
{% for flag, settings in [
    ('cascade_ingress', cascade_ingress | default({})),
    ('cascade_egress', cascade_egress | default({})),
    ('split_hop_ingress', split_hop_ingress | default({})),
    ('split_hop_egress', split_hop_egress | default({}))] %}
{% if primary and vpn['enable_' ~ flag] | default(false) %}
  "/etc/wireguard/{{ settings.wg_interface | default({'cascade_ingress': 'csi0', 'cascade_egress': 'cse0', 'split_hop_ingress': 'shop0', 'split_hop_egress': 'shop0'}[flag]) }}.conf"
{% endif %}
{% endfor %}
)
for input in "${REQUIRED_FILES[@]}"; do
  if [[ ! -f "$input" || ! -s "$input" ]]; then
    printf '%s\n' 'backup: required enabled configuration is absent or empty' >&2
    exit 1
  fi
done

restic -r "$REPO" backup \
  --tag "vpn-stack" \
  --tag "host=$(hostname)" \
  "${INCLUDES[@]}"

restic -r "$REPO" forget \
  --tag vpn-stack \
  --keep-daily 7 --keep-weekly 4 --keep-monthly 6 \
  --prune

local_result="success"
local_succeeded_at="$(timestamp)"
active_stage=""
publish_outcome

# Fail the backup run if repository integrity is damaged or no recent
# vpn-stack snapshot is available for restore.
integrity_attempted_at="$(timestamp)"
active_stage="integrity"
publish_outcome
restic -r "$REPO" check
latest_snapshot="$(restic -r "$REPO" snapshots --tag vpn-stack --latest 1 --json | python3 -c '
import datetime as dt, json, sys
snapshots = json.load(sys.stdin)
if not snapshots:
    raise SystemExit("no vpn-stack snapshot")
time = dt.datetime.fromisoformat(snapshots[-1]["time"].replace("Z", "+00:00"))
age = dt.datetime.now(dt.timezone.utc) - time.astimezone(dt.timezone.utc)
if age > dt.timedelta(hours={{ backup_snapshot_max_age_hours | int }}):
    raise SystemExit(f"latest vpn-stack snapshot is stale: {age}")
print(snapshots[-1]["short_id"])
')"
echo "verified recent vpn-stack snapshot ${latest_snapshot}"

integrity_result="success"
integrity_succeeded_at="$(timestamp)"
active_stage=""
publish_outcome
{% if backup.remote.enabled | default(false) -%}
# ------------------------------------------------------------------
# Remote sync via rclone (configured by Ansible)
# ------------------------------------------------------------------
remote_result="pending"
remote_attempted_at="$(timestamp)"
active_stage="remote"
publish_outcome
RCLONE_CONFIG=/etc/rclone/rclone.conf \
  rclone sync --quiet \
  --transfers={{ backup.remote.transfers | default(4) }} \
  --bwlimit={{ backup.remote.bwlimit | default('off') }} \
  "$REPO" \
  "{{ backup.remote.rclone_remote }}:{{ backup.remote.rclone_path }}/$(hostname)"

# Verify the remote repository matches the checked local repository.
RCLONE_CONFIG=/etc/rclone/rclone.conf \
  rclone check "$REPO" "{{ backup.remote.rclone_remote }}:{{ backup.remote.rclone_path }}/$(hostname)"
remote_result="success"
remote_succeeded_at="$(timestamp)"
active_stage=""
publish_outcome
{% endif -%}
