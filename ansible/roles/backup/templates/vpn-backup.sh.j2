#!/usr/bin/env bash
# Managed by Ansible role `backup`. Runs once daily via vpn-backup.timer.
set -euo pipefail

REPO="{{ restic_repo_dir }}"
export RESTIC_PASSWORD_FILE=/etc/restic/password

INCLUDES=(
  /etc/xray
  /etc/hysteria
  /etc/snell
{% if vpn.enable_amneziawg | default(false) %}
  "{{ amneziawg_config_dir }}"
{% endif %}
  /etc/nginx
  /etc/nftables.conf
  /etc/ssh
  /etc/sysctl.d
  /etc/systemd/system
  /etc/vpn-watchdog.env
)

restic -r "$REPO" backup \
  --tag "vpn-stack" \
  --tag "host=$(hostname)" \
  "${INCLUDES[@]}"

restic -r "$REPO" forget \
  --tag vpn-stack \
  --keep-daily 7 --keep-weekly 4 --keep-monthly 6 \
  --prune

# Fail the backup run if repository integrity is damaged or no recent
# vpn-stack snapshot is available for restore.
restic -r "$REPO" check
latest_snapshot="$(restic -r "$REPO" snapshots --tag vpn-stack --latest 1 --json | python3 -c '
import datetime as dt, json, sys
snapshots = json.load(sys.stdin)
if not snapshots:
    raise SystemExit("no vpn-stack snapshot")
time = dt.datetime.fromisoformat(snapshots[-1]["time"].replace("Z", "+00:00"))
age = dt.datetime.now(dt.timezone.utc) - time.astimezone(dt.timezone.utc)
if age > dt.timedelta(hours={{ backup_snapshot_max_age_hours | int }}):
    raise SystemExit(f"latest vpn-stack snapshot is stale: {age}")
print(snapshots[-1]["short_id"])
')"
echo "verified recent vpn-stack snapshot ${latest_snapshot}"

{% if backup.remote.enabled | default(false) %}
# ------------------------------------------------------------------
# Remote sync via rclone (configured by Ansible)
# ------------------------------------------------------------------
RCLONE_CONFIG=/etc/rclone/rclone.conf \
  rclone sync --quiet \
  --transfers={{ backup.remote.transfers | default(4) }} \
  --bwlimit={{ backup.remote.bwlimit | default('off') }} \
  "$REPO" \
  "{{ backup.remote.rclone_remote }}:{{ backup.remote.rclone_path }}/$(hostname)"

# Verify the remote repository matches the checked local repository.
RCLONE_CONFIG=/etc/rclone/rclone.conf \
  rclone check "$REPO" "{{ backup.remote.rclone_remote }}:{{ backup.remote.rclone_path }}/$(hostname)"
{% endif %}
