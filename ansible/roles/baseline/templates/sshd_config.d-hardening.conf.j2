{% set ssh_controls = security_controls | default({}) -%}
# Managed by the vpn SSH baseline transaction; authentication stays in 10-cloud-init-hardening.conf.
X11Forwarding no
AllowTcpForwarding {{ 'yes' if (ssh_controls.ssh_allow_tcp_forwarding | default(false)) else 'no' }}
{% if ssh_controls.ssh_strict | default(true) %}
AllowAgentForwarding no
PermitTunnel no
PermitUserEnvironment no
PermitEmptyPasswords no
IgnoreRhosts yes
LogLevel VERBOSE
{% endif %}
ClientAliveInterval 60
ClientAliveCountMax 3
MaxAuthTries 3
{% if ssh_controls.ssh_strict | default(true) %}
MaxSessions {{ ssh_controls.ssh_max_sessions | default(2) }}
MaxStartups {{ ssh_controls.ssh_max_startups | default('10:30:20') }}
{% endif %}
LoginGraceTime 20
{% if (ssh_controls.ssh_required_rsa_size | default(0) | int) > 0 %}
RequiredRSASize {{ ssh_controls.ssh_required_rsa_size | int }}
{% endif %}
AllowUsers {{ ansible_user }}
{% if ssh_controls.ssh_strict | default(true) %}
Subsystem sftp internal-sftp -f AUTHPRIV -l INFO
{% endif -%}
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512
