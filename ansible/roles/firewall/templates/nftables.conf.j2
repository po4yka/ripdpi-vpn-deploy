#!/usr/sbin/nft -f
# Managed by Ansible role `firewall`. Hand edits will be overwritten.

# Replace only tables owned by this role. Other components (for example the
# split-hop egress NAT table) install independent nftables tables that must
# survive a firewall reload. `destroy` is idempotent on a fresh host.
destroy table inet filter
destroy table inet nat
{% set ssh_cidrs = [allowed_ssh_cidrs] if allowed_ssh_cidrs is string else (allowed_ssh_cidrs | default([])) %}
{% set ssh_v4_cidrs = ssh_cidrs | select('match', '^(?!.*:).*') | list %}
{% set ssh_v6_cidrs = ssh_cidrs | select('match', '.*:.*') | list %}
{% set _xray_cohorts = (xray.cohorts | default([])) if xray is defined else [] %}
{% set _xray_fallback_port = xray_fallback_port | default(0) | int %}
{% if _xray_cohorts | length > 0 %}
{%   set xray_tcp_ports = _xray_cohorts | map(attribute='port') | map('int') | list %}
{% else %}
{%   set xray_tcp_ports = [xray_port | default(443) | int] %}
{%   if _xray_fallback_port > 0 and _xray_fallback_port not in xray_tcp_ports %}
{%     set _ = xray_tcp_ports.append(_xray_fallback_port) %}
{%   endif %}
{% endif %}
{% set nginx_tcp_port = nginx_xhttp_public_port | default(8443) | int %}
{% set nginx_collides_with_xray = (vpn.enable_xray_reality | default(true)) and (nginx_tcp_port in xray_tcp_ports) %}
{% set _awg_inst = (amneziawg_secrets.instances | default([])) if amneziawg_secrets is defined else [] %}
{% set awg_uplink_interface = firewall_awg_uplink_interface | default((ansible_default_ipv4 | default({})).interface | default('eth0')) %}
{% set egress_policy = firewall_egress_policy | default('permissive') -%}
{% set transport_needs_open_egress = (vpn.enable_xray_reality | default(true)) or (vpn.enable_hysteria | default(false)) or (vpn.enable_naive | default(false)) -%}

table inet filter {
{% if (security_controls | default({})).fail2ban | default(false) %}
  # sshd offenders populated by Fail2Ban. The intrusion_prevention role owns
  # set membership only; firewall owns the input-chain drop rules.
  set f2b_sshd4 {
    type ipv4_addr
    flags timeout
  }

  set f2b_sshd6 {
    type ipv6_addr
    flags timeout
  }
{% endif -%}

{% if vpn.enable_policy_ratelimit | default(false) %}
  # Offenders set populated by policy-ratelimit.service; per-element
  # timeout is set when the daemon adds an entry.
  set policy_offenders {
    type ipv4_addr
    flags timeout
  }
{% endif %}

{% if (vpn.enable_cdn_front | default(false)) and (cdn_front.origin_firewall | default(true)) %}
  # Cloudflare origin prefixes — populated by the cdn-front role's
  # daily refresh cron from https://www.cloudflare.com/ips-v{4,6}
  set cdn_front_origins {
    type ipv4_addr
    flags interval
  }

  # IPv6 origins must be filtered explicitly because the CDN-front
  # nginx vhost also listens on [::]:cdn_front.port.
  set cdn_front_origins_v6 {
    type ipv6_addr
    flags interval
  }
{% endif %}

  chain input {
    type filter hook input priority 0;
    policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
{% if (security_controls | default({})).fail2ban | default(false) %}

    # Fail2Ban sshd bans. This stays ahead of the SSH allowlist so a source
    # that is not in ignoreip cannot keep retrying after crossing the jail
    # threshold.
    ip saddr @f2b_sshd4 drop
    ip6 saddr @f2b_sshd6 drop
{% endif -%}
{% if vpn.enable_policy_ratelimit | default(false) %}

    # Early drop for IPs the policy-ratelimit daemon has flagged
    ip saddr @policy_offenders drop
{% endif %}

    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

{% if ssh_v4_cidrs %}
    tcp dport 22 ip saddr { {{ ssh_v4_cidrs | join(", ") }} } accept
{% endif %}
{% if ssh_v6_cidrs %}
    tcp dport 22 ip6 saddr { {{ ssh_v6_cidrs | join(", ") }} } accept
{% endif %}

{% for listener in public_listener_contract | default([]) %}
{% set listener_target = listener.port if listener.port is not none else listener.port_range %}
    # Public listener contract: {{ listener.name }} ({{ listener.protocol }}/{{ listener_target }})
{% if listener.name == 'cdn-front' and (cdn_front.origin_firewall | default(true)) %}
    tcp dport {{ listener_target }} ip saddr @cdn_front_origins accept
    tcp dport {{ listener_target }} ip6 saddr @cdn_front_origins_v6 accept
{% else %}
    {{ listener.protocol }} dport {{ listener_target }} accept
{% endif %}
{% endfor %}

    counter drop
  }

  chain forward {
    type filter hook forward priority 0;
    policy drop;
    ct state established,related accept
{% if vpn.enable_amneziawg | default(false) %}
{% if _awg_inst | length > 0 %}
{% for inst in _awg_inst %}
    # New client traffic may leave only via the configured uplink; replies use conntrack above.
    ct state new iifname "{{ inst.name }}" oifname "{{ awg_uplink_interface }}" accept
{% endfor %}
{% else %}
    ct state new iifname "awg0" oifname "{{ awg_uplink_interface }}" accept
{% endif %}
{% endif %}
  }

  chain output {
    type filter hook output priority 0;
{% if egress_policy == 'strict' %}
    policy drop;

    oif "lo" accept
    ct state established,related accept
    ct state invalid drop

    # Host infrastructure egress: resolver, time sync, package updates,
    # geodata refresh, backup remotes, monitoring alerts, and HTTPS APIs.
    udp dport 53 accept
    tcp dport 53 accept
    udp dport 123 accept
    tcp dport { 80, 443 } accept
{% if vpn.enable_warp_outbound | default(false) %}
    # Cloudflare WARP control/data plane. WARP role still runs in proxy mode;
    # this only permits the local warp-svc to establish its tunnel.
    udp dport { 2408, 500, 4500 } accept
{% endif %}
{% if transport_needs_open_egress %}

    # Enabled proxy transports need arbitrary upstream egress for client data.
    # Keep strict opt-in: hosts without these profiles remain narrow.
    tcp accept
    udp accept
{% endif %}

    counter drop
{% elif egress_policy == 'logged' %}
    policy accept;

    # Observation-only mode: counters for non-baseline egress, no packet logs.
    tcp dport != { 53, 80, 443 } ct state new counter comment "egress-observe-unexpected-tcp"
    udp dport != { 53, 123, 443 } ct state new counter comment "egress-observe-unexpected-udp"
{% else %}
    policy accept;
{%- endif %}
  }
}

{% if vpn.enable_amneziawg | default(false) %}
table inet nat {
  chain postrouting {
    type nat hook postrouting priority 100;
{% if _awg_inst | length > 0 %}
{% for inst in _awg_inst %}
    iifname "{{ inst.name }}" oifname != "{{ inst.name }}" masquerade
{% endfor %}
{% else %}
    iifname "awg0" oifname != "awg0" masquerade
{% endif %}
  }
}
{% endif %}
