#!/usr/bin/env bash
# Refresh Xray geodata. Downloads to a tmpfile, atomically renames into
# place, then activates it through the version-aware Xray helper.
set -euo pipefail

INSTALL_DIR={{ geodata.install_dir | quote }}

download() {
  local url="$1" dest="$2" sha="$3"
  local tmp="${dest}.new"
  curl -fsSL --max-time 120 -o "$tmp" "$url"
  if [[ -n "$sha" ]]; then
    echo "${sha}  ${tmp}" | sha256sum -c -
  fi
  mv -f "$tmp" "$dest"
}

download "{{ geodata.geosite_url }}" "${INSTALL_DIR}/geosite.dat" "{{ geodata.geosite_sha256 }}"
download "{{ geodata.geoip_url }}"   "${INSTALL_DIR}/geoip.dat"   "{{ geodata.geoip_sha256 }}"

/usr/local/sbin/vpn-xray-geodata-activate.sh
