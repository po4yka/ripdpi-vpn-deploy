#!/usr/bin/env bash
# Reconcile the active Xray service after installing verified geodata.
set -euo pipefail

if ! systemctl is-active --quiet xray.service; then
  printf '%s\n' inactive
  exit 0
fi

# The pinned runtime has no supported HUP reload contract. A controlled restart
# reopens logs/assets and must restore service availability before success.
systemctl restart xray.service
systemctl is-active --quiet xray.service
printf '%s\n' active
