listen: ":{{ hysteria_port }}"

{% if hysteria.acme is defined %}
acme:
  domains: {{ hysteria.acme.domains | to_json }}
  email: {{ hysteria.acme.email | to_json }}
  ca: letsencrypt
  dir: /var/lib/hysteria/acme
  type: http
  http:
    altPort: 80
{% else %}
tls:
  cert: {{ (hysteria_config_dir ~ '/server.fullchain.pem') | to_json }}
  key:  {{ (hysteria_config_dir ~ '/server.key') | to_json }}
{% endif %}

{% if hysteria.ech is defined %}
ech:
  keyPath: "/run/credentials/hysteria-server.service/hysteria-ech"
{% endif %}

auth:
  type: userpass
  userpass:
{% for client in hysteria.clients %}
    {{ client.name | to_json }}: {{ client.password | to_json }}
{% endfor %}

# Salamander obfuscation: disabled by default. Enable only if vanilla
# Hysteria is being classified on the target network — turning it on
# trades a vanilla-H2 fingerprint for a high-entropy UDP fingerprint,
# which can itself be a signal.
{% if hysteria.salamander_enabled | default(false) %}
obfs:
  type: salamander
  salamander:
    password: {{ hysteria.salamander_password | to_json }}
{% endif %}

{% set _resource_profile = hysteria.resource_profile | default(hysteria_resource_profile_default) %}
{% if _resource_profile != 'bandwidth-capped' %}
congestion:
  type: bbr
  bbrProfile: {{ _resource_profile | replace('bbr-', '') | to_json }}
ignoreClientBandwidth: true
{% endif %}
bandwidth:
  up:   {{ hysteria.bandwidth_up   | default("100 mbps") | to_json }}
  down: {{ hysteria.bandwidth_down | default("200 mbps") | to_json }}

masquerade:
  type: {{ hysteria.masquerade_type | default('proxy') | to_json }}
{% if (hysteria.masquerade_type | default('proxy')) == 'proxy' %}
  proxy:
    url: {{ hysteria.masquerade_url | to_json }}
    rewriteHost: true
{% endif %}
{% if hysteria_masquerade_tcp | bool %}
  # The same site answers over TCP, as a real HTTP/3 origin does.
{% if hysteria.acme is not defined %}
  # CertMagic treats a bound TCP/80 as its own challenge server, so this
  # listener exists only without native ACME; HTTP-01 keeps the port then.
  listenHTTP: ":80"
  forceHTTPS: true
{% endif %}
  listenHTTPS: ":443"
{% endif %}

{% if hysteria_traffic_stats_enabled | default(false) | bool %}
# Loopback-only aggregate traffic source for the role's exporter; never a public listener.
trafficStats:
  listen: {{ hysteria_traffic_stats_listen | to_json }}
  secret: {{ hysteria_traffic_stats_secret | to_json }}

{% endif %}
quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow:  8388608
  initConnReceiveWindow:   20971520
  maxConnReceiveWindow:    20971520

# The single outbound preserves recipient TCP/UDP destinations through admission.
outbounds:
  - name: guarded-direct
    type: socks5
    socks5:
      addr: "127.0.0.1:12081"
      username: "normalizer-direct-hysteria"
      password: {{ transport_egress_secrets.direct_hysteria_password | to_json }}
