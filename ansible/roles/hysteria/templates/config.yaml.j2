{% if hysteria_port_range | default('') %}
listen: ":{{ hysteria_port | default(443) }},{{ hysteria_port_range }}"
{% else %}
listen: ":{{ hysteria_port | default(443) }}"
{% endif %}

tls:
  cert: {{ hysteria_config_dir }}/server.fullchain.pem
  key:  {{ hysteria_config_dir }}/server.key

auth:
  type: userpass
  userpass:
{% for client in hysteria.clients %}
    {{ client.name }}: "{{ client.password }}"
{% endfor %}

# Obfuscation is default-off; the role renders Gecko only after the controller-side evidence preflight succeeds.
{% set explicit_obfs_type = hysteria_obfs_type | default('') %}
{% set effective_obfs_type = explicit_obfs_type if explicit_obfs_type else ('salamander' if (hysteria.salamander_enabled | default(false)) else 'plain') %}
{% set effective_obfs_password = hysteria.obfs_password | default(hysteria.salamander_password | default(''), true) %}
{% if effective_obfs_type == 'salamander' %}
obfs:
  type: salamander
  salamander:
    password: "{{ effective_obfs_password }}"
{% elif effective_obfs_type == 'gecko' %}
obfs:
  type: gecko
  gecko:
    password: "{{ effective_obfs_password }}"
    minPacketSize: {{ hysteria_gecko_min_packet_size | default(512) }}
    maxPacketSize: {{ hysteria_gecko_max_packet_size | default(1200) }}
{% endif %}

bandwidth:
  up:   {{ hysteria.bandwidth_up   | default("100 mbps") }}
  down: {{ hysteria.bandwidth_down | default("200 mbps") }}

masquerade:
  type: {{ hysteria.masquerade_type | default('proxy') }}
{% if (hysteria.masquerade_type | default('proxy')) == 'proxy' %}
  proxy:
    url: {{ hysteria.masquerade_url | default('https://www.bing.com') }}
    rewriteHost: true
{% endif %}

quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow:  8388608
  initConnReceiveWindow:   20971520
  maxConnReceiveWindow:    20971520
