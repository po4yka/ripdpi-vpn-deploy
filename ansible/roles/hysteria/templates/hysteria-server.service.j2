[Unit]
Description=Hysteria 2 Server
Documentation=https://v2.hysteria.network/
After=network-online.target nss-lookup.target
Wants=network-online.target
BindsTo=ripdpi-transport-normalizer.service
After=ripdpi-transport-normalizer.service

[Service]
Type=exec
User=hysteria
Group=hysteria
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Connection records (client address, user name) stay out of journald.
Environment=HYSTERIA_LOG_LEVEL=warn

{% if hysteria.ech is defined %}
LoadCredential=hysteria-ech:{{ hysteria_config_dir }}/ech.key
{% endif %}
ExecStart={{ hysteria_install_root }}/releases/{{ hysteria.version }}/hysteria server -c {{ hysteria_config_dir }}/config.yaml
Restart=on-failure
RestartSec=5s

LimitNOFILE=1048576

{% if (hysteria_masquerade_hosts | default({})).enabled | default(false) %}
BindReadOnlyPaths={{ hysteria_config_dir }}/masquerade-hosts:/etc/hosts
{% endif %}
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Same filter profile hysteria-realm's sing-box processes run with in production.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ReadWritePaths={{ hysteria_log_dir }}{% if hysteria.acme is defined %} /var/lib/hysteria/acme{% endif %}

[Install]
WantedBy=multi-user.target
