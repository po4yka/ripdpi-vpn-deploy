[Unit]
Description=Export aggregate Hysteria2 traffic counters
After=hysteria-server.service
# Requisite, not Requires: a timer run must fail, never start a frontend that was stopped on purpose.
Requisite=hysteria-server.service

[Service]
Type=oneshot
# A dedicated account in the textfile writer group: the exporter only reads a loopback
# API and replaces its own textfile, so it needs no root and no capability. systemd
# reads the root-only secret and delivers it as a credential.
User=vpn-hysteria-exporter
Group=vpn-hysteria-exporter
SupplementaryGroups={{ monitoring.node_exporter_textfile_group | default('node_exporter_textfile') }}
UMask=0027
# A core file would keep the traffic API secret on disk.
LimitCORE=0
CapabilityBoundingSet=
AmbientCapabilities=
LoadCredential=hysteria-traffic-secret:{{ hysteria_config_dir }}/traffic-stats.secret
ExecStart=/usr/local/sbin/hysteria-traffic-exporter --listen {{ hysteria_traffic_stats_listen }} --secret-file ${CREDENTIALS_DIRECTORY}/hysteria-traffic-secret --output {{ monitoring.node_exporter_textfile_dir | default('/var/lib/node_exporter/textfile') }}/vpn_hysteria.prom

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The monitoring role creates the textfile directory later in site order; until then a run fails closed.
ReadWritePaths=-{{ monitoring.node_exporter_textfile_dir | default('/var/lib/node_exporter/textfile') }}
