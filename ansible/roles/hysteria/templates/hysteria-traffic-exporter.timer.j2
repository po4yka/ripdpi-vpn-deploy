[Unit]
Description=Collect aggregate Hysteria2 traffic counters every {{ hysteria_traffic_stats_interval }}

[Timer]
OnBootSec=30s
OnUnitActiveSec={{ hysteria_traffic_stats_interval }}
AccuracySec=10s
RandomizedDelaySec=10s
Persistent=true
Unit=hysteria-traffic-exporter.service

[Install]
WantedBy=timers.target
