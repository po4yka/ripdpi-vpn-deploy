# Managed by Ansible role `intrusion_prevention`. Hand edits will be overwritten.
#
# nftables integration model:
# - firewall owns `table inet filter`, input-chain policy, and the drop rules
# - this action only creates/updates membership in f2b_sshd4/f2b_sshd6
# - no UFW, iptables compatibility layer, or replacement firewall is used

[Definition]
actionstart = nft list set inet filter f2b_<name>4 >/dev/null 2>&1 || nft add set inet filter f2b_<name>4 { type ipv4_addr\; flags timeout\; }
              nft list set inet filter f2b_<name>6 >/dev/null 2>&1 || nft add set inet filter f2b_<name>6 { type ipv6_addr\; flags timeout\; }
actionstop =
actioncheck = nft list set inet filter f2b_<name>4 >/dev/null 2>&1 && nft list set inet filter f2b_<name>6 >/dev/null 2>&1
actionban = if printf '%%s' '<ip>' | grep -q ':'; then nft add element inet filter f2b_<name>6 { <ip> timeout <bantime> } 2>/dev/null || true; else nft add element inet filter f2b_<name>4 { <ip> timeout <bantime> } 2>/dev/null || true; fi
actionunban = if printf '%%s' '<ip>' | grep -q ':'; then nft delete element inet filter f2b_<name>6 { <ip> } 2>/dev/null || true; else nft delete element inet filter f2b_<name>4 { <ip> } 2>/dev/null || true; fi

[Init]
name = default
