# Managed by Ansible role `intrusion_prevention`. Hand edits will be overwritten.
{% set _allowed_ssh = [allowed_ssh_cidrs] if allowed_ssh_cidrs is string else (allowed_ssh_cidrs | default([])) -%}
{# The firewall drops a banned source before it accepts approved Tailnet SSH, so a ban would lock the controller out. #}
{% set _tailnet = (tailnet_management.approved_sources | default([])) if (vpn.enable_tailnet_management | default(false)) else [] -%}
{% set _ignore = ((intrusion_prevention.ignore_cidrs | default(['127.0.0.1/8', '::1/128'])) + _allowed_ssh + _tailnet) | unique | list -%}

[DEFAULT]
ignoreip = {{ _ignore | join(' ') }}
backend = systemd
banaction = nftables-ripdpi
banaction_allports = nftables-ripdpi
destemail = root@localhost
sender = fail2ban@localhost
mta = sendmail
protocol = tcp
chain = input
