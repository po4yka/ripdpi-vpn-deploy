/var/log/nginx/*.log {
    daily
    missingok
    rotate 7
    compress
    delaycompress
    notifempty
    create 0640 www-data adm
    sharedscripts
    prerotate
        if [ -d /etc/logrotate.d/httpd-prerotate ]; then
            run-parts /etc/logrotate.d/httpd-prerotate
        fi
    endscript
    postrotate
        # USR1 makes the master reopen its logs. A reload would also re-read the
        # whole configuration outside its transaction owner, and a swallowed
        # failure would leave workers writing to the rotated file.
        if systemctl is-active --quiet nginx.service; then
            systemctl kill --signal=USR1 --kill-whom=main nginx.service
        fi
    endscript
}
