{{ xray_log_dir }}/*.log {
    daily
    rotate 7
    compress
    missingok
    notifempty
    create 0640 {{ xray_runtime_user | default('xray') }} {{ xray_runtime_group | default('xray') }}
    sharedscripts
    postrotate
        if systemctl is-active --quiet xray.service; then
            systemctl restart xray.service && systemctl is-active --quiet xray.service
        fi
    endscript
}
