[Unit]
Description=Collect Xray diagnostic counters every {{ monitoring.xray_stats_interval | default('60s') }}

[Timer]
OnBootSec=30s
OnUnitActiveSec={{ monitoring.xray_stats_interval | default('60s') }}
AccuracySec=10s
RandomizedDelaySec=10s
Persistent=true
Unit=xray-stats-exporter.service

[Install]
WantedBy=timers.target
