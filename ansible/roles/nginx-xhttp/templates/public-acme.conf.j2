{% if nginx_xhttp.acme is defined %}
# The public TLS owner keeps HTTP-01 independent of application publication.
server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_xhttp.acme.domains | join(' ') }};
    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    root {{ ('/var/lib/public-site/' ~ (public_site_published | default({}))[nginx_xhttp_public_site_dir | default('')] ~ '/current')
            if (nginx_xhttp_public_site_dir | default('')) in (public_site_published | default({})) else '/var/www/public-site' }};
    error_page 404 /404.html;
    location = /404.html { internal; }
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/vpn-public-tls;
        default_type text/plain;
        try_files $uri =404;
    }
{% if (nginx_xhttp_public_port | int) == 443 %}
    location / { return 301 {{ public_site_canonical_url }}$request_uri; }
{% else %}
    # Port 80 never redirects to a port other than 443; it serves the site itself.
    index index.html;
{% if (nginx_xhttp_public_site_dir | default('')) in (public_site_live | default({})) %}
    location = /{{ public_site_live[nginx_xhttp_public_site_dir].page }} {
        root /var/lib/public-site-live/{{ public_site_live[nginx_xhttp_public_site_dir].digest }};
        try_files $uri @public_site_live_shell;
    }
    location @public_site_live_shell { root /var/lib/public-site/{{ public_site_live[nginx_xhttp_public_site_dir].digest }}/current; }
{% endif %}
    location / { try_files $uri $uri/ =404; }
{% endif %}
}

{% endif -%}
