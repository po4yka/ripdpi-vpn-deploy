{% macro head(title, description, path, page_type="website", schema_type=none, headline=none, date_published=none, date_modified=none) -%}
{%- set site_host = public_site_canonical_url | urlsplit("hostname") -%}
{%- set organization = {
  "@type": "Organization",
  "@id": public_site_canonical_url ~ "/#organization",
  "name": "LLM Model Notes",
  "alternateName": [site_host],
  "url": public_site_canonical_url ~ "/",
  "description": "Independent notes on practical language-model evaluation and inference behavior.",
  "logo": {
    "@type": "ImageObject",
    "url": public_site_canonical_url ~ "/logo.svg",
    "width": 512,
    "height": 512
  }
} -%}
{%- if schema_type == "WebSite" -%}
{%- set structured_data = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    {
      "@type": "WebSite",
      "@id": public_site_canonical_url ~ "/#website",
      "url": public_site_canonical_url ~ "/",
      "name": "LLM Model Notes",
      "alternateName": [site_host],
      "description": "Independent notes on practical language-model evaluation and inference behavior.",
      "inLanguage": "en",
      "publisher": {"@id": public_site_canonical_url ~ "/#organization"}
    }
  ]
} -%}
{%- elif schema_type == "Article" -%}
{%- set structured_data = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    {
      "@type": "Article",
      "@id": public_site_canonical_url ~ path ~ "#article",
      "url": public_site_canonical_url ~ path,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": public_site_canonical_url ~ path
      },
      "headline": headline,
      "description": description,
      "datePublished": date_published,
      "dateModified": date_modified,
      "inLanguage": "en",
      "author": {"@id": public_site_canonical_url ~ "/#organization"},
      "publisher": {"@id": public_site_canonical_url ~ "/#organization"},
      "isPartOf": {"@id": public_site_canonical_url ~ "/#website"}
    }
  ]
} -%}
{%- else -%}
{%- set structured_data = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": public_site_canonical_url ~ path,
  "url": public_site_canonical_url ~ path,
  "name": title,
  "description": description,
  "inLanguage": "en",
  "isPartOf": {"@id": public_site_canonical_url ~ "/#website"}
} -%}
{%- endif -%}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description }}">
  <meta name="color-scheme" content="light dark">
  <title>{{ title }}</title>
  <link rel="canonical" href="{{ public_site_canonical_url }}{{ path }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="LLM Model Notes updates" href="{{ public_site_canonical_url }}/feed.xml">
{% if schema_type == "Article" %}
  <link rel="author" href="/about.html">
  <meta name="author" content="LLM Model Notes">
  <meta property="article:published_time" content="{{ date_published }}">
  <meta property="article:modified_time" content="{{ date_modified }}">
{% endif %}
  <link rel="stylesheet" href="/assets/site.css">
  <meta property="og:site_name" content="LLM Model Notes">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="{{ page_type }}">
  <meta property="og:url" content="{{ public_site_canonical_url }}{{ path }}">
  <script type="application/ld+json">{{ structured_data | to_json }}</script>
</head>
{%- endmacro -%}

{% macro nav_link(href, label, key, current) -%}
<a{% if current == key %} aria-current="page"{% elif current == "note" and key == "notes" %} aria-current="true"{% endif %} href="{{ href }}">{{ label }}</a>
{%- endmacro -%}

{% macro header(current="") -%}
<a class="skip-link" href="#main-content">Skip to content</a>
<header>
  <a class="brand" href="/"><img src="/favicon.svg" width="28" height="28" alt="">LLM Model Notes</a>
  <nav aria-label="Primary">
    {{ nav_link("/notes/", "Notes", "notes", current) }}
    {{ nav_link("/models.html", "Models", "models", current) }}
{% if nginx_xhttp_model_news_enabled | default(true) | bool %}
    {{ nav_link("/news.html", "News", "news", current) }}
{% endif %}
    {{ nav_link("/glossary.html", "Glossary", "glossary", current) }}
    {{ nav_link("/about.html", "About", "about", current) }}
  </nav>
</header>
{%- endmacro -%}

{#- One registry for every note: home grid, archive and "More notes" read it. -#}
{%- set notes = [
  {"href": "/notes/reading-an-open-weight-model-card.html", "topic": "Open models", "minutes": 9, "date": "2026-11-04", "title": "Reading an open-weight model card", "summary": "Separate the artifact from the announcement: revision, total and active parameters, native context, and the license file itself."},
  {"href": "/notes/serving-mixture-of-experts-models.html", "topic": "Inference", "minutes": 9, "date": "2026-11-04", "title": "Serving mixture-of-experts models", "summary": "Why memory follows total parameters while per-token compute follows active ones, and what that means for hardware plans."},
  {"href": "/notes/tokenizer-efficiency-for-chinese-text.html", "topic": "Methods", "minutes": 8, "date": "2026-11-04", "title": "Measuring tokenizer efficiency for Chinese text", "summary": "A reproducible way to compare how many tokens a fixed Chinese corpus costs under different tokenizers."},
  {"href": "/notes/reading-benchmark-results.html", "topic": "Evaluation", "minutes": 9, "date": "2026-07-16", "title": "Reading benchmark results carefully", "summary": "Define the evaluation contract, inspect uncertainty, and check prompt sensitivity before treating a score as evidence."},
  {"href": "/notes/latency-throughput-context.html", "topic": "Inference", "minutes": 9, "date": "2026-07-16", "title": "Latency, throughput, and context", "summary": "Measure first-token delay, generation cadence, and capacity under a workload another person can reproduce."},
  {"href": "/notes/repeatable-model-comparisons.html", "topic": "Methods", "minutes": 10, "date": "2026-07-16", "title": "Repeatable model comparisons", "summary": "Turn a product question into a pinned manifest, paired observations, and a compact result bundle."},
] -%}
{%- set topics = ["Open models", "Evaluation", "Inference", "Methods"] -%}

{% macro topic_anchor(topic) -%}
/notes/#{{ topic | lower | replace(" ", "-") }}
{%- endmacro -%}

{% macro note_card(note, heading="h3") -%}
<article class="note-card">
  <p class="meta"><a href="{{ topic_anchor(note.topic) }}">{{ note.topic }}</a> · {{ note.minutes }} min</p>
  <{{ heading }}><a href="{{ note.href }}">{{ note.title }}</a></{{ heading }}>
  <p>{{ note.summary }}</p>
</article>
{%- endmacro -%}

{% macro more_notes(path) -%}
{%- set current = (notes | selectattr("href", "equalto", path) | first) -%}
{%- set related = (notes | rejectattr("href", "equalto", path) | selectattr("topic", "equalto", current.topic) | list)
    + (notes | rejectattr("href", "equalto", path) | rejectattr("topic", "equalto", current.topic) | list) -%}
<nav class="more-notes" aria-labelledby="more-notes">
  <h2 id="more-notes">More notes</h2>
  <ul>
{%- for note in related[:3] %}
    <li><span class="meta">{{ note.topic }}</span><a href="{{ note.href }}">{{ note.title }}</a></li>
{%- endfor %}
  </ul>
  <p><a href="/notes/">All notes</a> · <a href="/methodology.html">Methodology</a></p>
</nav>
{%- endmacro -%}

{% macro footer() -%}
<footer>
  <div><strong>LLM Model Notes</strong><p>Independent notes on practical evaluation.</p></div>
  <nav aria-label="Footer"><a href="/methodology.html">Methodology</a><a href="/updates.html">Updates</a><a href="/feed.xml">Atom feed</a></nav>
</footer>
{%- endmacro -%}
