{% import "_site.html.j2" as site with context %}
<!doctype html>
<html lang="en">
{{ site.head("LLM Model Notes", "Independent notes on language model evaluation, inference behavior, and repeatable comparison methods.", "/") }}
<body>
  {{ site.header() }}
  <main>
    <section class="hero">
      <p class="eyebrow">Independent reference</p>
      <h1>Clear notes on language model behavior</h1>
      <p>Practical guides to evaluation design, inference constraints, and the trade-offs behind model comparisons.</p>
    </section>
    <section aria-labelledby="current-notes">
      <h2 id="current-notes">Current notes</h2>
      <div class="grid">
        <article class="note-card">
          <p class="meta">Evaluation · 9 min</p>
          <h3><a href="/notes/reading-benchmark-results.html">Reading benchmark results carefully</a></h3>
          <p>Define the evaluation contract, inspect uncertainty, and check prompt sensitivity before treating a score as evidence.</p>
        </article>
        <article class="note-card">
          <p class="meta">Inference · 9 min</p>
          <h3><a href="/notes/latency-throughput-context.html">Latency, throughput, and context</a></h3>
          <p>Measure first-token delay, generation cadence, and capacity under a workload another person can reproduce.</p>
        </article>
        <article class="note-card">
          <p class="meta">Methods · 10 min</p>
          <h3><a href="/notes/repeatable-model-comparisons.html">Repeatable model comparisons</a></h3>
          <p>Turn a product question into a pinned manifest, paired observations, and a compact result bundle.</p>
        </article>
      </div>
    </section>
  </main>
  {{ site.footer() }}
</body>
</html>
