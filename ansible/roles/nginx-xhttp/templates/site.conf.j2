# Managed by Ansible role `nginx-xhttp`. Direct (no CDN) baseline.
# CDN-fronted variant lives in docs/CDN-DECISION.md as opt-in.
{% set nginx_redirect_port = nginx_xhttp_public_port | default(8443) | int %}
{% if (vpn.enable_snell | default(false)) and (snell | default({})).evaluation_enabled | default(false) %}
limit_req_zone $binary_remote_addr zone=snell_evaluation:1m rate=10r/s;
{% endif %}

server {
    listen {{ nginx_xhttp_public_port | default(8443) }} ssl http2;
    listen [::]:{{ nginx_xhttp_public_port | default(8443) }} ssl http2;

    server_name {{ nginx_xhttp.server_name }};

    server_tokens off;
    root /var/www/public-site;
    index index.html;

    ssl_certificate     /etc/nginx/tls/{{ nginx_xhttp.server_name }}.fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/{{ nginx_xhttp.server_name }}.key;

    ssl_protocols       TLSv1.3;
    ssl_ecdh_curve      X25519;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:vpn:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

{% if (vpn.enable_snell | default(false)) and (snell | default({})).evaluation_enabled | default(false) %}
    location ~ ^/{{ snell_secrets.evaluation_path_token }}/([0-9]+)\.bin$ {
        access_log off;
        limit_req zone=snell_evaluation burst=30 nodelay;
        gzip off;
        default_type application/octet-stream;
        alias {{ snell.evaluation_root }}/$1.bin;
    }
{% endif %}

    # XHTTP path → Xray localhost inbound
    location {{ xray.xhttp_path | default('/app-sync') }}/ {
        access_log off;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;

        # Streaming-friendly
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_pass http://127.0.0.1:{{ nginx_xhttp_port | default(10085) }};
    }

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    # Public site for ordinary browser and scanner requests.
    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/vpn-xhttp.access.log;
    error_log  /var/log/nginx/vpn-xhttp.error.log warn;
}
{% if nginx_xhttp.fallback_enabled | default(false) %}
{% set nginx_fallback_name = nginx_xhttp.fallback_server_name | default(nginx_xhttp.server_name) %}

# Secondary DIRECT (non-CDN) HTTPS XHTTP frontend. Distinct public port so
# XHTTP delivery survives a Cloudflare outage without touching the primary
# listener. Shares the same Xray localhost upstream. Carries NO Cloudflare
# real-IP-restoration / Origin-CA directives — this is the RU-baseline direct
# path, reachable by anyone, so it serves the same public site and never uses
# a silent-close response.
server {
    listen {{ nginx_xhttp_fallback_port | default(2083) }} ssl http2;
    listen [::]:{{ nginx_xhttp_fallback_port | default(2083) }} ssl http2;

    server_name {{ nginx_fallback_name }};

    server_tokens off;
    root /var/www/public-site;
    index index.html;

    ssl_certificate     /etc/nginx/tls/{{ nginx_fallback_name }}.fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/{{ nginx_fallback_name }}.key;

    ssl_protocols       TLSv1.3;
    ssl_ecdh_curve      X25519;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:vpn:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    # XHTTP path → Xray localhost inbound (shared with the primary frontend)
    location {{ xray.xhttp_path | default('/app-sync') }}/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;

        # Streaming-friendly
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_pass http://127.0.0.1:{{ nginx_xhttp_port | default(10085) }};
    }

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    # Serve the same public identity on the alternate HTTPS listener.
    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/vpn-xhttp-fallback.access.log;
    error_log  /var/log/nginx/vpn-xhttp-fallback.error.log warn;
}

{% if nginx_fallback_name != nginx_xhttp.server_name %}
# HTTP → HTTPS redirect for the distinct fallback host (so it looks like a site)
server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_fallback_name }};
    server_tokens off;
    return 301 https://$host:{{ nginx_xhttp_fallback_port | default(2083) }}$request_uri;
}
{% endif %}
{% endif %}

# HTTP → HTTPS redirect (so the host looks like a normal website)
server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_xhttp.server_name }};
    server_tokens off;
    return 301 https://$host{% if nginx_redirect_port != 443 %}:{{ nginx_redirect_port }}{% endif %}$request_uri;
}
