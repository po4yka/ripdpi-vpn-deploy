[Unit]
Description=RIPDPI schema-2 observability manifest adapter
After=node-manifest.service

[Service]
Type=oneshot
User={{ monitoring.node_exporter_user | default('prometheus') }}
Group={{ monitoring.node_exporter_group | default('prometheus') }}
ExecStart=/usr/local/libexec/observability-agent-adapter.py --manifest {{ node_manifest.path | default('/var/lib/ripdpi-vpn-deploy/manifest.json') }} --output {{ monitoring.node_exporter_textfile_dir | default('/var/lib/node_exporter/textfile') }}/observability-agent.prom --node-id {{ observability_agent.node_id }}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ monitoring.node_exporter_textfile_dir | default('/var/lib/node_exporter/textfile') }}
