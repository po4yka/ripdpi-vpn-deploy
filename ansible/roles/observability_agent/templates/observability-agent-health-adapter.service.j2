[Unit]
Description=RIPDPI watchdog, backup, and certificate health adapter
After=vpn-watchdog.service vpn-backup.service vpn-backup-restore-drill.service

[Service]
Slice=observability-agent.slice
Type=oneshot
User=root
Group={{ monitoring.node_exporter_textfile_group | default('node_exporter_textfile') }}
LoadCredential=client.crt:{{ observability_agent.credential_dir }}/generations/{{ _observability_agent_service_generation }}/client.crt
ExecStart=/usr/local/libexec/observability-agent-health-adapter.py \
  --node-id {{ observability_agent.node_id }} \
{% if (vpn | default({})).enable_watchdog | default(true) | bool %}  --watchdog-state {{ observability_agent_watchdog_state_path }} \
{% endif %}  --watchdog-fail-threshold {{ (watchdog | default({})).fail_threshold | default(3) }} \
  --watchdog-alert-limit {{ (watchdog | default({})).alerts_per_hour_max | default(4) }} \
  --watchdog-restart-limit {{ (watchdog | default({})).kicks_per_hour_max | default(3) }} \
  --watchdog-max-age-seconds {{ observability_agent_watchdog_max_age_seconds }} \
  --backup-stage {{ observability_agent_backup_stage_path }} \
  --backup-stage-max-age-seconds {{ observability_agent_backup_stage_max_age_seconds }} \
  --restore-drill {{ observability_agent_restore_drill_path }} \
  --restore-drill-max-age-seconds {{ observability_agent_restore_drill_max_age_seconds }} \
  --backup-snapshot-max-age-seconds {{ (backup_snapshot_max_age_hours | default(36) | int) * 3600 }} \
{% set protocols = vpn | default({}) -%}
{% set collector = observability_control_plane | default({}) -%}
{% set transports = not (vpn_subscription_only | default(false)) -%}
{% set services = {
  'xray.service': transports and ((protocols.enable_xray_reality | default(true)) or (protocols.enable_nginx_xhttp | default(true))),
  'nginx.service': (transports and (protocols.enable_nginx_xhttp | default(true))) or (protocols.enable_subscription_host | default(false)) or (vpn_subscription_only | default(false)),
  'hysteria-server.service': transports and (protocols.enable_hysteria | default(true)),
  'caddy-naive.service': transports and (protocols.enable_naive | default(false)),
  'observability-agent.service': observability_agent.enabled | default(false),
  'observability-alertmanager.service': collector.enabled | default(false),
  'observability-disk-guard.service': collector.enabled | default(false),
  'observability-ingress.service': collector.enabled | default(false),
  'observability-prometheus.service': collector.enabled | default(false)
} -%}
{% for service, enabled in services | dictsort if enabled and service in observability_alert_policy.required_systemd_units %}  --required-service {{ service | replace('.service', '') }} \
{% endfor %}  --certificate %d/client.crt \
  --output {{ monitoring.node_exporter_textfile_dir | default('/var/lib/node_exporter/textfile') }}/observability-health.prom
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=64M
TasksMax=16
LimitNOFILE=1024
{% if (vpn | default({})).enable_watchdog | default(true) | bool %}ReadOnlyPaths=-{{ observability_agent_watchdog_state_path }}
{% endif %}ReadOnlyPaths=-{{ observability_agent_backup_stage_path }}
ReadOnlyPaths=-{{ observability_agent_restore_drill_path }}
ReadWritePaths={{ monitoring.node_exporter_textfile_dir | default('/var/lib/node_exporter/textfile') }}
