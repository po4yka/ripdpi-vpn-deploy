[Unit]
Description=RIPDPI bounded observability remote-write agent
After=network-online.target
Wants=network-online.target

[Service]
Slice=observability-agent.slice
Type=simple
User=observability-agent
Group=observability-agent
LoadCredential=client.crt:{{ observability_agent.credential_dir }}/generations/{{ _observability_agent_service_generation }}/client.crt
LoadCredential=client.key:{{ observability_agent.credential_dir }}/generations/{{ _observability_agent_service_generation }}/client.key
LoadCredential=receiver-ca.crt:{{ observability_agent.credential_dir }}/generations/{{ _observability_agent_service_generation }}/receiver-ca.crt
LoadCredential=prometheus.yml:{{ observability_agent.credential_dir }}/generations/{{ _observability_agent_service_generation }}/prometheus.yml
WorkingDirectory=%d
ExecStart=/usr/local/bin/vmagent-observability-agent -promscrape.config=%d/prometheus.yml -remoteWrite.url={{ observability_agent.receiver_origin }}/remote-write/v1/nodes/{{ observability_agent.node_id }} -remoteWrite.tlsCAFile=%d/receiver-ca.crt -remoteWrite.tlsCertFile=%d/client.crt -remoteWrite.tlsKeyFile=%d/client.key -remoteWrite.tlsServerName={{ observability_agent.receiver_address }} -remoteWrite.forcePromProto=true -remoteWrite.queues=1 -remoteWrite.inmemoryQueues=0 -remoteWrite.keepDanglingQueues=true -remoteWrite.tmpDataPath={{ observability_agent.queue_dir }} -remoteWrite.maxDiskUsagePerURL={{ observability_agent.queue_max_disk_bytes }} -remoteWrite.maxRowsPerBlock=1000 -remoteWrite.maxBlockSize=1048576 -remoteWrite.flushInterval=5s -memory.allowedBytes=67108864 -maxLabelsPerTimeseries={{ observability_agent.scrape_label_limit }} -maxLabelNameLen={{ observability_agent.scrape_label_name_length_limit }} -maxLabelValueLen={{ observability_agent.scrape_label_value_length_limit }} -httpListenAddr={{ observability_agent.web_listen }}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax={{ observability_agent.memory_max }}
TasksMax={{ observability_agent.tasks_max }}
LimitNOFILE={{ observability_agent.nofile_limit }}
ReadWritePaths={{ observability_agent.queue_dir }}
UMask=0077

[Install]
WantedBy=multi-user.target
