global:
  scrape_interval: {{ observability_agent.scrape_interval }}
  external_labels:
    environment: "{{ observability_agent.environment }}"
    node_id: "{{ observability_agent.node_id }}"

scrape_configs:
  - job_name: node-exporter
    sample_limit: {{ observability_agent.scrape_sample_limit }}
    label_limit: {{ observability_agent.scrape_label_limit }}
    label_name_length_limit: {{ observability_agent.scrape_label_name_length_limit }}
    label_value_length_limit: {{ observability_agent.scrape_label_value_length_limit }}
    static_configs:
      - targets: ["127.0.0.1:9100"]
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: "^(node_(cpu|memory|filesystem|load|time|boot|network|disk|filefd)_.*|vpn_(xray_stats|observability_).*)$"
        action: keep
      - source_labels: [mountpoint]
        regex: "^$|^/$"
        action: keep
      - source_labels: [device]
        regex: "^$|^(lo|eth[0-9]+|ens[0-9]+|enp[0-9a-z]+|vda[0-9]*|sda[0-9]*|nvme[0-9]+n[0-9]+p?[0-9]*)$"
        action: keep
      - regex: "^(__name__|job|cpu|mode|device|fstype|mountpoint)$"
        action: labelkeep
  - job_name: observability-agent
    sample_limit: {{ observability_agent.scrape_sample_limit }}
    label_limit: {{ observability_agent.scrape_label_limit }}
    label_name_length_limit: {{ observability_agent.scrape_label_name_length_limit }}
    label_value_length_limit: {{ observability_agent.scrape_label_value_length_limit }}
    static_configs:
      - targets: ["{{ observability_agent.web_listen }}"]
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: "^(process_(cpu_seconds_total|resident_memory_bytes|open_fds|max_fds|start_time_seconds)|go_(goroutines|threads)|prometheus_remote_storage_(samples_pending|samples_failed_total|samples_retried_total|samples_dropped_total|queue_highest_timestamp_seconds|queue_highest_sent_timestamp_seconds))$"
        action: keep
      - regex: "^(__name__|job)$"
        action: labelkeep

remote_write:
  - url: "{{ observability_agent.receiver_origin }}/remote-write/v1/nodes/{{ observability_agent.node_id }}"
    tls_config:
      ca_file: receiver-ca.crt
      cert_file: client.crt
      key_file: client.key
      server_name: "{{ observability_agent.receiver_sni }}"
      insecure_skip_verify: false
    queue_config:
      capacity: {{ observability_agent.queue_capacity }}
      max_shards: 4
      max_samples_per_send: {{ observability_agent.queue_max_samples_per_send }}
      batch_send_deadline: {{ observability_agent.queue_batch_send_deadline }}
