rule_files:
  - alerts.yml
evaluation_interval: 1m
tests:
{% if observability_control_plane.alerting.deadman.enabled %}
  - interval: 1m
    input_series:
      - series: 'vpn_observability_deadman_reverse_timestamp_seconds{generation="{{ observability_control_plane.alerting.source_generation }}"}'
        values: '0x8'
    alert_rule_test:
      - eval_time: 7m
        alertname: ObservabilityDeadmanReverseMissing
        exp_alerts:
          - exp_labels:
              generation: "{{ observability_control_plane.alerting.source_generation }}"
              component: observability-pipeline
              severity: critical
            exp_annotations:
              incident_family: observability-deadman
              evidence_class: reverse-heartbeat-missing
              source_generation: "{{ observability_control_plane.alerting.source_generation }}"
              summary: Independent dead-man reverse health is missing or stale.
              runbook: docs/RUNBOOK-incident.md
  - interval: 1m
    input_series:
      - series: 'vpn_observability_deadman_health{check="unit",generation="{{ observability_control_plane.alerting.source_generation }}",state="error"}'
        values: '1x4'
    alert_rule_test:
      - eval_time: 2m
        alertname: ObservabilityDeadmanReverseUnhealthy
        exp_alerts:
          - exp_labels:
              check: unit
              state: error
              component: observability-pipeline
              severity: critical
            exp_annotations:
              incident_family: observability-deadman
              evidence_class: reverse-heartbeat-unhealthy
              source_generation: "{{ observability_control_plane.alerting.source_generation }}"
              summary: Independent dead-man reported an unhealthy bounded subsystem.
              runbook: docs/RUNBOOK-incident.md
{% endif %}
  - interval: 1m
    input_series:
      - series: 'vpn_watchdog_collection_success{node="vpn-p0",role="watchdog"}'
        values: '0x4 1x6'
      - series: 'vpn_watchdog_freshness_state{node="vpn-p0",role="watchdog",state="fresh"}'
        values: '0x4 1x6'
    alert_rule_test:
      - eval_time: 1m
        alertname: ObservabilityWatchdogEvidenceStale
        exp_alerts: []
      - eval_time: 4m
        alertname: ObservabilityWatchdogEvidenceStale
        exp_alerts:
          - exp_labels:
              component: watchdog
              node: vpn-p0
              role: watchdog
              severity: warning
            exp_annotations:
              evidence_class: stale-or-unknown
              incident_family: watchdog-evidence
              runbook: docs/RUNBOOK-incident.md
              source_generation: "{{ observability_control_plane.alerting.source_generation }}"
              summary: Watchdog evidence is missing or stale.
      - eval_time: 9m
        alertname: ObservabilityWatchdogEvidenceStale
        exp_alerts: []
  - interval: 1m
    input_series:
      - series: 'vpn_backup_freshness_state{node="vpn-p2",role="restore-drill",state="stale"}'
        values: '1x5'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityRestoreReadinessStale
        exp_alerts:
          - exp_labels:
              component: backup
              node: vpn-p2
              role: restore-drill
              severity: warning
              state: stale
            exp_annotations:
              evidence_class: stale-restore-proof
              incident_family: restore-readiness
              runbook: docs/RUNBOOK-restore.md
              source_generation: "{{ observability_control_plane.alerting.source_generation }}"
              summary: Approved isolated restore evidence is stale.
  - interval: 1m
    alert_rule_test:
      - eval_time: 5m
        alertname: ObservabilityBackupEvidenceStale
        exp_alerts: []
  - interval: 1m
    input_series:
      - series: 'node_filesystem_avail_bytes{environment="staging",node="vpn-p0",mountpoint="/"}'
        values: '4x8'
      - series: 'node_filesystem_size_bytes{environment="staging",node="vpn-p0",mountpoint="/"}'
        values: '100x8'
      - series: 'node_filesystem_readonly{environment="staging",node="vpn-p0",mountpoint="/"}'
        values: '0x8'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityNodeDiskSpaceCritical
        exp_alerts:
          - exp_labels: {component: node-filesystem, environment: staging, node: vpn-p0, severity: critical}
            exp_annotations: {incident_family: node-disk, evidence_class: disk-available-critical, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem available space crossed the configured critical threshold., runbook: docs/RUNBOOK-incident.md}
      - eval_time: 6m
        alertname: ObservabilityNodeDiskSpaceLow
        exp_alerts:
          - exp_labels: {component: node-filesystem, environment: staging, node: vpn-p0, severity: warning}
            exp_annotations: {incident_family: node-disk, evidence_class: disk-available-low, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem available space crossed the configured warning threshold., runbook: docs/RUNBOOK-incident.md}
  - interval: 1m
    input_series:
      - series: 'node_systemd_unit_state{environment="staging",node="vpn-p0",name="nginx.service",state="active"}'
        values: '0x5'
      - series: 'node_systemd_unit_state{environment="staging",node="vpn-p0",name="nginx.service",state="failed"}'
        values: '0x5'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityRequiredServiceNotActive
        exp_alerts:
          - exp_labels: {component: service, environment: staging, node: vpn-p0, severity: critical}
            exp_annotations: {incident_family: required-service, evidence_class: observed-service-not-active, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Fresh node telemetry reports a required systemd service is not active., runbook: docs/RUNBOOK-incident.md}
  - interval: 1m
    alert_rule_test:
      - eval_time: 5m
        alertname: ObservabilityRequiredServiceNotActive
        exp_alerts: []
  - interval: 1m
    input_series:
      - series: 'vpn_policy_ratelimit_last_success_timestamp_seconds{environment="staging",node="vpn-p1"}'
        values: '0x10'
      - series: 'vpn_policy_ratelimit_dead_contract{environment="staging",node="vpn-p1"}'
        values: '1x10'
      - series: 'vpn_policy_ratelimit_input_progress_total{environment="staging",node="vpn-p1"}'
        values: '10x10'
      - series: 'vpn_honeypot_events_60min{environment="staging",node="vpn-p1"}'
        values: '101x10'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityDetectorInputStalled
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-input, evidence_class: input-contract-stalled, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Detector input advanced without any recognized policy event., runbook: docs/RUNBOOK-incident.md}
      - eval_time: 4m
        alertname: ObservabilityDetectorEventThreshold
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-events, evidence_class: event-threshold, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security or reachability detector crossed its event threshold., runbook: docs/RUNBOOK-incident.md}
      - eval_time: 7m
        alertname: ObservabilityDetectorEvidenceStale
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-health, evidence_class: evidence-stale, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A detector success timestamp exceeded its bounded cadence., runbook: docs/RUNBOOK-incident.md}
  - interval: 1m
    input_series:
      - series: 'vpn_honeypot_input_errors_total{environment="staging",node="vpn-p1"}'
        values: '0 1 1 1 1 1 1 1 1'
      - series: 'vpn_honeypot_collection_success{environment="staging",node="vpn-p1"}'
        values: '1x9'
    alert_rule_test:
      - eval_time: 2m
        alertname: ObservabilityDetectorError
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-error, evidence_class: bounded-producer-error, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A detector reports a bounded producer error., runbook: docs/RUNBOOK-incident.md}
      - eval_time: 5m
        alertname: ObservabilityDetectorError
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-error, evidence_class: bounded-producer-error, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A detector reports a bounded producer error., runbook: docs/RUNBOOK-incident.md}
      - eval_time: 8m
        alertname: ObservabilityDetectorError
        exp_alerts: []
  - interval: 1m
    input_series:
      - series: 'vpn_certificate_collection_success{environment="staging",node="vpn-p0",role="observability-sender"}'
        values: '0x5'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityCertificateCollectionFailed
        exp_alerts:
          - exp_labels: {component: certificate, environment: staging, node: vpn-p0, severity: warning}
            exp_annotations: {incident_family: certificate-health, evidence_class: collection-failed, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Managed certificate expiry collection failed., runbook: docs/RUNBOOK-incident.md}
