rule_files:
  - alerts.yml
evaluation_interval: 1m
tests:
{% for increasing in [[], ['vm_persistentqueue_bytes_dropped_total'], ['vmagent_remotewrite_packets_dropped_total', 'vmagent_remotewrite_samples_dropped_total', 'vm_persistentqueue_bytes_dropped_total', 'vm_persistentqueue_blocks_dropped_total', 'vm_rows_ignored_total']] %}
  - interval: 1m
    input_series:
{% for metric in ['vmagent_remotewrite_packets_dropped_total', 'vmagent_remotewrite_samples_dropped_total', 'vm_persistentqueue_bytes_dropped_total', 'vm_persistentqueue_blocks_dropped_total', 'vm_rows_ignored_total'] %}
      - series: '{{ metric }}{environment="staging",node="vpn-p0",job="observability-agent"}'
        values: '{{ "0 1 1x10" if metric in increasing else "0x12" }}'
{% endfor %}
    alert_rule_test:
      - eval_time: 1m
        alertname: ObservabilityAgentDeliveryLoss
{% if increasing %}
        exp_alerts:
          - exp_labels: {component: observability-agent, environment: staging, node: vpn-p0, severity: warning}
            exp_annotations: {incident_family: observability-delivery-loss, evidence_class: samples-or-blocks-discarded, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Telemetry was discarded; monitoring history is incomplete and VPN reachability is unknown., runbook: docs/how-to/monitoring-alerts.md#observability-delivery-loss, action: "Run make observability-status. Check the sender queue and collector disk. History has a gap for this period."}
{% else %}
        exp_alerts: []
{% endif %}
{% endfor %}
{% for metric, extra in [
  ('vmagent_remotewrite_packets_dropped_total', ''),
  ('vmagent_remotewrite_samples_dropped_total', ''),
  ('vm_persistentqueue_bytes_dropped_total', ''),
  ('vm_persistentqueue_blocks_dropped_total', ''),
  ('vm_rows_ignored_total', 'reason="too_many_labels",'),
  ('vm_rows_ignored_total', 'reason="too_long_label_name",'),
  ('vm_rows_ignored_total', 'reason="too_long_label_value",')
] %}
  - interval: 1m
    input_series:
      - series: '{{ metric }}{ {{ extra }}environment="staging",node="vpn-p0"}'
        values: '0 1 1x10'
    alert_rule_test:
      - eval_time: 0m
        alertname: ObservabilityAgentDeliveryLoss
        exp_alerts: []
      - eval_time: 1m
        alertname: ObservabilityAgentDeliveryLoss
        exp_alerts:
          - exp_labels: {component: observability-agent, environment: staging, node: vpn-p0, severity: warning}
            exp_annotations: {incident_family: observability-delivery-loss, evidence_class: samples-or-blocks-discarded, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Telemetry was discarded; monitoring history is incomplete and VPN reachability is unknown., runbook: docs/how-to/monitoring-alerts.md#observability-delivery-loss, action: "Run make observability-status. Check the sender queue and collector disk. History has a gap for this period."}
      - eval_time: 10m
        alertname: ObservabilityAgentDeliveryLoss
        exp_alerts: []
{% endfor %}
  - interval: 1m
    input_series:
      - series: 'vpn_watchdog_collection_success{node="vpn-p0",role="watchdog"}'
        values: '0x4 1x6'
      - series: 'vpn_watchdog_freshness_state{node="vpn-p0",role="watchdog",state="fresh"}'
        values: '0x4 1x6'
    alert_rule_test:
      - eval_time: 1m
        alertname: ObservabilityWatchdogEvidenceStale
        exp_alerts: []
      - eval_time: 4m
        alertname: ObservabilityWatchdogEvidenceStale
        exp_alerts:
          - exp_labels:
              component: watchdog
              node: vpn-p0
              role: watchdog
              severity: warning
            exp_annotations:
              evidence_class: stale-or-unknown
              incident_family: watchdog-evidence
              runbook: docs/how-to/monitoring-alerts.md#watchdog-evidence
              action: "Check the watchdog timer and journal on the node."
              source_generation: "{{ observability_control_plane.alerting.source_generation }}"
              summary: Watchdog evidence is missing or stale.
      - eval_time: 9m
        alertname: ObservabilityWatchdogEvidenceStale
        exp_alerts: []
  - interval: 1m
    input_series:
      - series: 'vpn_backup_freshness_state{node="vpn-p2",role="restore-drill",state="stale"}'
        values: '1x5'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityRestoreReadinessStale
        exp_alerts:
          - exp_labels:
              component: backup
              node: vpn-p2
              role: restore-drill
              severity: warning
              state: stale
            exp_annotations:
              evidence_class: stale-restore-proof
              incident_family: restore-readiness
              runbook: docs/how-to/monitoring-alerts.md#restore-readiness
              action: "Check the restore drill timer and journal on the node."
              source_generation: "{{ observability_control_plane.alerting.source_generation }}"
              summary: The restore drill result is stale.
  - interval: 1m
    alert_rule_test:
      - eval_time: 5m
        alertname: ObservabilityBackupEvidenceStale
        exp_alerts: []
  - interval: 1m
    input_series:
      - series: 'node_filesystem_avail_bytes{environment="staging",node="vpn-p0",mountpoint="/"}'
        values: '4x8'
      - series: 'node_filesystem_size_bytes{environment="staging",node="vpn-p0",mountpoint="/"}'
        values: '100x8'
      - series: 'node_filesystem_readonly{environment="staging",node="vpn-p0",mountpoint="/"}'
        values: '0x8'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityNodeDiskSpaceCritical
        exp_alerts:
          - exp_labels: {component: node-filesystem, environment: staging, node: vpn-p0, severity: critical}
            exp_annotations: {incident_family: node-disk, evidence_class: disk-available-critical, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem free space is critically low., runbook: docs/how-to/monitoring-alerts.md#node-disk, action: "Free space on the root filesystem. Check the journal, the metrics queue and old releases.", value: "4% free"}
      - eval_time: 6m
        alertname: ObservabilityNodeDiskSpaceLow
        exp_alerts:
          - exp_labels: {component: node-filesystem, environment: staging, node: vpn-p0, severity: warning}
            exp_annotations: {incident_family: node-disk, evidence_class: disk-available-low, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem free space is low., runbook: docs/how-to/monitoring-alerts.md#node-disk, action: "Free space on the root filesystem. Check the journal, the metrics queue and old releases.", value: "4% free"}
  - interval: 1m
    input_series:
      - series: 'vpn_observability_required_service{environment="staging",node="vpn-p0",role="nginx"}'
        values: '1x5'
      - series: 'node_systemd_unit_state{environment="staging",node="vpn-p0",name="nginx.service",state="active"}'
        values: '0x5'
      - series: 'node_systemd_unit_state{environment="staging",node="vpn-p0",name="nginx.service",state="failed"}'
        values: '0x5'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityRequiredServiceNotActive
        exp_alerts:
          - exp_labels: {component: service, environment: staging, node: vpn-p0, role: nginx, severity: critical}
            exp_annotations: {incident_family: required-service, evidence_class: observed-service-not-active, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Fresh node telemetry reports a required systemd service is not active., runbook: docs/how-to/monitoring-alerts.md#required-service, action: "Read systemctl status and the journal for the named service. If the fault stays, redeploy or replace the node."}
  - interval: 1m
    alert_rule_test:
      - eval_time: 5m
        alertname: ObservabilityRequiredServiceNotActive
        exp_alerts: []
  - interval: 1m
    input_series:
      - series: 'vpn_policy_ratelimit_last_success_timestamp_seconds{environment="staging",node="vpn-p1"}'
        values: '0x10'
      - series: 'vpn_policy_ratelimit_dead_contract{environment="staging",node="vpn-p1"}'
        values: '1x10'
      - series: 'vpn_policy_ratelimit_input_progress_total{environment="staging",node="vpn-p1"}'
        values: '10x10'
      - series: 'vpn_honeypot_events_60min{environment="staging",node="vpn-p1"}'
        values: '101x10'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityDetectorInputStalled
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-input, evidence_class: input-contract-stalled, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Detector input matches no known policy event., runbook: docs/how-to/monitoring-alerts.md#detector-input, action: "Read the policy-ratelimit journal on the node and check for a log format change after a release."}
      - eval_time: 4m
        alertname: ObservabilityDetectorEventThreshold
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-events, evidence_class: event-threshold, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security or reachability detector crossed its event threshold., runbook: docs/how-to/monitoring-alerts.md#detector-events, action: "For probing events run make probing-summary with IP of this node. For burn failures run make burn-check. Then use the incident matrix."}
      - eval_time: 7m
        alertname: ObservabilityDetectorEvidenceStale
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-health, evidence_class: evidence-stale, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security detector stopped updating its results., runbook: docs/how-to/monitoring-alerts.md#detector-health, action: "Find which detector metric failed, then read the journal of that unit on the node."}
  - interval: 1m
    input_series:
      - series: 'vpn_honeypot_input_errors_total{environment="staging",node="vpn-p1"}'
        values: '0 1 1 1 1 1 1 1 1'
      - series: 'vpn_honeypot_collection_success{environment="staging",node="vpn-p1"}'
        values: '1x9'
    alert_rule_test:
      - eval_time: 2m
        alertname: ObservabilityDetectorError
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-error, evidence_class: bounded-producer-error, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security detector reports input errors., runbook: docs/how-to/monitoring-alerts.md#detector-error, action: "Find which detector metric reports errors, then read the journal of that unit on the node."}
      - eval_time: 5m
        alertname: ObservabilityDetectorError
        exp_alerts:
          - exp_labels: {component: detector, environment: staging, node: vpn-p1, severity: warning}
            exp_annotations: {incident_family: detector-error, evidence_class: bounded-producer-error, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security detector reports input errors., runbook: docs/how-to/monitoring-alerts.md#detector-error, action: "Find which detector metric reports errors, then read the journal of that unit on the node."}
      - eval_time: 8m
        alertname: ObservabilityDetectorError
        exp_alerts: []
  - interval: 1m
    input_series:
      - series: 'vpn_certificate_collection_success{environment="staging",node="vpn-p0",role="observability-sender"}'
        values: '0x5'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityCertificateCollectionFailed
        exp_alerts:
          - exp_labels: {component: certificate, environment: staging, node: vpn-p0, role: observability-sender, severity: warning}
            exp_annotations: {incident_family: certificate-health, evidence_class: collection-failed, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Managed certificate expiry collection failed., runbook: docs/how-to/monitoring-alerts.md#certificate-health, action: "Expiry data is missing. Read the journal of observability-agent-health-adapter.service on this node."}
  - interval: 1m
    input_series:
      - series: 'vpn_certificate_collection_success{environment="staging",node="vpn-p0",role="observability-sender"}'
        values: '1x5'
      - series: 'vpn_certificate_collection_success{environment="staging",node="vpn-p0",role="reality-self-steal"}'
        values: '0x5'
      - series: 'vpn_certificate_not_after_timestamp_seconds{environment="staging",node="vpn-p0",role="observability-sender"}'
        values: '9000000000x5'
      - series: 'vpn_certificate_not_after_timestamp_seconds{environment="staging",node="vpn-p0",role="reality-self-steal"}'
        values: '86400x5'
    alert_rule_test:
      - eval_time: 4m
        alertname: ObservabilityCertificateCollectionFailed
        exp_alerts:
          - exp_labels: {component: certificate, environment: staging, node: vpn-p0, role: reality-self-steal, severity: warning}
            exp_annotations: {incident_family: certificate-health, evidence_class: collection-failed, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Managed certificate expiry collection failed., runbook: docs/how-to/monitoring-alerts.md#certificate-health, action: "Expiry data is missing. Read the journal of observability-agent-health-adapter.service on this node."}
      - eval_time: 4m
        alertname: ObservabilityCertificateExpiresSoon
        exp_alerts:
          - exp_labels: {component: certificate, environment: staging, node: vpn-p0, role: reality-self-steal, severity: warning}
            exp_annotations: {incident_family: certificate-expiry, evidence_class: certificate-expiry-warning, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A managed certificate expires soon., runbook: docs/how-to/monitoring-alerts.md#certificate-expiry, action: "Renew the certificate named by role. Use make check-certs for transport certificates and make observability-rotate for observability-sender.", value: "23h 56m 0s to expiry"}
      - eval_time: 4m
        alertname: ObservabilityCertificateExpiresCritical
        exp_alerts:
          - exp_labels: {component: certificate, environment: staging, node: vpn-p0, role: reality-self-steal, severity: critical}
            exp_annotations: {incident_family: certificate-expiry, evidence_class: certificate-expiry-critical, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A managed certificate is close to expiry., runbook: docs/how-to/monitoring-alerts.md#certificate-expiry, action: "Renew the certificate named by role. Use make check-certs for transport certificates and make observability-rotate for observability-sender.", value: "23h 56m 0s to expiry"}
{% for metric in ['vmagent_remotewrite_packets_dropped_total', 'vmagent_remotewrite_samples_dropped_total'] %}
  - interval: 1m
    input_series:
      - series: '{{ metric }}{job="observability-relay"}'
        values: '0 1 1x10'
    alert_rule_test:
      - eval_time: 0m
        alertname: ObservabilityCollectorRelayDeliveryLoss
        exp_alerts: []
      - eval_time: 1m
        alertname: ObservabilityAgentDeliveryLoss
        exp_alerts: []
      - eval_time: 1m
        alertname: ObservabilityCollectorRelayDeliveryLoss
        exp_alerts:
          - exp_labels: {component: observability-relay, environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}", node: collector, severity: warning}
            exp_annotations: {incident_family: observability-delivery-loss, evidence_class: relay-accepted-samples-discarded, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: The collector relay discarded accepted telemetry; monitoring history is incomplete., runbook: docs/how-to/monitoring-alerts.md#observability-delivery-loss, action: "Run make observability-status. Check the sender queue and collector disk. History has a gap for this period."}
      - eval_time: 10m
        alertname: ObservabilityCollectorRelayDeliveryLoss
        exp_alerts: []
{% endfor %}
  - interval: 1m
    input_series:
      - series: 'vpn_protocol_probe_observed_timestamp_seconds{environment="staging",node="vpn-path",protocol="vless-reality",vantage="sentinel-a"}'
        values: '0+60x30'
      # The xhttp probe stops after two minutes; the other protocol keeps reporting.
      - series: 'vpn_protocol_probe_observed_timestamp_seconds{environment="staging",node="vpn-path",protocol="xhttp",vantage="sentinel-a"}'
        values: '0+60x2 _x28'
    alert_rule_test:
      - eval_time: 5m
        alertname: ObservabilityProtocolProbeStale
        exp_alerts: []
      - eval_time: 15m
        alertname: ObservabilityProtocolProbeStale
        exp_alerts:
          - exp_labels: {component: protocol-probe, environment: staging, node: vpn-path, protocol: xhttp, vantage: sentinel-a, severity: warning}
            exp_annotations: {incident_family: protocol-probe, evidence_class: probe-stale, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A protocol probe stopped reporting; health of this protocol is unknown., runbook: docs/how-to/monitoring-alerts.md#protocol-probe, action: "Check the liveness sentinel for this vantage and the published evidence. Do not treat the protocol as healthy."}
  - interval: 1m
    input_series:
      # 60 percent of xhttp attempts fail in one ASN and 70 percent of hysteria2 attempts in one SIM operator;
      # 5 percent of vless-reality attempts fail in that operator.
      - series: 'vpn_field_report_attempts_total{environment="staging",node="vpn-sub",protocol="hysteria2",network="001-01",country="unknown"}'
        values: '0+100x120'
      - series: 'vpn_field_report_failures_total{environment="staging",node="vpn-sub",protocol="hysteria2",failure_stage="quic_handshake",network="001-01"}'
        values: '0+70x120'
      - series: 'vpn_field_report_network_reports_total{environment="staging",node="vpn-sub",protocol="hysteria2",network="001-01"}'
        values: '0+1x120'
      - series: 'vpn_field_report_attempts_total{environment="staging",node="vpn-sub",protocol="xhttp",network="as64500",country="ZZ"}'
        values: '0+100x120'
      - series: 'vpn_field_report_failures_total{environment="staging",node="vpn-sub",protocol="xhttp",failure_stage="tls_handshake",network="as64500"}'
        values: '0+60x120'
      - series: 'vpn_field_report_attempts_total{environment="staging",node="vpn-sub",protocol="vless-reality",network="001-01",country="ZZ"}'
        values: '0+100x120'
      - series: 'vpn_field_report_failures_total{environment="staging",node="vpn-sub",protocol="vless-reality",failure_stage="tcp_reset",network="001-01"}'
        values: '0+5x120'
      - series: 'vpn_field_report_network_reports_total{environment="staging",node="vpn-sub",protocol="xhttp",network="as64500"}'
        values: '0+1x120'
      - series: 'vpn_field_report_network_reports_total{environment="staging",node="vpn-sub",protocol="vless-reality",network="001-01"}'
        values: '0+1x120'
    alert_rule_test:
      - eval_time: 5m
        alertname: FieldReportClientFailureRatioHigh
        exp_alerts: []
      - eval_time: 30m
        alertname: FieldReportClientFailureRatioHigh
        exp_alerts:
          - exp_labels: {component: field-report, environment: staging, node: field-reports, protocol: xhttp, network: as64500, severity: warning}
            exp_annotations: {value: "xhttp in as64500 60% failed", incident_family: field-report-failure, evidence_class: client-failure-ratio, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Client field reports show a high failure ratio for one protocol and network., runbook: docs/how-to/monitoring-alerts.md#field-report-failure, action: "Compare with the protocol probe for this protocol. If the probe is healthy, read the failure stages for this network before you rotate."}
          - exp_labels: {component: field-report, environment: staging, node: field-reports, protocol: hysteria2, network: "001-01", severity: warning}
            exp_annotations: {value: "hysteria2 in 001-01 70% failed", incident_family: field-report-failure, evidence_class: client-failure-ratio, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Client field reports show a high failure ratio for one protocol and network., runbook: docs/how-to/monitoring-alerts.md#field-report-failure, action: "Compare with the protocol probe for this protocol. If the probe is healthy, read the failure stages for this network before you rotate."}
{% for case in ['divergence', 'server-down', 'stale-probe', 'missing-probe', 'low-sample', 'single-report', 'untrusted-origin', 'other', 'unknown'] %}
{% set origin = 'vpn-p0' if case == 'untrusted-origin' else 'vpn-sub' %}
{# The folded "other" and "unknown" values name no real network, so they never raise a block alert. #}
{% set network = case if case in ['other', 'unknown'] else 'as64500' %}
  - interval: 1m
    input_series:
      - series: 'vpn_protocol_probe_success{environment="staging",node="vpn-path",protocol="xhttp",vantage="sentinel-a"}'
        values: '{{ "0x120" if case == "server-down" else "1x120" }}'
{% if case != 'missing-probe' %}
      - series: 'vpn_protocol_probe_complete_until_seconds{environment="staging",node="protocol-liveness",protocol="xhttp"}'
        values: '{{ "0x120" if case == "server-down" else "180x120" if case == "stale-probe" else "180+60x120" }}'
{% endif %}
{% if case == 'low-sample' %}
      # 100 percent failures, but 60 attempts per hour stay under the floor of 100.
      - series: 'vpn_field_report_attempts_total{environment="staging",node="{{ origin }}",protocol="xhttp",network="{{ network }}",country="ZZ"}'
        values: '0+1x120'
      - series: 'vpn_field_report_failures_total{environment="staging",node="{{ origin }}",protocol="xhttp",failure_stage="tcp_reset",network="{{ network }}"}'
        values: '0+1x120'
{% else %}
      # 70 percent of 6000 attempts per hour fail: 50 per minute in TLS, 20 per minute by reset.
      - series: 'vpn_field_report_attempts_total{environment="staging",node="{{ origin }}",protocol="xhttp",network="{{ network }}",country="ZZ"}'
        values: '0+100x120'
      - series: 'vpn_field_report_failures_total{environment="staging",node="{{ origin }}",protocol="xhttp",failure_stage="tls_handshake",network="{{ network }}"}'
        values: '0+50x120'
      - series: 'vpn_field_report_failures_total{environment="staging",node="{{ origin }}",protocol="xhttp",failure_stage="tcp_reset",network="{{ network }}"}'
        values: '0+20x120'
{% endif %}
      # One report each minute, except one large report that carries every attempt. In untrusted-origin
      # an enrolled node that is no configured subscription host sends the whole divergence.
      - series: 'vpn_field_report_network_reports_total{environment="staging",node="{{ origin }}",protocol="xhttp",network="{{ network }}"}'
        values: '{{ "0 1x120" if case == "single-report" else "0+1x120" }}'
    alert_rule_test:
      - eval_time: 10m
        alertname: FieldReportNetworkBlocked
        exp_alerts: []
      - eval_time: 60m
        alertname: FieldReportNetworkBlocked
{% if case == 'divergence' %}
        exp_alerts:
          - exp_labels: {component: field-report, environment: staging, node: field-reports, protocol: xhttp, network: as64500, country: ZZ, severity: warning}
            exp_annotations:
              value: "xhttp in as64500 ZZ 70% failed"
              stage_mix: "tls_handshake=3000 tcp_reset=1200 "
              rotation_hint: "Client reports show this network blocking the protocol while the sentinel sees it healthy. Consider a fresh endpoint for it in the next fleet-rotate plan."
              incident_family: field-report-network-block
              evidence_class: sentinel-client-divergence
              source_generation: "{{ observability_control_plane.alerting.source_generation }}"
              summary: A protocol is blocked in one network while the sentinel sees it healthy.
              runbook: docs/how-to/monitoring-alerts.md#field-report-network-block
              action: "Read stage_mix and rotation_hint, then run fleet-rotate in PLAN mode with --block-hints. You decide on any rotation."
{% else %}
        exp_alerts: []
{% endif %}
{% if case in ['single-report', 'untrusted-origin'] %}
      - eval_time: 60m
        alertname: FieldReportClientFailureRatioHigh
        exp_alerts: []
{% endif %}
{% if case in ['other', 'unknown'] %}
      # The fleet-wide ratio alert still counts the folded values.
      - eval_time: 60m
        alertname: FieldReportClientFailureRatioHigh
        exp_alerts:
          - exp_labels: {component: field-report, environment: staging, node: field-reports, protocol: xhttp, network: "{{ network }}", severity: warning}
            exp_annotations: {value: "xhttp in {{ network }} 70% failed", incident_family: field-report-failure, evidence_class: client-failure-ratio, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Client field reports show a high failure ratio for one protocol and network., runbook: docs/how-to/monitoring-alerts.md#field-report-failure, action: "Compare with the protocol probe for this protocol. If the probe is healthy, read the failure stages for this network before you rotate."}
{% endif %}
{% if case == 'server-down' %}
      # The client-side failure alert still reports the network; only the block diagnosis is withheld.
      - eval_time: 60m
        alertname: FieldReportClientFailureRatioHigh
        exp_alerts:
          - exp_labels: {component: field-report, environment: staging, node: field-reports, protocol: xhttp, network: as64500, severity: warning}
