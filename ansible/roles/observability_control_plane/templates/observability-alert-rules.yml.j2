{% set policy = observability_alert_policy -%}
groups:
  - name: observability_pipeline_canary
    interval: 30s
    rules:
      - alert: ObservabilityPipelineCanary
        expr: vector(time())
        for: 0s
        keep_firing_for: 0s
        labels:
          severity: watchdog
          environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}"
          node: collector
          component: observability-pipeline
        annotations:
          evaluated_at: '{% raw %}{{ $value }}{% endraw %}'
          incident_family: observability-pipeline
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Synthetic rule-to-relay freshness receipt.
          evidence_class: synthetic-pipeline
          runbook: docs/how-to/incident.md
{% for kind in ['node', 'pipeline', 'delivery'] %}
{% for node in (observability_push.expected_nodes if kind == 'node' else [observability_push.node_id]) %}
{% set selector = 'environment="' ~ observability_control_plane.alerting.silence_gateway.environment ~ '",node="' ~ node ~ '",kind="' ~ kind ~ '"' %}
      - alert: ObservabilityExternalCoverageUnavailable
        expr: >-
          max((observability_push_success{ {{ selector }} } == 0)
          or (time() - observability_push_last_success_timestamp_seconds{ {{ selector }} } > {{ 660 if kind == 'delivery' else 180 }})
          or absent(observability_push_success{ {{ selector }} })
          or absent(observability_push_last_success_timestamp_seconds{ {{ selector }} }))
        for: 1m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: critical
          component: observability-external-coverage
          environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}"
          node: "{{ node }}"
          kind: "{{ kind }}"
        annotations:
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Independent monitoring coverage is unavailable; VPN reachability is unknown.
          incident_family: observability-external-coverage
          evidence_class: external-coverage-unavailable
          runbook: docs/how-to/incident.md
{% endfor %}
{% endfor %}
  - name: observability_agent_delivery
    rules:
      - alert: ObservabilityAgentDeliveryLoss
        expr: >-
          (max by (environment, node) (increase(vmagent_remotewrite_packets_dropped_total[5m]) > bool 0) > 0)
          or (max by (environment, node) (increase(vmagent_remotewrite_samples_dropped_total[5m]) > bool 0) > 0)
          or (max by (environment, node) (increase(vm_persistentqueue_bytes_dropped_total[5m]) > bool 0) > 0)
          or (max by (environment, node) (increase(vm_persistentqueue_blocks_dropped_total[5m]) > bool 0) > 0)
          or (max by (environment, node) (increase(vm_rows_ignored_total[5m]) > bool 0) > 0)
        for: 0s
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: observability-agent}
        annotations: {incident_family: observability-delivery-loss, evidence_class: samples-or-blocks-discarded, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Telemetry was discarded; monitoring history is incomplete and VPN reachability is unknown., runbook: docs/how-to/incident.md}
  - name: observability_node_resource_service
    rules:
      - alert: ObservabilityNodeCpuPressure
        expr: >-
          (sum by (environment, node) (rate(node_cpu_seconds_total{mode!="idle"}[5m]))
          / sum by (environment, node) (rate(node_cpu_seconds_total[5m]))) > {{ policy.cpu_warning_ratio }}
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-resource}
        annotations: {incident_family: node-cpu, evidence_class: sustained-cpu-pressure, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Node CPU utilization is above the bounded warning threshold., runbook: docs/how-to/incident.md}
      - alert: ObservabilityNodeMemoryPressure
        expr: >-
          (1 - (max by (environment, node) (node_memory_MemAvailable_bytes)
          / max by (environment, node) (node_memory_MemTotal_bytes))) > {{ policy.memory_warning_ratio }}
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-resource}
        annotations: {incident_family: node-memory, evidence_class: memory-available-low, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Node available memory is below the bounded warning threshold., runbook: docs/how-to/incident.md}
      - alert: ObservabilityNodeSwapPressure
        expr: >-
          max by (environment, node) (node_memory_SwapTotal_bytes) > 0
          and on (environment, node)
          ((max by (environment, node) (node_memory_SwapTotal_bytes)
          - max by (environment, node) (node_memory_SwapFree_bytes))
          / max by (environment, node) (node_memory_SwapTotal_bytes)) > {{ policy.swap_warning_ratio }}
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-resource}
        annotations: {incident_family: node-swap, evidence_class: sustained-swap-pressure, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Node swap utilization is above the bounded warning threshold., runbook: docs/how-to/incident.md}
      - alert: ObservabilityNodeDiskSpaceLow
        expr: >-
          min by (environment, node) (node_filesystem_avail_bytes{mountpoint="{{ policy.filesystem_mountpoint }}"} / node_filesystem_size_bytes{mountpoint="{{ policy.filesystem_mountpoint }}"}) < {{ policy.disk_warning_ratio }}
          and on (environment, node)
          max by (environment, node) (node_filesystem_readonly{mountpoint="{{ policy.filesystem_mountpoint }}"}) == 0
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-filesystem}
        annotations: {incident_family: node-disk, evidence_class: disk-available-low, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem available space crossed the configured warning threshold., runbook: docs/how-to/incident.md}
      - alert: ObservabilityNodeDiskSpaceCritical
        expr: >-
          min by (environment, node) (node_filesystem_avail_bytes{mountpoint="{{ policy.filesystem_mountpoint }}"} / node_filesystem_size_bytes{mountpoint="{{ policy.filesystem_mountpoint }}"}) < {{ policy.disk_critical_ratio }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: node-filesystem}
        annotations: {incident_family: node-disk, evidence_class: disk-available-critical, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem available space crossed the configured critical threshold., runbook: docs/how-to/incident.md}
      - alert: ObservabilityNodeInodesLow
        expr: >-
          min by (environment, node) (node_filesystem_files_free{mountpoint="{{ policy.filesystem_mountpoint }}"} / node_filesystem_files{mountpoint="{{ policy.filesystem_mountpoint }}"}) < {{ policy.inode_warning_ratio }}
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-filesystem}
        annotations: {incident_family: node-inodes, evidence_class: inode-available-low, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem free inodes crossed the configured warning threshold., runbook: docs/how-to/incident.md}
      - alert: ObservabilityNodeInodesCritical
        expr: >-
          min by (environment, node) (node_filesystem_files_free{mountpoint="{{ policy.filesystem_mountpoint }}"} / node_filesystem_files{mountpoint="{{ policy.filesystem_mountpoint }}"}) < {{ policy.inode_critical_ratio }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: node-filesystem}
        annotations: {incident_family: node-inodes, evidence_class: inode-available-critical, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem free inodes crossed the configured critical threshold., runbook: docs/how-to/incident.md}
      - alert: ObservabilityRequiredServiceNotActive
        expr: >-
          max by (environment, node, role) (
            label_replace(node_systemd_unit_state{name=~"^({% for unit in policy.required_systemd_units %}{{ unit | replace('.', '[.]') }}{% if not loop.last %}|{% endif %}{% endfor %})$",state="active"} == 0, "role", "$1", "name", "^(.*)[.]service$")
            or label_replace(node_systemd_unit_state{state="failed"} == 1, "role", "$1", "name", "^(.*)[.]service$"))
          and on (environment, node, role) (vpn_observability_required_service == 1)
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: service}
        annotations: {incident_family: required-service, evidence_class: observed-service-not-active, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Fresh node telemetry reports a required systemd service is not active., runbook: docs/how-to/incident.md}
      - alert: ObservabilityRequiredServiceEvidenceMissing
        expr: >-
          (vpn_observability_required_service == 1)
          unless on (environment, node, role)
          max by (environment, node, role) (label_replace(node_systemd_unit_state{state="active"}, "role", "$1", "name", "^(.*)[.]service$"))
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: service}
        annotations: {incident_family: required-service-evidence, evidence_class: service-evidence-absent, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A profile-required service has no systemd evidence; its health is unknown., runbook: docs/how-to/incident.md}
      - alert: ObservabilityNodeClockSkew
        expr: max by (environment, node) (abs(node_time_seconds - time())) > {{ policy.clock_skew_seconds }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-clock}
        annotations: {incident_family: node-clock, evidence_class: wall-clock-skew, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Node wall clock differs from control-plane evaluation time., runbook: docs/how-to/incident.md}
      - alert: ObservabilityCertificateExpiresSoon
        expr: min by (environment, node) (vpn_certificate_not_after_timestamp_seconds - time()) < {{ policy.certificate_warning_seconds }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: certificate}
        annotations: {incident_family: certificate-expiry, evidence_class: certificate-expiry-warning, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A managed certificate crossed the configured expiry warning threshold., runbook: docs/how-to/incident.md}
      - alert: ObservabilityCertificateCollectionFailed
        expr: max by (environment, node) (vpn_certificate_collection_success) == 0
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: certificate}
        annotations: {incident_family: certificate-health, evidence_class: collection-failed, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Managed certificate expiry collection failed., runbook: docs/how-to/incident.md}
      - alert: ObservabilityCertificateExpiresCritical
        expr: min by (environment, node) (vpn_certificate_not_after_timestamp_seconds - time()) < {{ policy.certificate_critical_seconds }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: certificate}
        annotations: {incident_family: certificate-expiry, evidence_class: certificate-expiry-critical, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A managed certificate crossed the configured expiry critical threshold., runbook: docs/how-to/incident.md}
      - alert: ObservabilityNodeNetworkErrors
        expr: >-
          sum by (environment, node) (rate(node_network_receive_errs_total{device!~"{{ policy.network_device_exclude_regex }}"}[5m]) + rate(node_network_transmit_errs_total{device!~"{{ policy.network_device_exclude_regex }}"}[5m])) > {{ policy.network_error_rate }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-network}
        annotations: {incident_family: node-network, evidence_class: sustained-interface-errors, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A node reports sustained interface errors., runbook: docs/how-to/incident.md}
      - alert: ObservabilityNodeFilesystemReadOnly
        expr: max by (environment, node) (node_filesystem_readonly{mountpoint="{{ policy.filesystem_mountpoint }}"}) == 1
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: node-filesystem}
        annotations: {incident_family: node-filesystem, evidence_class: root-filesystem-read-only, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: The root filesystem is read only., runbook: docs/how-to/incident.md}
      - alert: ObservabilityServiceRestartLoop
        expr: max by (environment, node) (vpn_watchdog_restart_attempts) >= {{ policy.restart_attempts }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: service}
        annotations: {incident_family: service-restart-loop, evidence_class: bounded-restart-limit, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Bounded watchdog restart attempts reached the configured limit., runbook: docs/how-to/incident.md}
  - name: observability_security_detectors
    rules:
      - alert: ObservabilityDetectorCollectionFailed
        expr: >-
          max by (environment, node) (vpn_honeypot_collection_success) == 0
          or max by (environment, node) (vpn_policy_ratelimit_collection_success) == 0
          or max by (environment, node) (vpn_xray_stats_collection_success) == 0
          or max by (environment, node) (vpn_burn_run_error) == 1
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-health, evidence_class: collection-failed, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A bounded detector collection failed., runbook: docs/how-to/incident.md}
      - alert: ObservabilityDetectorEvidenceStale
        expr: >-
          max by (environment, node) (time() - vpn_honeypot_last_success_timestamp_seconds) > {{ policy.detector_stale_seconds }}
          or max by (environment, node) (time() - vpn_policy_ratelimit_last_success_timestamp_seconds) > {{ policy.detector_stale_seconds }}
          or max by (environment, node) (time() - vpn_xray_stats_collected_timestamp_seconds) > {{ policy.detector_stale_seconds }}
          or max by (environment, node) (time() - vpn_burn_last_run_unixtime) > {{ policy.burn_stale_seconds }}
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-health, evidence_class: evidence-stale, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A detector success timestamp exceeded its bounded cadence., runbook: docs/how-to/incident.md}
      - alert: ObservabilityDetectorInputStalled
        expr: >-
          max by (environment, node) (vpn_policy_ratelimit_dead_contract) == 1
          and on (environment, node)
          max by (environment, node) (vpn_policy_ratelimit_input_progress_total) > 0
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-input, evidence_class: input-contract-stalled, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Detector input advanced without any recognized policy event., runbook: docs/how-to/incident.md}
      - alert: ObservabilityDetectorError
        expr: >-
          sum by (environment, node) (increase(vpn_honeypot_input_errors_total[{{ policy.detector_hold }}])) > 0
          or sum by (environment, node) (increase(vpn_policy_ratelimit_input_errors_total[{{ policy.detector_hold }}])) > 0
          or max by (environment, node) (vpn_burn_api_error) == 1
        for: 0m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-error, evidence_class: bounded-producer-error, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A detector reports a bounded producer error., runbook: docs/how-to/incident.md}
      - alert: ObservabilityDetectorEventThreshold
        expr: >-
          max by (environment, node) (vpn_honeypot_events_60min) > {{ policy.honeypot_events_60min }}
          or sum by (environment, node) (increase(vpn_policy_ratelimit_events_total[5m])) > {{ policy.policy_events_5min }}
          or max by (environment, node) (vpn_burn_failed_nodes) > 0
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-events, evidence_class: event-threshold, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security or reachability detector crossed its event threshold., runbook: docs/how-to/incident.md}
  - name: observability_producer_deadlines
    rules:
{% for node in observability_push.expected_nodes %}
      - alert: ObservabilityAdapterCompletionMissing
        expr: >-
          max by (node) (absent(vpn_observability_evidence_timestamp_seconds{node="{{ node }}",role="health-adapter"})
          or absent(vpn_observability_adapter_collected_timestamp_seconds{node="{{ node }}"}))
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: warning, component: producer-evidence, node: "{{ node }}", environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}"}
        annotations: {incident_family: producer-evidence, evidence_class: required-adapter-never-published, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A required node adapter has no completion clock; monitoring health is unknown., runbook: docs/how-to/incident.md}
{% endfor %}
{% for adapter in [{'node': 'observability-control-plane', 'role': 'control-plane-adapter', 'enabled': (observability_control_plane.expected_targets | default({})).enabled | default(false)}, {'node': 'protocol-liveness', 'role': 'liveness-published-evidence', 'enabled': (observability_control_plane.protocol_liveness | default({})).enabled | default(false)}] if adapter.enabled %}
      - alert: ObservabilityOptionalAdapterCompletionMissing
        expr: absent(vpn_observability_evidence_timestamp_seconds{node="{{ adapter.node }}",role="{{ adapter.role }}"})
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: warning, component: producer-evidence, node: "{{ adapter.node }}", role: "{{ adapter.role }}", environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}"}
        annotations: {incident_family: producer-evidence, evidence_class: enabled-adapter-never-published, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: An enabled collector adapter has no completion clock; monitoring health is unknown., runbook: docs/how-to/incident.md}
{% endfor %}
      - alert: ObservabilityProducerEvidenceUnavailable
        expr: >-
          (time() - vpn_observability_evidence_timestamp_seconds > on (environment, node, role) vpn_observability_evidence_max_age_seconds)
          or (vpn_observability_evidence_timestamp_seconds > time() + 30)
          or (vpn_observability_evidence_max_age_seconds unless on (environment, node, role) vpn_observability_evidence_timestamp_seconds)
          or (vpn_observability_evidence_timestamp_seconds unless on (environment, node, role) vpn_observability_evidence_max_age_seconds)
          or (vpn_observability_evidence_max_age_seconds <= 0)
          or (vpn_observability_evidence_max_age_seconds > 4492800)
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: warning, component: producer-evidence}
        annotations: {incident_family: producer-evidence, evidence_class: stale-future-or-incomplete-deadline, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Producer evidence expired or has an invalid deadline; monitoring health is unknown., runbook: docs/how-to/incident.md}
      - alert: ObservabilityManifestAdapterStalled
        expr: >-
          (time() - vpn_observability_adapter_collected_timestamp_seconds > 180)
          or (vpn_observability_adapter_collected_timestamp_seconds > time() + 30)
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: warning, component: producer-evidence}
        annotations: {incident_family: producer-evidence, evidence_class: manifest-adapter-stalled, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Node manifest adapter completion is expired or future dated., runbook: docs/how-to/incident.md}
  - name: observability_watchdog_backup
    rules:
      - alert: ObservabilityWatchdogEvidenceStale
        expr: >-
          (vpn_watchdog_collection_success == 0)
          or on (node, role)
          (vpn_watchdog_freshness_state{state="stale"} == 1)
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: warning
          component: watchdog
        annotations:
          incident_family: watchdog-evidence
          evidence_class: stale-or-unknown
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Watchdog evidence is missing or stale.
          runbook: docs/how-to/incident.md
      - alert: ObservabilityWatchdogRecoveryUnresolved
        expr: vpn_watchdog_recovery_outcome{state="unresolved"} == 1
        for: 2m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: warning
          component: watchdog
        annotations:
          incident_family: watchdog-recovery
          evidence_class: local-recovery-unresolved
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Bounded local watchdog recovery remains unresolved.
          runbook: docs/how-to/incident.md
      - alert: ObservabilityBackupEvidenceStale
        expr: >-
          (vpn_backup_collection_success == 0)
          or on (node, role)
          (vpn_backup_freshness_state{state="stale"} == 1)
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: warning
          component: backup
        annotations:
          incident_family: backup-evidence
          evidence_class: stale-or-unknown
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Backup evidence is missing or stale.
          runbook: docs/how-to/restore.md
      - alert: ObservabilityBackupStageFailed
        expr: vpn_backup_result{state="failed"} == 1
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: critical
          component: backup
        annotations:
          incident_family: backup-stage
          evidence_class: confirmed-stage-failure
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: A producer-owned backup stage reported failure.
          runbook: docs/how-to/restore.md
      - alert: ObservabilityRestoreReadinessStale
        expr: vpn_backup_freshness_state{role="restore-drill",state="stale"} == 1
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: warning
          component: backup
        annotations:
          incident_family: restore-readiness
          evidence_class: stale-restore-proof
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Approved isolated restore evidence is stale.
          runbook: docs/how-to/restore.md
