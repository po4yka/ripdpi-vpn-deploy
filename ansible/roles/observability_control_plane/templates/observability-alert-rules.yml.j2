{% set policy = observability_alert_policy -%}
groups:
  - name: observability_pipeline_canary
    interval: 15s
    rules:
      - alert: ObservabilityPipelineCanary
        expr: vector(time())
        for: 0s
        keep_firing_for: 0s
        labels:
          severity: watchdog
          environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}"
          node: collector
          component: observability-pipeline
        annotations:
          evaluated_at: '{% raw %}{{ $value }}{% endraw %}'
          incident_family: observability-pipeline
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Synthetic rule-to-relay freshness receipt.
          evidence_class: synthetic-pipeline
          runbook: docs/how-to/monitoring-alerts.md#observability-pipeline
          action: "No action. This is the synthetic delivery canary."
{% for kind in ['node', 'pipeline', 'delivery'] %}
{% for node in (observability_push.expected_nodes if kind == 'node' else [observability_push.node_id]) %}
{# Senders label their own environment; node and kind alone identify the push scope. -#}
{% set selector = 'node="' ~ node ~ '",kind="' ~ kind ~ '"' %}
      - alert: ObservabilityExternalCoverageUnavailable
        expr: >-
          max((observability_push_success{ {{ selector }} } == 0)
          or (time() - observability_push_last_success_timestamp_seconds{ {{ selector }} } > {{ 660 if kind == 'delivery' else 180 }})
          or absent(observability_push_success{ {{ selector }} })
          or absent(observability_push_last_success_timestamp_seconds{ {{ selector }} }))
        for: 1m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: critical
          component: observability-external-coverage
          environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}"
          node: "{{ node }}"
          kind: "{{ kind }}"
        annotations:
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Independent monitoring coverage is unavailable; VPN reachability is unknown.
          incident_family: observability-external-coverage
          evidence_class: external-coverage-unavailable
          runbook: docs/how-to/monitoring-alerts.md#observability-external-coverage
          action: "Open the private Kuma panel and find the monitor that is down. VPN state is unknown until coverage returns."
{% endfor %}
{% endfor %}
  - name: observability_agent_delivery
    rules:
      - alert: ObservabilityAgentDeliveryLoss
        expr: >-
          (max by (environment, node) (increase(vmagent_remotewrite_packets_dropped_total{job!="observability-relay"}[5m]) > bool 0) > 0)
          or (max by (environment, node) (increase(vmagent_remotewrite_samples_dropped_total{job!="observability-relay"}[5m]) > bool 0) > 0)
          or (max by (environment, node) (increase(vm_persistentqueue_bytes_dropped_total{job!="observability-relay"}[5m]) > bool 0) > 0)
          or (max by (environment, node) (increase(vm_persistentqueue_blocks_dropped_total{job!="observability-relay"}[5m]) > bool 0) > 0)
          or (max by (environment, node) (increase(vm_rows_ignored_total{job!="observability-relay"}[5m]) > bool 0) > 0)
        for: 0s
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: observability-agent}
        annotations: {incident_family: observability-delivery-loss, evidence_class: samples-or-blocks-discarded, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Telemetry was discarded; monitoring history is incomplete and VPN reachability is unknown., runbook: docs/how-to/monitoring-alerts.md#observability-delivery-loss, action: "Run make observability-status. Check the sender queue and collector disk. History has a gap for this period."}
      - alert: ObservabilityCollectorRelayDeliveryLoss
        expr: >-
          (max(increase(vmagent_remotewrite_packets_dropped_total{job="observability-relay"}[5m]) > bool 0) > 0)
          or (max(increase(vmagent_remotewrite_samples_dropped_total{job="observability-relay"}[5m]) > bool 0) > 0)
        for: 0s
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: "{{ policy.warning_severity }}"
          component: observability-relay
          environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}"
          node: collector
        annotations: {incident_family: observability-delivery-loss, evidence_class: relay-accepted-samples-discarded, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: The collector relay discarded accepted telemetry; monitoring history is incomplete., runbook: docs/how-to/monitoring-alerts.md#observability-delivery-loss, action: "Run make observability-status. Check the sender queue and collector disk. History has a gap for this period."}
  - name: observability_node_resource_service
    rules:
      - alert: ObservabilityNodeCpuPressure
        expr: >-
          (sum by (environment, node) (rate(node_cpu_seconds_total{mode!="idle"}[5m]))
          / sum by (environment, node) (rate(node_cpu_seconds_total[5m]))) > {{ policy.cpu_warning_ratio }}
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-resource}
        annotations: {incident_family: node-cpu, evidence_class: sustained-cpu-pressure, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Node CPU use is above the warning threshold., runbook: docs/how-to/monitoring-alerts.md#node-cpu, action: "Find the top process on the node. If a VPN service is the cause and load stays high, move clients or add capacity.", value: '{% raw %}{{ $value | humanizePercentage }} used{% endraw %}'}
      - alert: ObservabilityNodeMemoryPressure
        expr: >-
          (1 - (max by (environment, node) (node_memory_MemAvailable_bytes)
          / max by (environment, node) (node_memory_MemTotal_bytes))) > {{ policy.memory_warning_ratio }}
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-resource}
        annotations: {incident_family: node-memory, evidence_class: memory-available-low, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Node available memory is low., runbook: docs/how-to/monitoring-alerts.md#node-memory, action: "Find the largest process on the node. Low memory can cause out-of-memory kills of VPN services.", value: '{% raw %}{{ $value | humanizePercentage }} used{% endraw %}'}
      - alert: ObservabilityNodeSwapPressure
        expr: >-
          max by (environment, node) (node_memory_SwapTotal_bytes) > 0
          and on (environment, node)
          ((max by (environment, node) (node_memory_SwapTotal_bytes)
          - max by (environment, node) (node_memory_SwapFree_bytes))
          / max by (environment, node) (node_memory_SwapTotal_bytes)) > {{ policy.swap_warning_ratio }}
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-resource}
        annotations: {incident_family: node-swap, evidence_class: sustained-swap-pressure, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Node swap use is high., runbook: docs/how-to/monitoring-alerts.md#node-swap, action: "Find the process that uses the memory. Sustained swap use slows tunnels."}
      - alert: ObservabilityNodeDiskSpaceLow
        expr: >-
          min by (environment, node) (node_filesystem_avail_bytes{mountpoint="{{ policy.filesystem_mountpoint }}"} / node_filesystem_size_bytes{mountpoint="{{ policy.filesystem_mountpoint }}"}) < {{ policy.disk_warning_ratio }}
          and on (environment, node)
          max by (environment, node) (node_filesystem_readonly{mountpoint="{{ policy.filesystem_mountpoint }}"}) == 0
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-filesystem}
        annotations: {incident_family: node-disk, evidence_class: disk-available-low, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem free space is low., runbook: docs/how-to/monitoring-alerts.md#node-disk, action: "Free space on the root filesystem. Check the journal, the metrics queue and old releases.", value: '{% raw %}{{ $value | humanizePercentage }} free{% endraw %}'}
      - alert: ObservabilityNodeDiskSpaceCritical
        expr: >-
          min by (environment, node) (node_filesystem_avail_bytes{mountpoint="{{ policy.filesystem_mountpoint }}"} / node_filesystem_size_bytes{mountpoint="{{ policy.filesystem_mountpoint }}"}) < {{ policy.disk_critical_ratio }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: node-filesystem}
        annotations: {incident_family: node-disk, evidence_class: disk-available-critical, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem free space is critically low., runbook: docs/how-to/monitoring-alerts.md#node-disk, action: "Free space on the root filesystem. Check the journal, the metrics queue and old releases.", value: '{% raw %}{{ $value | humanizePercentage }} free{% endraw %}'}
      - alert: ObservabilityNodeInodesLow
        expr: >-
          min by (environment, node) (node_filesystem_files_free{mountpoint="{{ policy.filesystem_mountpoint }}"} / node_filesystem_files{mountpoint="{{ policy.filesystem_mountpoint }}"}) < {{ policy.inode_warning_ratio }}
        for: {{ policy.resource_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-filesystem}
        annotations: {incident_family: node-inodes, evidence_class: inode-available-low, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem free inodes are low., runbook: docs/how-to/monitoring-alerts.md#node-inodes, action: "Find the directory with the most files on the root filesystem and remove stale files.", value: '{% raw %}{{ $value | humanizePercentage }} free{% endraw %}'}
      - alert: ObservabilityNodeInodesCritical
        expr: >-
          min by (environment, node) (node_filesystem_files_free{mountpoint="{{ policy.filesystem_mountpoint }}"} / node_filesystem_files{mountpoint="{{ policy.filesystem_mountpoint }}"}) < {{ policy.inode_critical_ratio }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: node-filesystem}
        annotations: {incident_family: node-inodes, evidence_class: inode-available-critical, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Root filesystem free inodes are critically low., runbook: docs/how-to/monitoring-alerts.md#node-inodes, action: "Find the directory with the most files on the root filesystem and remove stale files.", value: '{% raw %}{{ $value | humanizePercentage }} free{% endraw %}'}
      - alert: ObservabilityRequiredServiceNotActive
        expr: >-
          max by (environment, node, role) (
            label_replace(node_systemd_unit_state{name=~"^({% for unit in policy.required_systemd_units %}{{ unit | replace('.', '[.]') }}{% if not loop.last %}|{% endif %}{% endfor %})$",state="active"} == 0, "role", "$1", "name", "^(.*)[.]service$")
            or label_replace(node_systemd_unit_state{state="failed"} == 1, "role", "$1", "name", "^(.*)[.]service$"))
          and on (environment, node, role) (vpn_observability_required_service == 1)
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: service}
        annotations: {incident_family: required-service, evidence_class: observed-service-not-active, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Fresh node telemetry reports a required systemd service is not active., runbook: docs/how-to/monitoring-alerts.md#required-service, action: "Read systemctl status and the journal for the named service. If the fault stays, redeploy or replace the node."}
      - alert: ObservabilityRequiredServiceEvidenceMissing
        expr: >-
          (vpn_observability_required_service == 1)
          unless on (environment, node, role)
          max by (environment, node, role) (label_replace(node_systemd_unit_state{state="active"}, "role", "$1", "name", "^(.*)[.]service$"))
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: service}
        annotations: {incident_family: required-service-evidence, evidence_class: service-evidence-absent, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A profile-required service has no systemd evidence; its health is unknown., runbook: docs/how-to/monitoring-alerts.md#required-service-evidence, action: "Service health is unknown. Run make verify for this node, then check the node exporter systemd collector."}
      - alert: ObservabilityNodeClockSkew
        expr: max by (environment, node) (abs(node_time_seconds - time())) > {{ policy.clock_skew_seconds }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-clock}
        annotations: {incident_family: node-clock, evidence_class: wall-clock-skew, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Node wall clock differs from control-plane evaluation time., runbook: docs/how-to/monitoring-alerts.md#node-clock, action: "Check time synchronization on the node with timedatectl.", value: '{% raw %}{{ $value | humanizeDuration }} skew{% endraw %}'}
      - alert: ObservabilityCertificateExpiresSoon
        expr: min by (environment, node, role) (vpn_certificate_not_after_timestamp_seconds - time()) < {{ policy.certificate_warning_seconds }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: certificate}
        annotations: {incident_family: certificate-expiry, evidence_class: certificate-expiry-warning, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A managed certificate expires soon., runbook: docs/how-to/monitoring-alerts.md#certificate-expiry, action: "Renew the certificate named by role. Use make check-certs for transport certificates and make observability-rotate for observability-sender.", value: '{% raw %}{{ $value | humanizeDuration }} to expiry{% endraw %}'}
      - alert: ObservabilityCertificateCollectionFailed
        expr: min by (environment, node, role) (vpn_certificate_collection_success) == 0
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: certificate}
        annotations: {incident_family: certificate-health, evidence_class: collection-failed, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Managed certificate expiry collection failed., runbook: docs/how-to/monitoring-alerts.md#certificate-health, action: "Expiry data is missing. Read the journal of observability-agent-health-adapter.service on this node."}
      - alert: ObservabilityCertificateExpiresCritical
        expr: min by (environment, node, role) (vpn_certificate_not_after_timestamp_seconds - time()) < {{ policy.certificate_critical_seconds }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: certificate}
        annotations: {incident_family: certificate-expiry, evidence_class: certificate-expiry-critical, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A managed certificate is close to expiry., runbook: docs/how-to/monitoring-alerts.md#certificate-expiry, action: "Renew the certificate named by role. Use make check-certs for transport certificates and make observability-rotate for observability-sender.", value: '{% raw %}{{ $value | humanizeDuration }} to expiry{% endraw %}'}
      - alert: ObservabilityNodeNetworkErrors
        expr: >-
          sum by (environment, node) (rate(node_network_receive_errs_total{device!~"{{ policy.network_device_exclude_regex }}"}[5m]) + rate(node_network_transmit_errs_total{device!~"{{ policy.network_device_exclude_regex }}"}[5m])) > {{ policy.network_error_rate }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: node-network}
        annotations: {incident_family: node-network, evidence_class: sustained-interface-errors, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A node reports sustained interface errors., runbook: docs/how-to/monitoring-alerts.md#node-network, action: "Check interface counters on the node. If errors continue, contact the provider or replace the node."}
      - alert: ObservabilityNodeFilesystemReadOnly
        expr: max by (environment, node) (node_filesystem_readonly{mountpoint="{{ policy.filesystem_mountpoint }}"}) == 1
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.critical_severity }}", component: node-filesystem}
        annotations: {incident_family: node-filesystem, evidence_class: root-filesystem-read-only, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: The root filesystem is read only., runbook: docs/how-to/monitoring-alerts.md#node-filesystem, action: "Do not repair in place. Replace the node with the recreation procedure."}
      - alert: ObservabilityServiceRestartLoop
        expr: max by (environment, node) (vpn_watchdog_restart_attempts) >= {{ policy.restart_attempts }}
        for: {{ policy.critical_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: service}
        annotations: {incident_family: service-restart-loop, evidence_class: bounded-restart-limit, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: The watchdog reached its hourly restart limit on this node., runbook: docs/how-to/monitoring-alerts.md#service-restart-loop, action: "Read the watchdog journal on the node to see which services restarted and why."}
  - name: observability_security_detectors
    rules:
      - alert: ObservabilityDetectorCollectionFailed
        expr: >-
          max by (environment, node) (vpn_honeypot_collection_success) == 0
          or max by (environment, node) (vpn_policy_ratelimit_collection_success) == 0
          or max by (environment, node) (vpn_xray_stats_collection_success) == 0
          or max by (environment, node) (vpn_burn_run_error) == 1
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-health, evidence_class: collection-failed, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security detector failed to collect data., runbook: docs/how-to/monitoring-alerts.md#detector-health, action: "Find which detector metric failed, then read the journal of that unit on the node."}
      - alert: ObservabilityDetectorEvidenceStale
        expr: >-
          max by (environment, node) (time() - vpn_honeypot_last_success_timestamp_seconds) > {{ policy.detector_stale_seconds }}
          or max by (environment, node) (time() - vpn_policy_ratelimit_last_success_timestamp_seconds) > {{ policy.detector_stale_seconds }}
          or max by (environment, node) (time() - vpn_xray_stats_collected_timestamp_seconds) > {{ policy.detector_stale_seconds }}
          or max by (environment, node) (time() - vpn_burn_last_run_unixtime) > {{ policy.burn_stale_seconds }}
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-health, evidence_class: evidence-stale, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security detector stopped updating its results., runbook: docs/how-to/monitoring-alerts.md#detector-health, action: "Find which detector metric failed, then read the journal of that unit on the node."}
      - alert: ObservabilityDetectorInputStalled
        expr: >-
          max by (environment, node) (vpn_policy_ratelimit_dead_contract) == 1
          and on (environment, node)
          max by (environment, node) (vpn_policy_ratelimit_input_progress_total) > 0
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-input, evidence_class: input-contract-stalled, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Detector input matches no known policy event., runbook: docs/how-to/monitoring-alerts.md#detector-input, action: "Read the policy-ratelimit journal on the node and check for a log format change after a release."}
      - alert: ObservabilityDetectorError
        expr: >-
          sum by (environment, node) (increase(vpn_honeypot_input_errors_total[{{ policy.detector_hold }}])) > 0
          or sum by (environment, node) (increase(vpn_policy_ratelimit_input_errors_total[{{ policy.detector_hold }}])) > 0
          or max by (environment, node) (vpn_burn_api_error) == 1
        for: 0m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-error, evidence_class: bounded-producer-error, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security detector reports input errors., runbook: docs/how-to/monitoring-alerts.md#detector-error, action: "Find which detector metric reports errors, then read the journal of that unit on the node."}
      - alert: ObservabilityDetectorEventThreshold
        expr: >-
          max by (environment, node) (vpn_honeypot_events_60min) > {{ policy.honeypot_events_60min }}
          or sum by (environment, node) (increase(vpn_policy_ratelimit_events_total[5m])) > {{ policy.policy_events_5min }}
          or max by (environment, node) (vpn_burn_failed_nodes) > 0
        for: {{ policy.detector_hold }}
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: "{{ policy.warning_severity }}", component: detector}
        annotations: {incident_family: detector-events, evidence_class: event-threshold, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A security or reachability detector crossed its event threshold., runbook: docs/how-to/monitoring-alerts.md#detector-events, action: "For probing events run make probing-summary with IP of this node. For burn failures run make burn-check. Then use the incident matrix."}
  - name: observability_producer_deadlines
    rules:
{% for node in observability_push.expected_nodes %}
      - alert: ObservabilityAdapterCompletionMissing
        expr: >-
          max by (node) (absent(vpn_observability_evidence_timestamp_seconds{node="{{ node }}",role="health-adapter"})
          or absent(vpn_observability_adapter_collected_timestamp_seconds{node="{{ node }}"}))
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: warning, component: producer-evidence, node: "{{ node }}", environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}"}
        annotations: {incident_family: producer-evidence, evidence_class: required-adapter-never-published, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: A required node adapter never published; monitoring health is unknown., runbook: docs/how-to/monitoring-alerts.md#producer-evidence, action: "Monitoring data is unknown here. Run make observability-status and check the agent units on the node."}
{% endfor %}
{% for adapter in [{'node': 'observability-control-plane', 'role': 'control-plane-adapter', 'enabled': (observability_control_plane.expected_targets | default({})).enabled | default(false)}, {'node': 'protocol-liveness', 'role': 'liveness-published-evidence', 'enabled': (observability_control_plane.protocol_liveness | default({})).enabled | default(false)}] if adapter.enabled %}
      - alert: ObservabilityOptionalAdapterCompletionMissing
        # The ingress relay sets node to the collector identity, so only the role names an adapter.
        expr: absent(vpn_observability_evidence_timestamp_seconds{role="{{ adapter.role }}"})
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: warning, component: producer-evidence, node: "{{ adapter.node }}", role: "{{ adapter.role }}", environment: "{{ observability_control_plane.alerting.silence_gateway.environment }}"}
        annotations: {incident_family: producer-evidence, evidence_class: enabled-adapter-never-published, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: An enabled collector adapter never published; monitoring health is unknown., runbook: docs/how-to/monitoring-alerts.md#producer-evidence, action: "Monitoring data is unknown here. Run make observability-status and check the agent units on the node."}
{% endfor %}
      - alert: ObservabilityProducerEvidenceUnavailable
        expr: >-
          (time() - vpn_observability_evidence_timestamp_seconds > on (environment, node, role) vpn_observability_evidence_max_age_seconds)
          or (vpn_observability_evidence_timestamp_seconds > time() + 30)
          or (vpn_observability_evidence_max_age_seconds unless on (environment, node, role) vpn_observability_evidence_timestamp_seconds)
          or (vpn_observability_evidence_timestamp_seconds unless on (environment, node, role) vpn_observability_evidence_max_age_seconds)
          or (vpn_observability_evidence_max_age_seconds <= 0)
          or (vpn_observability_evidence_max_age_seconds > 4492800)
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: warning, component: producer-evidence}
        annotations: {incident_family: producer-evidence, evidence_class: stale-future-or-incomplete-deadline, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: Monitoring evidence expired or has an invalid deadline; health is unknown., runbook: docs/how-to/monitoring-alerts.md#producer-evidence, action: "Monitoring data is unknown here. Run make observability-status and check the agent units on the node."}
      - alert: ObservabilityManifestAdapterStalled
        expr: >-
          (time() - vpn_observability_adapter_collected_timestamp_seconds > 180)
          or (vpn_observability_adapter_collected_timestamp_seconds > time() + 30)
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels: {severity: warning, component: producer-evidence}
        annotations: {incident_family: producer-evidence, evidence_class: manifest-adapter-stalled, source_generation: "{{ observability_control_plane.alerting.source_generation }}", summary: The node manifest adapter is stale or reports a future time., runbook: docs/how-to/monitoring-alerts.md#producer-evidence, action: "Monitoring data is unknown here. Run make observability-status and check the agent units on the node."}
  - name: observability_watchdog_backup
    rules:
      - alert: ObservabilityWatchdogEvidenceStale
        expr: >-
          (vpn_watchdog_collection_success == 0)
          or on (node, role)
          (vpn_watchdog_freshness_state{state="stale"} == 1)
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: warning
          component: watchdog
        annotations:
          incident_family: watchdog-evidence
          evidence_class: stale-or-unknown
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Watchdog evidence is missing or stale.
          runbook: docs/how-to/monitoring-alerts.md#watchdog-evidence
          action: "Check the watchdog timer and journal on the node."
      - alert: ObservabilityWatchdogRecoveryUnresolved
        expr: vpn_watchdog_recovery_outcome{state="unresolved"} == 1
        for: 2m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: warning
          component: watchdog
        annotations:
          incident_family: watchdog-recovery
          evidence_class: local-recovery-unresolved
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Local watchdog recovery did not restore the service.
          runbook: docs/how-to/monitoring-alerts.md#watchdog-recovery
          action: "Run make verify for this node, then decide to repair or replace it."
      - alert: ObservabilityBackupEvidenceStale
        expr: >-
          (vpn_backup_collection_success == 0)
          or on (node, role)
          (vpn_backup_freshness_state{state="stale"} == 1)
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: warning
          component: backup
        annotations:
          incident_family: backup-evidence
          evidence_class: stale-or-unknown
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: Backup evidence is missing or stale.
          runbook: docs/how-to/monitoring-alerts.md#backup-evidence
          action: "Check the backup timer and journal on the node."
      - alert: ObservabilityBackupStageFailed
        expr: vpn_backup_result{state="failed"} == 1
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: critical
          component: backup
        annotations:
          incident_family: backup-stage
          evidence_class: confirmed-stage-failure
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: A backup stage failed.
          runbook: docs/how-to/monitoring-alerts.md#backup-stage
          action: "Read the backup unit journal on the node and repair the failed stage before the next run."
      - alert: ObservabilityRestoreReadinessStale
        expr: vpn_backup_freshness_state{role="restore-drill",state="stale"} == 1
        for: 3m
        keep_firing_for: {{ observability_control_plane.alerting.recovery_stability }}
        labels:
          severity: warning
          component: backup
        annotations:
          incident_family: restore-readiness
          evidence_class: stale-restore-proof
          source_generation: "{{ observability_control_plane.alerting.source_generation }}"
          summary: The restore drill result is stale.
          runbook: docs/how-to/monitoring-alerts.md#restore-readiness
          action: "Check the restore drill timer and journal on the node."
