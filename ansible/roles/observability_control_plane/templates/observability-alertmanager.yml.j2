global:
  resolve_timeout: {{ observability_control_plane.alerting.recovery_stability }}
route:
  receiver: telegram-primary
  group_by: [alertname, environment, node, component, policy, profile, vantage, severity]
  group_wait: {{ observability_control_plane.alerting.group_wait }}
  group_interval: {{ observability_control_plane.alerting.group_interval }}
  repeat_interval: {{ observability_control_plane.alerting.warning_repeat_interval }}
  routes:
    - receiver: telegram-critical
      matchers: ['severity="critical"']
      repeat_interval: {{ observability_control_plane.alerting.critical_repeat_interval }}
    - receiver: telegram-primary
      matchers: ['severity="warning"']
      repeat_interval: {{ observability_control_plane.alerting.warning_repeat_interval }}
{% if observability_control_plane.alerting.deadman.enabled %}
    - receiver: deadman-canary
      matchers: ['alertname="ObservabilityPipelineWatchdog"']
      repeat_interval: {{ observability_control_plane.alerting.deadman.repeat_interval }}
      continue: false
{% endif %}
receivers:
  - name: telegram-primary
    webhook_configs:
      - url: {{ observability_control_plane.alerting.telegram.relay_url | default('http://127.0.0.1:19095/alert') }}
        send_resolved: true
        max_alerts: {{ observability_control_plane.alerting.telegram.max_alerts | int }}
        timeout: {{ observability_control_plane.alerting.telegram.webhook_timeout | default('20s') }}
        http_config:
          authorization:
            type: Bearer
            credentials_file: {{ observability_control_plane.alerting.telegram.relay_auth_credential | default('/run/credentials/observability-alertmanager.service/telegram-relay-auth-token') }}
  - name: telegram-critical
    webhook_configs:
      - url: {{ observability_control_plane.alerting.telegram.relay_url | default('http://127.0.0.1:19095/alert') }}
        send_resolved: true
        max_alerts: {{ observability_control_plane.alerting.telegram.max_alerts | int }}
        timeout: {{ observability_control_plane.alerting.telegram.webhook_timeout | default('20s') }}
        http_config:
          authorization:
            type: Bearer
            credentials_file: {{ observability_control_plane.alerting.telegram.relay_auth_credential | default('/run/credentials/observability-alertmanager.service/telegram-relay-auth-token') }}
{% if observability_control_plane.alerting.deadman.enabled %}
  - name: deadman-canary
    webhook_configs:
      - url: {{ observability_control_plane.alerting.deadman.receiver_url }}
        send_resolved: true
        max_alerts: 1
        timeout: 5s
{% endif %}
inhibit_rules:
  - source_matchers: ['alertname="ObservabilityBackupStageFailed"']
    target_matchers: ['alertname="ObservabilityBackupEvidenceStale"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityNodeDiskSpaceCritical"']
    target_matchers: ['alertname="ObservabilityNodeDiskSpaceLow"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityNodeInodesCritical"']
    target_matchers: ['alertname="ObservabilityNodeInodesLow"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityCertificateExpiresCritical"']
    target_matchers: ['alertname="ObservabilityCertificateExpiresSoon"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityDetectorEvidenceStale"']
    target_matchers: ['alertname="ObservabilityDetectorInputStalled"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityDetectorCollectionFailed"']
    target_matchers: ['alertname="ObservabilityDetectorEvidenceStale"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityDetectorCollectionFailed"']
    target_matchers: ['alertname="ObservabilityDetectorInputStalled"']
    equal: [environment, node, component]
