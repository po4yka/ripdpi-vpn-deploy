[Unit]
Description=Publish a short-lived authenticated observability pipeline pulse
After=observability-deadman-pipeline.service observability-alertmanager.service observability-prometheus.service
Requires=observability-deadman-pipeline.service observability-alertmanager.service observability-prometheus.service

[Service]
Type=oneshot
User=root
Group=root
LoadCredential=pulse-token:{{ observability_control_plane.alerting.deadman.pulse_credential_path }}
LoadCredential=deadman-pulse-ca.pem:{{ observability_control_plane.alerting.deadman.pulse_ca_path }}
ExecStart=/usr/local/libexec/observability-deadman-pipeline.py publish-pulse --state-dir {{ observability_control_plane.alerting.deadman.state_dir }} --primary-status {{ observability_control_plane.alerting.deadman.state_dir }}/primary-canary.json --deadman-url {{ observability_control_plane.alerting.deadman.pulse_url }} --generation {{ observability_control_plane.alerting.source_generation }} --freshness-seconds {{ observability_control_plane.alerting.deadman.freshness_seconds | int }} --primary-freshness-seconds {{ observability_control_plane.alerting.deadman.primary_canary_freshness_seconds | int }} --timeout-seconds {{ observability_control_plane.alerting.deadman.request_timeout_seconds | int }} --prometheus-ready http://127.0.0.1:9090/-/ready --alertmanager-ready http://127.0.0.1:19094/-/ready --pulse-credential pulse-token --pulse-ca-credential deadman-pulse-ca.pem
TimeoutStartSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths={{ observability_control_plane.alerting.deadman.state_dir }}
ReadOnlyPaths=/usr/local/libexec/observability-deadman-pipeline.py
MemoryMax=64M
TasksMax=16
LimitNOFILE=1024
