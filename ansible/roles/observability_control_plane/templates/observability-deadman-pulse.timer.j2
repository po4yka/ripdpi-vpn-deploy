[Unit]
Description=Schedule the independent observability pipeline pulse

[Timer]
OnBootSec=60s
OnUnitActiveSec={{ observability_control_plane.alerting.deadman.pulse_interval_seconds }}s
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=observability-deadman-pulse.service

[Install]
WantedBy=timers.target
