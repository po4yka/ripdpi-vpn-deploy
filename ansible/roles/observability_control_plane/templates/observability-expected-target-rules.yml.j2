groups:
  - name: observability_expected_targets
    rules:
{% for target in observability_control_plane.expected_targets.inventory.targets | default([]) if target.lifecycle == 'enabled' %}
{% for family in target.required_families %}
      - alert: ObservabilityRequiredFamilyMissing_{{ target.target | replace('-', '_') }}_{{ target.role | replace('-', '_') }}_{{ family | replace(':', '_') }}
        expr: >-
          (vpn_observability_expected_target{node="{{ target.target }}",role="{{ target.role }}"} == 1)
          unless on (node, role)
          {{ family }}{node=~"^({{ target.label_values.node | join('|') }})$",role=~"^({{ target.label_values.role | join('|') }})$"{% for label, values in target.label_values | dictsort if label not in ['node', 'role'] %},{{ label }}=~"^({{ values | join('|') }})$"{% endfor %}}
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: Required bounded evidence family is absent for an expected target.
{% endfor %}
      - alert: ObservabilityExpectedTargetNeverSeen_{{ target.target | replace('-', '_') }}_{{ target.role | replace('-', '_') }}
        expr: vpn_observability_expected_target_ever_seen{node="{{ target.target }}",role="{{ target.role }}",state="never-seen"} == 1
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: Expected target has never produced its required evidence.
{% endfor %}
      - alert: ObservabilityExpectedTargetMissing
        expr: >-
          vpn_observability_expected_target
          unless on (node, role)
          max by (node, role) (vpn_observability_evidence_state)
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: Expected observability target has no evidence state.
      - alert: ObservabilityTargetEvidenceStale
        expr: vpn_observability_evidence_state{state="stale"} == 1
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: Observability target evidence is stale.
      - alert: ObservabilitySourceIdentityMismatch
        expr: >-
          (vpn_observability_node_manifest_identity{state="mismatch"} == 1)
          or
          (vpn_observability_evidence_state{node="observability-control-plane",role=~"source-revision|deployable-digest",state="mismatch"} == 1)
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: Node source or deployable identity differs from the expected candidate.
      - alert: ObservabilityControlPlaneResourceOrPipelineUnhealthy
        expr: >-
          vpn_observability_evidence_state{node="observability-control-plane",role=~"tsdb-capacity|expected-target-pipeline",state!="fresh"} == 1
        for: 3m
        labels:
          severity: warning
        annotations:
          summary: Control-plane capacity or expected-target pipeline is unhealthy.
