daemon off;
worker_processes 1;
pid /run/observability-ingress/nginx.pid;
error_log /dev/null crit;
events { worker_connections 64; }
http {
    access_log off;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 10s;
    client_body_temp_path /run/observability-ingress/body;
    proxy_temp_path /run/observability-ingress/proxy;
    fastcgi_temp_path /run/observability-ingress/fastcgi;
    uwsgi_temp_path /run/observability-ingress/uwsgi;
    scgi_temp_path /run/observability-ingress/scgi;
{% include 'observability-remote-write.conf.j2' %}
}
