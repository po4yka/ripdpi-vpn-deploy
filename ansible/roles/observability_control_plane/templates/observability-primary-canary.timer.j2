[Unit]
Description=Schedule a low-frequency primary Telegram canary

[Timer]
OnBootSec=30s
OnUnitActiveSec={{ observability_control_plane.alerting.deadman.primary_canary_interval_seconds }}s
AccuracySec=1m
RandomizedDelaySec=0
Persistent=true
Unit=observability-primary-canary.service

[Install]
WantedBy=timers.target
