global:
  scrape_interval: 30s
  external_labels:
    component: observability-control-plane

{% if (observability_control_plane.expected_targets | default({'enabled': false}, true)).enabled | default(false) %}
rule_files:
  - {{ observability_control_plane.config_root }}/generations/{{ _observability_rules_generation }}.rules.yml
{% endif %}

scrape_configs:
  - job_name: observability-control-plane
    static_configs:
      - targets: ['127.0.0.1:9100']
