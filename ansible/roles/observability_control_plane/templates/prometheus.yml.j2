global:
  scrape_interval: 60s
  external_labels:
    component: observability-control-plane

storage:
  tsdb:
    out_of_order_time_window: {{ observability_control_plane.tsdb_retention_time | default('7d') }}

{% if (observability_control_plane.expected_targets | default({'enabled': false}, true)).enabled | default(false) or (observability_control_plane.alerting | default({'enabled': false}, true)).enabled | default(false) %}
rule_files:
{% if (observability_control_plane.expected_targets | default({'enabled': false}, true)).enabled | default(false) %}
  - {{ observability_control_plane.config_root }}/generations/{{ _observability_rules_generation }}.rules.yml
{% endif %}
{% if (observability_control_plane.alerting | default({'enabled': false}, true)).enabled | default(false) %}
  - {{ observability_control_plane.config_root }}/generations/alerts-{{ _observability_alert_rules_generation }}.rules.yml
{% endif %}
{% endif %}

{% if (observability_control_plane.alerting | default({'enabled': false}, true)).enabled | default(false) %}
alerting:
  alertmanagers:
    - authorization:
        type: Bearer
        credentials_file: /run/credentials/observability-prometheus.service/silence-sender-token
      static_configs:
        - targets: ['127.0.0.1:19094']
{% endif %}

scrape_configs:
{% if (observability_control_plane.alerting | default({'enabled': false}, true)).enabled | default(false) %}
  - job_name: observability-relay
    sample_limit: 50
    label_limit: 16
    label_name_length_limit: 64
    label_value_length_limit: 128
    static_configs:
      - targets: ['{{ observability_control_plane.relay_listen }}']
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: "^vmagent_remotewrite_(packets_dropped_total|samples_dropped_total|errors_total|retries_count_total)$"
        action: keep
      - regex: "^(__name__|job)$"
        action: labelkeep
  - job_name: observability-alertmanager
    sample_limit: 500
    label_limit: 16
    label_name_length_limit: 64
    label_value_length_limit: 128
    authorization:
      type: Bearer
      credentials_file: /run/credentials/observability-prometheus.service/silence-sender-token
    static_configs:
      - targets: ['127.0.0.1:19094']
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: "^alertmanager_notifications_(total|failed_total)$"
        action: keep
      - regex: "^(__name__|job|integration)$"
        action: labelkeep
{% else %}
  []
{% endif -%}
