[Unit]
Description=Independent observability dead-man pulse receiver
After=network-online.target
Wants=network-online.target

[Service]
User={{ observability_deadman.service_user }}
Group={{ observability_deadman.service_group }}
LoadCredential=pulse-token:{{ observability_deadman.pulse_credential_path }}
LoadCredential=telegram-bot-token:{{ observability_deadman.telegram_credential_path }}
LoadCredential=pulse-server-cert:{{ observability_deadman.config_root }}/credentials/pulse-server.crt
LoadCredential=pulse-server-key:{{ observability_deadman.config_root }}/credentials/pulse-server.key
ExecStart=/usr/local/libexec/observability-deadman.py serve --config {{ observability_deadman.config_root }}/deadman-current.json --state {{ observability_deadman.state_dir }}/state.json --listen {{ observability_deadman.pulse_listen }} --status-listen {{ observability_deadman.status_listen }}
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths={{ observability_deadman.state_dir }}
ReadOnlyPaths={{ observability_deadman.config_root }} /usr/local/libexec/observability-deadman.py
MemoryMax=64M
TasksMax=32
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
