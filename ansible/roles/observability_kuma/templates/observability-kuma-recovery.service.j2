[Unit]
Description=Download and verify the encrypted observer backup and SQLite
After=network-online.target observability-kuma-backup.service
Wants=network-online.target

[Service]
Type=oneshot
# This job reads only its own private backups and isolated restore workspace.
User=root
LoadCredential=storage:/etc/observability-kuma/recovery-storage.json
LoadCredential=age-identity:/etc/observability-kuma/recovery-age-identity
ExecStart=/usr/bin/python3 /usr/local/libexec/observability-kuma-recovery.py verify
ExecStopPost=/usr/bin/python3 /usr/local/libexec/observability-kuma-recovery.py finalize
TimeoutStartSec=600
TimeoutStopSec=60
KillMode=control-group
MemoryMax=128M
CPUQuota=25%
IOWeight=10
TasksMax=32
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/observability-kuma-restores/scheduled /var/lib/observability-kuma-recovery-health
