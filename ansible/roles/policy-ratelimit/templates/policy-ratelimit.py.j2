#!/usr/bin/env python3
"""Policy-violation rate-limiter daemon (NOT a probe defence — see README ADR).

Tails the Xray access log and bans source IPs that repeatedly have their
traffic routed to the blackhole outbound (tag `block`) or rejected at the
VLESS protocol layer. Offenders are added to the nftables set
`inet filter policy_offenders` with a BAN_SECONDS timeout; nftables already
has an early-drop rule for that set.

WHAT THIS DOES AND DOES NOT SEE
-------------------------------
This daemon does NOT — and by design CANNOT — see external active-probing
of the REALITY listener. When a prober's ClientHello fails REALITY
authentication, `xtls/reality`'s `func Server` (vendored at 9234c772ba8f by
the pinned Xray-core v26.3.27) does not reject: it dials the camouflage
`Dest` ("steal-oneself") and io.Copy-proxies the prober to the donor site.
The only per-IP trace is a returned `fmt.Errorf("REALITY: processed invalid
connection from <ip>: ...")`, logged by Xray's inbound worker at [Info] to
the *error* log. That path:
  * writes to error.log, not the access.log this daemon tails;
  * is suppressed entirely at the pinned `loglevel: "warning"`;
  * carries no REJECT/rejected/graylist token.
(The verbose per-IP REALITY trace is fmt.Printf gated behind `config.Show`,
off in production.) Surfacing probers would require bumping the error log to
`info`, which dumps every client's connection metadata (destinations,
sniffed SNIs) into a persistent corpus — rejected under the RU/TSPU threat
model. So prober IPs are intentionally unobservable here; external probing is
mitigated at other layers (REALITY camouflage, firewall scanner-ASN denylist,
honeypot, non-443 fallback), not by this daemon.

What it DOES enforce is real and access-log-visible regardless of loglevel
(access messages bypass severity filtering — app/log/log.go): authenticated
clients whose traffic is sent to the `block` outbound by the routing rules
(BitTorrent, QUIC/UDP-443, RFC1918 destinations) or rejected at the VLESS
layer. A source that trips these repeatedly is leaking a DPI-visible
fingerprint or scanning; rate-limiting it protects the node.

The Xray access-log line for a blackholed connection looks like:
  2026/06/11 10:15:42.123456 from tcp:203.0.113.55:51999 accepted \
    udp:142.250.1.1:443 [vless-reality -> block] email: <client>
The detour separator varies by routing path (`->`, `>>`, `==>`,
app/dispatcher/default.go); BLOCK_RE matches the `block` tag regardless.

Pinned against Xray-core v26.3.27. See README.md for the full rationale.

Managed by Ansible role policy-ratelimit; do not hand-edit.
"""
from __future__ import annotations

import collections
import ipaddress
import logging
import os
import secrets
import stat
import pathlib
import re
import subprocess
import sys
import time

XRAY_LOG = pathlib.Path("/var/log/xray/access.log")
REJECTS_PER_WINDOW = {{ policy_ratelimit.rejects_per_window | default(5) }}
WINDOW_SECONDS = {{ policy_ratelimit.window_seconds | default(60) }}
BAN_SECONDS = {{ policy_ratelimit.ban_seconds | default(300) }}
TEXTFILE_DIR = pathlib.Path("{{ policy_ratelimit.textfile_dir | default('/var/lib/node_exporter/textfile') }}")
# After this many tailed lines with zero matched events, flip the
# dead-contract gauge so a broken token/sink contract is observable
# instead of looking like "the cohort is quiet".
DEAD_CONTRACT_MIN_LINES = {{ policy_ratelimit.dead_contract_min_lines | default(5000) }}

MAX_SOURCES = {{ policy_ratelimit.max_sources | default(4096) }}

IP_RE = re.compile(r"(?:\bfrom\s+)?(?:tcp|udp):([0-9A-Fa-f:.]+):\d+")
# A connection routed to the blackhole outbound: "[<inbound> <sep> block]".
# Separator is one of " -> ", " >> ", " ==> " (app/dispatcher/default.go),
# so match the bracketed detour ending in the `block` tag, separator-agnostic.
BLOCK_RE = re.compile(r"\[[^\]]*\bblock\]")
# A VLESS-layer rejection: access status word "rejected" (common/log/access.go
# AccessRejected). Space-bounded to avoid matching it inside an email/host.
REJECT_RE = re.compile(r"(?:^| )rejected(?: |$)")

logging.basicConfig(
    format="policy-ratelimit[%(process)d]: %(levelname)s %(message)s",
    level=logging.INFO, stream=sys.stderr,
)


def classify_line(line: str) -> str | None:
    """Return the actionable event class for an access-log line, or None.

    "block"    — routed to the blackhole outbound (policy-blocked traffic).
    "rejected" — rejected at the VLESS protocol layer.
    None       — benign (e.g. "accepted ... [vless-reality -> direct]") or
                 anything else, including REALITY error-log noise that never
                 reaches this access-log sink.
    """
    if BLOCK_RE.search(line):
        return "block"
    if REJECT_RE.search(line):
        return "rejected"
    return None


def is_exempt_ip(ip: str) -> bool:
    """RFC1918 / loopback / null — never ban an internal address."""
    try:
        parsed = ipaddress.ip_address(ip)
        return parsed.is_loopback or parsed.is_unspecified or parsed.is_link_local or (parsed.version == 4 and (parsed in ipaddress.ip_network("10.0.0.0/8") or parsed in ipaddress.ip_network("172.16.0.0/12") or parsed in ipaddress.ip_network("192.168.0.0/16")))
    except ValueError:
        return True


class RateLimiter:
    """Pure decision core — no I/O, so it is unit-testable in isolation.

    Feed access-log lines via observe(); it returns the source IP to ban
    when that IP crosses REJECTS_PER_WINDOW actionable events inside
    WINDOW_SECONDS, else None. Counters (lines/events/bans) drive the
    Prometheus textfile and the dead-contract gauge.
    """

    def __init__(self, rejects_per_window: int, window_seconds: int,
                 ban_seconds: int, max_sources: int = MAX_SOURCES) -> None:
        self.rejects_per_window = rejects_per_window
        self.window_seconds = window_seconds
        self.ban_seconds = ban_seconds
        self.max_sources = max_sources
        self.history: collections.OrderedDict[str, collections.deque[float]] = collections.OrderedDict()
        self.capacity_drops = 0
        self.input_healthy = True
        self.lines = 0
        self.events = 0
        self.bans = 0
        self.errors = 0
        self.reported_errors = 0

    def expire(self, now: float) -> None:
        # Ordered by last observation, so idle expiry is bounded by expired sources.
        while self.history:
            ip, events = next(iter(self.history.items()))
            if events and now - events[-1] <= self.window_seconds:
                break
            del self.history[ip]

    def observe(self, line: str, now: float) -> str | None:
        """Process one line at logical time `now`. Returns IP to ban or None."""
        self.expire(now)
        self.lines += 1
        if classify_line(line) is None:
            return None
        m = IP_RE.search(line)
        if not m:
            return None
        ip = m.group(1)
        try:
            ipaddress.ip_address(ip)
        except ValueError:
            return None
        if is_exempt_ip(ip):
            return None
        self.events += 1
        if ip not in self.history:
            if len(self.history) >= self.max_sources:
                self.capacity_drops += 1
                self.errors += 1
                return None
            self.history[ip] = collections.deque(maxlen=max(self.rejects_per_window * 4, 4))
        dq = self.history[ip]
        self.history.move_to_end(ip)
        dq.append(now)
        while dq and now - dq[0] > self.window_seconds:
            dq.popleft()
        if len(dq) >= self.rejects_per_window:
            del self.history[ip]  # do not retain empty source keys
            self.bans += 1
            return ip
        return None

    def dead_contract(self, min_lines: int) -> bool:
        """True once we've tailed enough volume with zero matched events.

        Distinguishes "detector is broken / sink or token wrong" from
        "cohort is genuinely quiet". A 1 means *investigate*: either the
        contract regressed or this cohort never trips a blackhole route.
        """
        return self.lines >= min_lines and self.events == 0


def add_offender(ip: str, ban_seconds: int) -> bool:
    family_set = "policy_offenders6" if ipaddress.ip_address(ip).version == 6 else "policy_offenders"
    cmd = [
        "nft", "add", "element", "inet", "filter", family_set,
        "{", f"{ip} timeout {ban_seconds}s", "}",
    ]
    try:
        rc = subprocess.run(cmd, capture_output=True, timeout=5).returncode
    except (OSError, subprocess.TimeoutExpired):
        logging.warning("nft enforcement unavailable")
        return False
    if rc == 0:
        logging.info("policy ban applied for %ds", ban_seconds)
        return True
    else:
        logging.warning("nft enforcement failed (rc=%d)", rc)
        return False


def publish_metrics(content: str) -> None:
    """Replace our output without following shared-directory symlinks."""
    TEXTFILE_DIR.mkdir(parents=True, exist_ok=True)
    directory = os.open(TEXTFILE_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    temporary = ".policy-ratelimit-" + secrets.token_hex(16)
    descriptor = None
    try:
        metadata = os.fstat(directory)
        if metadata.st_uid not in (0, os.geteuid()) or (metadata.st_mode & 0o022 and not metadata.st_mode & stat.S_ISVTX):
            raise PermissionError("unsafe metric directory")
        try:
            target = os.stat("vpn_policy_ratelimit.prom", dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            target = None
        if target is not None and (not stat.S_ISREG(target.st_mode) or target.st_nlink != 1 or target.st_uid != os.geteuid()):
            raise PermissionError("unsafe metric output")
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640, dir_fd=directory)
        os.fchmod(descriptor, 0o640)
        with os.fdopen(descriptor, "w") as output:
            descriptor = None
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, "vpn_policy_ratelimit.prom", src_dir_fd=directory, dst_dir_fd=directory)
        os.fsync(directory)
    finally:
        if descriptor is not None:
            os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass
        os.close(directory)


def flush_textfile(limiter: RateLimiter) -> None:
    try:
        dead = 1 if limiter.dead_contract(DEAD_CONTRACT_MIN_LINES) else 0
        error_state = "error" if not limiter.input_healthy or limiter.errors > limiter.reported_errors else "ok"
        publish_metrics(
            f"vpn_policy_ratelimit_input_available {int(limiter.input_healthy)}\n"
            f"vpn_policy_ratelimit_tracked_sources {len(limiter.history)}\n"
            f"vpn_policy_ratelimit_capacity_drops_total {limiter.capacity_drops}\n"
            "# HELP vpn_policy_ratelimit_collection_success Whether the latest detector publication completed\n"
            "# TYPE vpn_policy_ratelimit_collection_success gauge\n"
            "vpn_policy_ratelimit_collection_success 1\n"
            "# HELP vpn_policy_ratelimit_last_success_timestamp_seconds Unix timestamp of the latest detector publication\n"
            "# TYPE vpn_policy_ratelimit_last_success_timestamp_seconds gauge\n"
            f"vpn_policy_ratelimit_last_success_timestamp_seconds {int(time.time())}\n"
            "# HELP vpn_policy_ratelimit_input_progress_total Access-log inputs consumed since service start\n"
            "# TYPE vpn_policy_ratelimit_input_progress_total counter\n"
            f"vpn_policy_ratelimit_input_progress_total {limiter.lines}\n"
            "# HELP vpn_policy_ratelimit_input_errors_total Bounded enforcement errors since service start\n"
            "# TYPE vpn_policy_ratelimit_input_errors_total counter\n"
            f"vpn_policy_ratelimit_input_errors_total {limiter.errors}\n"
            "# HELP vpn_policy_ratelimit_error_state Whether the detector has observed an enforcement error\n"
            "# TYPE vpn_policy_ratelimit_error_state gauge\n"
            'vpn_policy_ratelimit_error_state{state="' + error_state + '"} 1\n'
            "# HELP vpn_policy_ratelimit_bans_total Total IPs banned since service start\n"
            "# TYPE vpn_policy_ratelimit_bans_total counter\n"
            f"vpn_policy_ratelimit_bans_total {limiter.bans}\n"
            "# HELP vpn_policy_ratelimit_events_total Blackhole/rejected events matched since service start\n"
            "# TYPE vpn_policy_ratelimit_events_total counter\n"
            f"vpn_policy_ratelimit_events_total {limiter.events}\n"
            "# HELP vpn_policy_ratelimit_lines_total Access-log lines tailed since service start\n"
            "# TYPE vpn_policy_ratelimit_lines_total counter\n"
            f"vpn_policy_ratelimit_lines_total {limiter.lines}\n"
            "# HELP vpn_policy_ratelimit_dead_contract 1 if many lines tailed but zero events matched — investigate broken sink/token or genuinely-quiet cohort\n"
            "# TYPE vpn_policy_ratelimit_dead_contract gauge\n"
            f"vpn_policy_ratelimit_dead_contract {dead}\n"
        )
        limiter.reported_errors = limiter.errors
    except OSError as exc:
        limiter.errors += 1
        logging.warning("metric publication failed (%s)", type(exc).__name__)


def tail(path: pathlib.Path):
    """Yield idle ticks as well as lines; distinguish unavailable input."""
    fh = None
    identity = None
    first_open = True
    try:
        while True:
            try:
                metadata = path.stat()
                new_identity = (metadata.st_dev, metadata.st_ino)
                if fh is None or identity != new_identity:
                    if fh is not None:
                        fh.close()
                    fh = path.open("r", errors="replace")
                    identity = new_identity
                    if first_open:
                        fh.seek(0, 2)
                        first_open = False
                elif metadata.st_size < fh.tell():
                    fh.seek(0)  # copytruncate rotation
                line = fh.readline()
                yield line or None, True
                if not line:
                    time.sleep(0.5)
            except OSError:
                if fh is not None:
                    fh.close()
                fh = None
                identity = None
                yield None, False
                time.sleep(0.5)
    finally:
        if fh is not None:
            fh.close()


def main() -> None:
    limiter = RateLimiter(REJECTS_PER_WINDOW, WINDOW_SECONDS, BAN_SECONDS)
    last_flush = None
    for line, input_healthy in tail(XRAY_LOG):
        now = time.time()
        limiter.input_healthy = input_healthy
        limiter.expire(now)
        if line is not None:
            ip = limiter.observe(line, now)
            if ip is not None and not add_offender(ip, BAN_SECONDS):
                limiter.errors += 1
        if last_flush is None or now - last_flush >= 15:
            flush_textfile(limiter)
            last_flush = now


if __name__ == "__main__":
    main()
