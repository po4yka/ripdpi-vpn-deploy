server {
    listen {{ probe_matrix_target.ports.tls_non_443 }} ssl;
    listen [::]:{{ probe_matrix_target.ports.tls_non_443 }} ssl;
    server_name {{ probe_matrix_target.server_name }};
    ssl_certificate /etc/probe-matrix/tls.crt;
    ssl_certificate_key /etc/probe-matrix/tls.key;
    location = /probe { return 204; }
    location / { return 404; }
}
