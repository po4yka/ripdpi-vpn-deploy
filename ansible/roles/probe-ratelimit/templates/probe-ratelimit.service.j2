[Unit]
Description=VPN routing-blackhole abuse rate-limiter (Xray access.log → nftables set)
Documentation=https://github.com/po4yka/vpn-deploy/blob/main/ansible/roles/probe-ratelimit/README.md
After=network-online.target nftables.service xray.service
Wants=network-online.target

[Service]
Type=simple
# nft needs CAP_NET_ADMIN; the daemon is small and runs as root to keep
# the seccomp surface inside @system-service.
User=root
Group=root
ExecStart=/usr/local/bin/probe-ratelimit.py
Restart=on-failure
RestartSec=5s

# Hardening — root for nft but everything else locked down.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ probe_ratelimit.textfile_dir | default('/var/lib/node_exporter/textfile') }}
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
