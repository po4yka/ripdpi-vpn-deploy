# Managed by Ansible role `reality-self-steal`.
# Combined field layout without the client address, referer or user agent.
log_format vpn_self_steal '- - - [$time_local] "$request" $status $body_bytes_sent "-" "-"';
server {
    listen {{ reality_self_steal_listen_address }}:{{ reality_self_steal_port }} ssl http2;
    server_name {{ reality_self_steal.server_name }};

    server_tokens off;
{% set self_steal_site_digest = (public_site_published | default({})).get(reality_self_steal_public_site_dir | default(''), '') %}
    root {{ ('/var/lib/public-site/' ~ self_steal_site_digest ~ '/current') if self_steal_site_digest
            else (reality_self_steal_site_root | default('/var/www/reality-self-steal')) }};
    index index.html;

    ssl_certificate {{ reality_self_steal_tls_dir | default('/etc/nginx/reality-self-steal') }}/current/fullchain.pem;
    ssl_certificate_key {{ reality_self_steal_tls_dir | default('/etc/nginx/reality-self-steal') }}/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # REALITY clients offer X25519 only, so it stays first.
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:reality_self_steal:1m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/reality-self-steal.access.log vpn_self_steal;
    error_log /var/log/nginx/reality-self-steal.error.log warn;
}
{% if reality_self_steal_http_redirect | default(false) | bool %}
{# nginx-xhttp already answers TCP/80 for a hostname that both roles serve. #}
{% if not ((vpn.enable_nginx_xhttp | default(false) | bool) and ((nginx_xhttp.server_name | default('')) | lower) == (reality_self_steal.server_name | lower)) %}

# Opt-in public TCP/80 for the owned hostname. It logs nothing: a client can
# send any bearer path over HTTP.
server {
    listen 80;
    listen [::]:80;
    server_name {{ reality_self_steal.server_name }};
    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    return 301 https://$host$request_uri;
}
{% if not (vpn.enable_nginx_xhttp | default(false) | bool) %}

# Any other Host, such as the node address, gets the site's ordinary 404 page.
# nginx-xhttp owns this default server when it shares the host.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    root {{ reality_self_steal_site_root | default('/var/www/reality-self-steal') }};
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
    location / {
        return 404;
    }
}
{% endif %}
{% endif %}
{% endif %}
