[Unit]
Description=Load validated split-hop egress NAT policy
After=local-fs.target systemd-sysctl.service nftables.service
Wants=nftables.service
Before=wg-quick@{{ split_hop_egress.wg_interface }}.service

[Service]
Type=oneshot
# The loaded table outlives the process; an inactive unit would hide a failed boot load.
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -c -f {{ split_hop_egress.policy_path }}
ExecStart=/usr/sbin/nft -f {{ split_hop_egress.policy_path }}
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
