# Per-source delivery rate limit and bounded categorical diagnostics.
# An IPv6 host can use any address inside its /64, so the first 8 bytes are
# the key; IPv4 keeps the whole address.
map $binary_remote_addr $vpn_sub_limit_key {
    default $binary_remote_addr;
    "~(?s)^(?<vpn_sub_v6_net>.{8}).{8}$" $vpn_sub_v6_net;
}
limit_req_zone $vpn_sub_limit_key zone=vpn_sub_per_ip:10m rate={{ subscription.rate_limit | default('5r/m') }};
{% if subscription_field_report.enabled | default(false) %}
# Field reports: a separate zone with the same IPv4-address or IPv6-/64 key, held in nginx shared memory only.
limit_req_zone $vpn_sub_limit_key zone=vpn_field_report_per_ip:10m rate={{ subscription_field_report.nginx_rate }};
{% if subscription_field_report.network_hint.enabled | default(false) %}
# Network hint: its own zone with the same key. The hint uses only the TCP peer address, so any
# client-supplied forwarding header, or a copy of the peer header, marks the request for refusal.
limit_req_zone $vpn_sub_limit_key zone=vpn_network_hint_per_ip:10m rate={{ subscription_field_report.network_hint.nginx_rate }};
map "$http_x_forwarded_for$http_forwarded$http_x_real_ip$http_x_network_hint_peer" $vpn_network_hint_forwarded {
    ""      0;
    default 1;
}
{% endif %}
{% endif %}

# Never include URI, headers, addresses, or token-bearing fields here.
log_format vpn_sub_category 'status=$status upstream_status=$upstream_status limit=$limit_req_status';
