# Subscription delivery host. Listens on a non-default port to keep the
# transport endpoint and the delivery endpoint topologically separated.

# The bare bundle URL serves its page. A map, not `if`: try_files is not
# inherited into the implicit location that a matching `if` creates.
map $vpn_share_file $vpn_share_target {
    ""      index.html;
    default $vpn_share_file;
}

server {
    listen {{ subscription.port | default(subscription_port) }} ssl http2;
    listen [::]:{{ subscription.port | default(subscription_port) }} ssl http2;

    server_name {{ subscription.server_name | default(nginx_xhttp.server_name) }};

    server_tokens off;

    # Every outcome can carry a bearer path, including unmatched requests.
    # Child locations inherit URI-free diagnostics from this server boundary.
    error_log /dev/null crit;
    access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;

    ssl_certificate     /etc/nginx/tls/subscription-host/server.fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/subscription-host/server.key;

    # Same TLS answer as the public site on this hostname (nginx-xhttp
    # site.conf.j2): a different stack on a second port marks the host.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ecdh_curve      X25519:prime256v1:secp384r1;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:vpn:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Keep the complete header set at server scope: every child location
    # inherits the same no-store policy and security headers. A child
    # add_header would discard this entire set on supported nginx versions.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control "no-store" always;
    # Header baseline aligned with the public-site vhost. CSP is tuned
    # to the static recipient pages: inline <style> and the same-origin
    # QR image are the only active surfaces; no script, frame, or
    # form targets exist on these pages.
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # The backend also protects direct loopback responses. Replace those
    # fields at the TLS edge instead of emitting duplicate public headers.
    proxy_hide_header Cache-Control;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header X-Robots-Tag;

    # Not-found answers use the public site's page when that site is on this
    # host; without it nginx falls back to its built-in page, with status 404.
    error_page 404 /404.html;
    location = /404.html {
        root /var/www/public-site;
        internal;
    }

    # Long-lived /sub/<token>. Proxied to the local vpn-bootstrap
    # service, which:
    #   * hashes the URL token with sha256
    #   * reads exact payload and expiry from sub/<hash>.document
    #   * supports legacy <hash>/<hash>.meta only when no document exists
    #   * consults the revocation file
    #   * writes a read-audit JSONL record
    # nginx fronts only TLS + rate-limit.
    location ~ "^/sub/(?<vpn_sub_token>[A-Za-z0-9_-]{16,64})$" {
        # A limited request answers exactly as an unmatched path does, so the
        # limit does not mark the route. 404 and not 410: a limited read must
        # never pass as proof of revocation.
        limit_req zone=vpn_sub_per_ip burst={{ subscription.rate_burst | default(20) }} nodelay;
        limit_req_status 404;
        # Another method, and HEAD (which GET admits and the backend answers 501),
        # also answers as an unmatched path does.
        limit_except GET { deny all; }

        proxy_pass http://{{ subscription.bootstrap_listen_addr | default('127.0.0.1') }}:{{ subscription.bootstrap_listen_port | default(8445) }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # The backend's own error page names its software. nginx answers with
        # its own page for the same status, so the 410 contract is kept.
        proxy_intercept_errors on;
        error_page 404 /404.html;
        error_page 403 405 501 =404 /404.html;
        error_page 410 = @vpn_sub_gone;
        error_page 503 = @vpn_sub_unavailable;

        # Error records include request/upstream URIs; bearer locations use
        # only URI-free categorical diagnostics, including failure outcomes.
        error_log /dev/null crit;
        access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;
    }

{% if subscription.enable_bootstrap | default(false) %}
    # One-time bootstrap tokens (single-use, optional server-side
    # expiry via sidecar meta). Proxied to the local vpn-bootstrap
    # service which atomically deletes the payload after first
    # successful read. Rate-limited via the same zone as /sub/.
    location ~ "^/bootstrap/(?<vpn_boot_token>[A-Za-z0-9_-]{16,64})$" {
        # A limited request answers exactly as an unmatched path does, so the
        # limit does not mark the route. 404 and not 410: a limited read must
        # never pass as proof of revocation.
        limit_req zone=vpn_sub_per_ip burst={{ subscription.rate_burst | default(20) }} nodelay;
        limit_req_status 404;
        # Another method, and HEAD (which GET admits and the backend answers 501),
        # also answers as an unmatched path does.
        limit_except GET { deny all; }

        proxy_pass http://{{ subscription.bootstrap_listen_addr | default('127.0.0.1') }}:{{ subscription.bootstrap_listen_port | default(8445) }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # The backend's own error page names its software. nginx answers with
        # its own page for the same status, so the 410 contract is kept.
        proxy_intercept_errors on;
        error_page 404 /404.html;
        error_page 403 405 501 =404 /404.html;
        error_page 410 = @vpn_sub_gone;
        error_page 503 = @vpn_sub_unavailable;

        # Error records include request/upstream URIs; bearer locations use
        # only URI-free categorical diagnostics, including failure outcomes.
        error_log /dev/null crit;
        access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;
    }
{% endif %}

{% if subscription_field_report.enabled | default(false) %}
    # Anonymous client field reports (docs/reference/ripdpi-bundle.md). The
    # backend validates, aggregates and discards each report. The body stays
    # in memory: the buffer equals the size limit, so nginx never writes a
    # report to a temporary file. No address is forwarded to the backend, which
    # listens only on a Unix socket that belongs to the nginx user.
    location = {{ subscription_field_report.path }} {
        limit_except POST { deny all; }
        limit_req zone=vpn_field_report_per_ip burst={{ subscription_field_report.nginx_burst }} nodelay;
        limit_req_status 429;
        client_max_body_size {{ subscription_field_report.max_body_bytes }};
        client_body_buffer_size {{ subscription_field_report.max_body_bytes }};

        proxy_pass http://unix:/run/vpn-field-report.sock:;
        # An unknown token or a refused method gets the vhost's uniform not-found answer, so a probe
        # without the cohort token cannot tell this route from any other path by 401, 403 or 501. 400, 413
        # and 429 stay distinct: the path is published in every bundle, so hiding it is not the goal.
        proxy_intercept_errors on;
        error_page 401 403 405 501 =404 /404.html;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";

        error_log /dev/null crit;
        access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;
    }
{% if subscription_field_report.network_hint.enabled | default(false) %}

    # Network hint (contract/client-network-hint.schema.json): the ASN of the TCP peer address.
    # The vhost has no real_ip module setting, so $remote_addr is the peer; nginx replaces any
    # client copy of the peer header and sends no forwarding header, and a request that carries
    # one is refused before the backend sees it. The categorical log holds no address.
    location = {{ subscription_field_report.network_hint.path }} {
        error_page 404 /404.html;
        if ($request_method != GET) {
            return 404;
        }
        if ($vpn_network_hint_forwarded) {
            return 400;
        }
        limit_req zone=vpn_network_hint_per_ip burst={{ subscription_field_report.network_hint.nginx_burst }} nodelay;
        limit_req_status 429;

        proxy_pass http://unix:/run/vpn-field-report.sock:;
        # An unknown token or a refused method gets the vhost's uniform not-found answer, so a probe
        # without the cohort token cannot tell this route from any other path by 401, 403 or 501. 400, 413
        # and 429 stay distinct: the path is published in every bundle, so hiding it is not the goal.
        proxy_intercept_errors on;
        error_page 401 403 405 501 =404 /404.html;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header Content-Length "";
        proxy_set_header X-Network-Hint-Peer $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP "";

        error_log /dev/null crit;
        access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;
    }
{% endif %}

{% endif %}
    # Static recipient pages produced by `vpnd share <client>`.
    # Served from the local filesystem; no proxy, no rate-limit (static HTML).
    # Always rendered: bundles stay on disk across deploys whose upload list is
    # empty, and a missing token answers like any unmatched path.
    # Raw token MUST NOT appear in logs — categorical logging applies here
    # as it does on /sub/. The vpnd audit trail is maintained
    # out-of-band; nginx never sees the plaintext token in a logged field.
    # `alias` with a variable in a regex location appends the whole request
    # URI, so every page answered 404. Bundles are flat: one file name, no
    # slash, which also keeps a request inside its own token directory.
    location ~ "^/share/(?<vpn_share_token>[A-Za-z0-9_-]{16,64})/(?<vpn_share_file>[A-Za-z0-9._-]*)$" {
        root /var/www/subscription-host/share/$vpn_share_token;
        try_files /$vpn_share_target =404;

        # Error records include request/upstream URIs; bearer locations use
        # only URI-free categorical diagnostics, including failure outcomes.
        error_log /dev/null crit;
        access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;
    }

    location @vpn_sub_gone {
        return 410;
    }

    location @vpn_sub_unavailable {
        return 503;
    }

    # Reject everything else.
    location / {
        return 404;
    }

}
