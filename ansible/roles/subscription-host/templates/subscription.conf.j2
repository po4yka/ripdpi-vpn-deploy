# Subscription delivery host. Listens on a non-default port to keep the
# transport endpoint and the delivery endpoint topologically separated.

{% if vpn.share_bundles | default([]) | length > 0 %}
# The bare bundle URL serves its page. A map, not `if`: try_files is not
# inherited into the implicit location that a matching `if` creates.
map $vpn_share_file $vpn_share_target {
    ""      index.html;
    default $vpn_share_file;
}

{% endif %}
server {
    listen {{ subscription.port | default(subscription_port) }} ssl http2;
    listen [::]:{{ subscription.port | default(subscription_port) }} ssl http2;

    server_name {{ subscription.server_name | default(nginx_xhttp.server_name) }};

    server_tokens off;

    # Every outcome can carry a bearer path, including unmatched requests.
    # Child locations inherit URI-free diagnostics from this server boundary.
    error_log /dev/null crit;
    access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;

    ssl_certificate     /etc/nginx/tls/subscription-host/server.fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/subscription-host/server.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    # Keep the complete header set at server scope: every child location
    # inherits the same no-store policy and security headers. A child
    # add_header would discard this entire set on supported nginx versions.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Cache-Control "no-store" always;
    # Header baseline aligned with the public-site vhost. CSP is tuned
    # to the static recipient pages: inline <style> and the same-origin
    # QR image are the only active surfaces; no script, frame, or
    # form targets exist on these pages.
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # The backend also protects direct loopback responses. Replace those
    # fields at the TLS edge instead of emitting duplicate public headers.
    proxy_hide_header Cache-Control;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header X-Robots-Tag;

    # Long-lived /sub/<token>. Proxied to the local vpn-bootstrap
    # service, which:
    #   * hashes the URL token with sha256
    #   * reads exact payload and expiry from sub/<hash>.document
    #   * supports legacy <hash>/<hash>.meta only when no document exists
    #   * consults the revocation file
    #   * writes a read-audit JSONL record
    # nginx fronts only TLS + rate-limit.
    location ~ "^/sub/(?<vpn_sub_token>[A-Za-z0-9_-]{16,64})$" {
        limit_req zone=vpn_sub_per_ip burst={{ subscription.rate_burst | default(3) }} nodelay;
        limit_req_status 429;

        proxy_pass http://{{ subscription.bootstrap_listen_addr | default('127.0.0.1') }}:{{ subscription.bootstrap_listen_port | default(8445) }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # The backend's own error page names its software. nginx answers with
        # its built-in page for the same status, so the 410 contract is kept.
        proxy_intercept_errors on;
        error_page 404 = @vpn_sub_not_found;
        error_page 410 = @vpn_sub_gone;
        error_page 503 = @vpn_sub_unavailable;

        # Error records include request/upstream URIs; bearer locations use
        # only URI-free categorical diagnostics, including failure outcomes.
        error_log /dev/null crit;
        access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;
    }

{% if subscription.enable_bootstrap | default(false) %}
    # One-time bootstrap tokens (single-use, optional server-side
    # expiry via sidecar meta). Proxied to the local vpn-bootstrap
    # service which atomically deletes the payload after first
    # successful read. Rate-limited via the same zone as /sub/.
    location ~ "^/bootstrap/(?<vpn_boot_token>[A-Za-z0-9_-]{16,64})$" {
        limit_req zone=vpn_sub_per_ip burst={{ subscription.rate_burst | default(3) }} nodelay;
        limit_req_status 429;

        proxy_pass http://{{ subscription.bootstrap_listen_addr | default('127.0.0.1') }}:{{ subscription.bootstrap_listen_port | default(8445) }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # The backend's own error page names its software. nginx answers with
        # its built-in page for the same status, so the 410 contract is kept.
        proxy_intercept_errors on;
        error_page 404 = @vpn_sub_not_found;
        error_page 410 = @vpn_sub_gone;
        error_page 503 = @vpn_sub_unavailable;

        # Error records include request/upstream URIs; bearer locations use
        # only URI-free categorical diagnostics, including failure outcomes.
        error_log /dev/null crit;
        access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;
    }
{% endif %}

{% if vpn.share_bundles | default([]) | length > 0 %}
    # Static recipient pages produced by `vpnd share <client>`.
    # Served from the local filesystem; no proxy, no rate-limit (static HTML).
    # Raw token MUST NOT appear in logs — categorical logging applies here
    # as it does on /sub/. The vpnd audit trail is maintained
    # out-of-band; nginx never sees the plaintext token in a logged field.
    # `alias` with a variable in a regex location appends the whole request
    # URI, so every page answered 404. Bundles are flat: one file name, no
    # slash, which also keeps a request inside its own token directory.
    location ~ "^/share/(?<vpn_share_token>[A-Za-z0-9_-]{16,64})/(?<vpn_share_file>[A-Za-z0-9._-]*)$" {
        root /var/www/subscription-host/share/$vpn_share_token;
        try_files /$vpn_share_target =404;

        # Error records include request/upstream URIs; bearer locations use
        # only URI-free categorical diagnostics, including failure outcomes.
        error_log /dev/null crit;
        access_log /var/log/nginx/vpn-sub.categorical.log vpn_sub_category;
    }
{% endif %}

    location @vpn_sub_not_found {
        return 404;
    }

    location @vpn_sub_gone {
        return 410;
    }

    location @vpn_sub_unavailable {
        return 503;
    }

    # Reject everything else.
    location / {
        return 404;
    }

}
