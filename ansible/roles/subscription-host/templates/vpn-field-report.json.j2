{#- A hint request from a fleet node's public address came through the tunnel; the ingest answers it with 204.
    The inventory names each node's primary IPv4, its IPv6 (matched by /64) and the honeypot secondary IPv4. -#}
{%- set _fleet_addresses = [] -%}
{%- for host in (groups | default({}))['all'] | default([]) -%}
{%- for address in [hostvars[host]['vpn_service_address'] | default(''), hostvars[host]['server_ipv6'] | default(''),
                    hostvars[host]['honeypot_listen_addr'] | default('')] if address -%}
{%- set _ = _fleet_addresses.append(address) -%}
{%- endfor -%}
{%- endfor -%}
{{ {
  'path': subscription_field_report.path,
  'max_body_bytes': subscription_field_report.max_body_bytes | int,
  'min_attempts': subscription_field_report.min_attempts | int,
  'max_attempts_per_report': subscription_field_report.max_attempts_per_report | int,
  'top_n_min_reports': subscription_field_report.top_n_min_reports | int,
  'asn_top_n': subscription_field_report.asn_top_n | int,
  'operator_top_n': subscription_field_report.operator_top_n | int,
  'country_top_n': subscription_field_report.country_top_n | int,
  'max_series': subscription_field_report.max_series | int,
  'window_seconds': subscription_field_report.window_seconds | int,
  'server_refs': subscription_field_report.server_refs | list,
  'network_hint': ({
    'path': subscription_field_report.network_hint.path,
    'ttl_seconds': subscription_field_report.network_hint.ttl_seconds | int,
    'database': '/usr/local/lib/vpn-field-report/ip2asn-combined.tsv.gz',
    'database_sha256': subscription_field_report.network_hint.dataset_sha256,
    'fleet_addresses': _fleet_addresses | unique | sort,
  } if subscription_field_report.network_hint.enabled | default(false) else none),
  'textfile': '/var/lib/vpn-field-report/vpn_field_report.prom',
  'schema': '/usr/local/lib/vpn-field-report/client-field-report.schema.json',
  'validator': '/usr/local/lib/vpn-field-report/validate_field_report.py',
} | to_nice_json(indent=2) }}
