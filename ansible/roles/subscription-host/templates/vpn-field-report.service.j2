[Unit]
Description=Anonymous client field-report ingest (aggregate only)
Documentation=https://github.com/po4yka/ripdpi-vpn-deploy/blob/main/docs/reference/ripdpi-bundle.md
# The only listener is the socket unit's file, passed in as fd 3.
Requires=vpn-field-report.socket
After=vpn-field-report.socket

[Service]
Type=simple
User=vpn-field-report
Group=vpn-field-report
# The cohort tokens arrive as a credential, never on the command line or in the environment.
LoadCredential=cohort-tokens:/etc/vpn-field-report/cohort-tokens.json
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/vpn-field-report/vpn-field-report.py --config /etc/vpn-field-report/config.json --tokens %d/cohort-tokens
Restart=on-failure
RestartSec=5s
UMask=0022
# Aggregates live in memory; a runaway process is stopped instead of swapping.
MemoryMax=128M
TasksMax=8
# A core file would keep cohort tokens and request data on disk.
LimitCORE=0

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
# The aggregate lives in this private directory. A root-owned link in the shared textfile
# directory points at it, so the internet-facing ingest is no textfile writer-group member.
StateDirectory=vpn-field-report
StateDirectoryMode=0755
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
# The inherited Unix socket is the only way in; the process has no network of its own.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
