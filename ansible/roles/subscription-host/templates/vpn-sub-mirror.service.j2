[Unit]
Description=VPN subscription payload mirror (publish the fetched hashed-on-disk tree)
Documentation=https://github.com/po4yka/vpn-deploy/blob/main/docs/how-to/subscription-host-separation.md
# The fetch unit pulls as the mirror user; this unit starts only after it ends
# and fails with it, so a failed pull publishes nothing.
Requires=vpn-sub-mirror-fetch.service
After=network-online.target vpn-sub-mirror-fetch.service
Wants=network-online.target

[Service]
Type=oneshot
User=vpn-bootstrap
Group=vpn-bootstrap
ExecStart=/usr/local/bin/vpn-sub-mirror.sh

# Hardening — mirrors vpn-bootstrap.service.j2. This unit copies the fetched
# tree and holds no mirror credential; rsync, ssh and restic run in the fetch unit.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ subscription.subscription_dir | default('/var/lib/vpn-subscription') }}
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=yes
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Keep resource mutations denied except rsync's startup setrlimit call. The
# default seccomp action is SIGSYS, so denying that call prevents every pull.
SystemCallFilter=~@privileged @resources
SystemCallFilter=setrlimit

[Install]
WantedBy=multi-user.target
