# Loaded by /etc/systemd/system/vpn-watchdog.service.
# 0600 root:root.

FAIL_THRESHOLD={{ watchdog.fail_threshold }}
STATE_FILE={{ watchdog.state_file }}
ALERTS_PER_HOUR_MAX={{ watchdog.alerts_per_hour_max }}
KICKS_PER_HOUR_MAX={{ watchdog.kicks_per_hour_max | default(3) }}

ENABLE_XRAY={{ ((vpn.enable_xray_reality | default(true)) and not (vpn_subscription_only | default(false))) | string | lower }}
ENABLE_NGINX_XHTTP={{ ((vpn.enable_nginx_xhttp | default(true)) and not (vpn_subscription_only | default(false))) | string | lower }}
ENABLE_HYSTERIA={{ ((vpn.enable_hysteria | default(true)) and not (vpn_subscription_only | default(false))) | string | lower }}
ENABLE_AMNEZIAWG={{ ((vpn.enable_amneziawg | default(false)) and not (vpn_subscription_only | default(false))) | string | lower }}

XRAY_PORT={{ xray_port }}
XRAY_API_SERVER={{ xray_api_listen }}
XRAY_REALITY_CONFIG=/etc/vpn-watchdog-reality.json
XRAY_REALITY_PROBE_TIMEOUT={{ watchdog.reality_probe_timeout | default(15) }}
XRAY_REALITY_PROBE_URL={{ watchdog_secrets.reality_probe_url | default('') | to_json }}
XRAY_REALITY_PROBE_EXPECTED_STATUS={{ watchdog_secrets.reality_probe_expected_status | default(204) }}
XRAY_REALITY_PROBES={% for probe in watchdog_reality_probes %}{{ probe.port }}:{{ (watchdog.reality_probe_socks_port | default(31082)) + loop.index0 }}{% if not loop.last %},{% endif %}{% endfor %}{{ '\n' }}
XRAY_XHTTP_PROBES={% if (vpn.enable_nginx_xhttp | default(true)) and not (vpn_subscription_only | default(false)) %}{{ nginx_xhttp_public_port }}:{{ (watchdog.reality_probe_socks_port | default(31082)) + (watchdog_reality_probes | length) }}{% if nginx_xhttp.fallback_enabled | default(false) %},{{ nginx_xhttp_fallback_port }}:{{ (watchdog.reality_probe_socks_port | default(31082)) + (watchdog_reality_probes | length) + 1 }}{% endif %}{% endif %}{{ '\n' }}
NGINX_PORT={{ nginx_xhttp_public_port if (vpn.enable_nginx_xhttp | default(true)) and not (vpn_subscription_only | default(false)) else 0 }}
XHTTP_BACKEND_PORT={{ nginx_xhttp_port if (vpn.enable_nginx_xhttp | default(true)) and not (vpn_subscription_only | default(false)) else 0 }}
NGINX_FALLBACK_PORT={{ nginx_xhttp_fallback_port if (vpn.enable_nginx_xhttp | default(true)) and not (vpn_subscription_only | default(false)) and (nginx_xhttp.fallback_enabled | default(false)) else 0 }}
HYSTERIA_PORT={{ hysteria_port }}
AWG_INTERFACES={{ watchdog_awg_interfaces | join(',') }}
HYSTERIA_PROBE_SOCKS_PORT={{ watchdog.hysteria_probe_socks_port | default(31110) }}
