{%- set _client_by_name = {} %}
{%- for _c in xray.clients %}{%- set _ = _client_by_name.update({_c.name: _c}) %}{%- endfor %}
{%- set _fallback_port = (xray_fallback_port | int) %}
{%- set _reality_enabled = vpn.enable_xray_reality | default(true) %}
{%- set _default_flow_mode = vpn.xray_flow_mode | default(p0_reality_flow_mode) %}
{%- set _default_shape = p0_reality_shapes[_default_flow_mode] %}
{%- set _default_finalmask = vpn.xray_finalmask | default(_default_shape.finalmask) %}
{%- if not _reality_enabled %}
  {%- set _cohorts = [] %}
  {%- set _multi = false %}
{%- elif (xray.cohorts | default([])) | length > 0 %}
  {%- set _cohorts = xray.cohorts %}
  {%- set _multi = true %}
{%- elif _fallback_port > 0 and _fallback_port != (xray_port | int) %}
  {%- set _all_clients = (xray.clients | map(attribute='name') | list) %}
  {%- set _cohorts = [
    {
      "name": "primary",
      "port": (xray_port | int),
      "flow_mode": _default_flow_mode,
      "finalmask": _default_finalmask,
      "clients": _all_clients,
    },
    {
      "name": "fallback",
      "port": _fallback_port,
      "flow_mode": _default_flow_mode,
      "finalmask": _default_finalmask,
      "clients": _all_clients,
    },
  ] %}
  {%- set _multi = true %}
{%- else %}
  {%- set _cohorts = [{
      "name": "default",
      "port": (xray_port | int),
      "flow_mode": _default_flow_mode,
      "finalmask": _default_finalmask,
      "clients": (xray.clients | map(attribute='name') | list),
  }] %}
  {%- set _multi = false %}
{%- endif %}
{
  "log": {
    "loglevel": "warning",
    "access": "{{ xray_log_path }}/access.log",
    "error": "{{ xray_log_path }}/error.log"
  },
  "api": {
    "tag": "api",
    "listen": "{{ xray_api_listen }}",
    "services": ["StatsService"]
  },
  "stats": {},
  "dns": {
    "servers": [
      {%- if vpn.enable_cascade_ingress | default(false) %}
      "tcp://1.1.1.1:53",
      "tcp://8.8.8.8:53"
      {%- else %}
      "1.1.1.1",
      "8.8.8.8",
      "https+local://dns.cloudflare.com/dns-query"
      {%- endif %}
    ],
    "queryStrategy": "{% if vpn.enable_cascade_ingress | default(false) %}UseIPv4{% else %}UseIP{% endif %}",
    "tag": "dns-inbound"
  },
  "inbounds": [
    {%- for _coh in _cohorts %}
    {%- set _coh_clients = _coh.clients | map('extract', _client_by_name) | list %}
    {%- set _shape = p0_reality_shapes[_coh.flow_mode | default(_default_flow_mode)] %}
    {%- set _finalmask = _coh.finalmask | default(_default_finalmask) %}
    {
      "tag": "{% if _multi %}vless-reality-{{ _coh.name }}{% else %}vless-reality{% endif %}",
      "listen": "0.0.0.0",
      "port": {{ _coh.port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {%- for client in _coh_clients %}
          {
            "id": "{{ client.uuid }}",
            {%- if _shape.client_flow %}
            "flow": "{{ _shape.client_flow }}",
            {%- endif %}
            "email": "{{ client.name }}{% if _multi %}-{{ _coh.name }}{% endif %}"
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "{{ xray.target }}",
          "xver": 0,
          "serverNames": {{ xray.server_names | to_json }},
          "privateKey": "{{ xray.reality_private_key }}",
          "shortIds": [
            {%- for client in _coh_clients %}
            "{{ client.short_id }}"{% if not loop.last %},{% endif %}
            {%- endfor %}
          ]
        }{% if _finalmask %},
        "sockopt": {
          "finalmask": "Sudoku"
        }{% endif %}
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "metadataOnly": false,
        "routeOnly": false
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
    {%- if vpn.enable_nginx_xhttp | default(false) %}{% if _reality_enabled %},{% endif %}
    {
      "tag": "vless-xhttp-localhost",
      "listen": "127.0.0.1",
      "port": {{ nginx_xhttp_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {%- for client in xray.clients %}
          {
            "id": "{{ client.uuid }}",
            "email": "{{ client.name }}-xhttp"
          }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "{{ xray.xhttp_path | default('/app-sync') }}",
          "mode": "{{ xray.xhttp_mode | default('auto') }}"
        },
        "sockopt": {
          "trustedXForwardedFor": ["127.0.0.1"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "metadataOnly": false
      }
    }{% endif %}
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP"
      }
    },
    {
      "tag": "direct-asis",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "AsIs"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns"
    }{% if vpn.enable_cascade_ingress | default(false) %},
    {
      "tag": "cascade-classifier",
      "protocol": "socks",
      "targetStrategy": "ForceIPv4",
      "settings": {
        "servers": [
          {
            "address": "{{ cascade_ingress.classifier_proxy_host | default('127.0.0.1') }}",
            "port": {{ cascade_ingress.classifier_proxy_port | default(10808) }},
            "users": [
              {
                "user": "cascade-xray",
                "pass": {{ cascade_secrets.classifier_proxy_password | to_json }}
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4"
        }
      }
    }{% endif %}{% if not (vpn.enable_cascade_ingress | default(false)) and (vpn.enable_warp_outbound | default(false)) and ((vpn.warp_outbound_routes | default([])) | length > 0) %},
    {
      "tag": "warp-out",
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "127.0.0.1",
            "port": {{ warp_outbound.socks_port | default(40000) }}
          }
        ]
      }
    }{% endif %}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {%- if vpn.enable_cascade_ingress | default(false) %}
      {
        "type": "field",
        "comment": "Route built-in TCP DNS resolution through the classifier before Xray sends resolved IPs",
        "inboundTag": ["dns-inbound"],
        "outboundTag": "cascade-classifier"
      },
      {%- endif %}
      {%- if not (vpn.enable_cascade_ingress | default(false)) %}
      {
        "type": "field",
        "comment": "DNS hijack — keep client DNS lookups visible to xray and resolvable",
        "inboundTag": [
          {%- for _coh in _cohorts -%}
          "{% if _multi %}vless-reality-{{ _coh.name }}{% else %}vless-reality{% endif %}"{% if not loop.last %},{% endif %}
          {%- endfor -%}
          {% if vpn.enable_nginx_xhttp | default(false) %}{% if _reality_enabled %},{% endif %}"vless-xhttp-localhost"{% endif %}
        ],
        "port": "53",
        "outboundTag": "dns-out"
      },
      {%- endif %}
      {
        "type": "field",
        "comment": "Probe-defense: block BitTorrent on the exit (graylist correlates BT)",
        "protocol": ["bittorrent"],
        "outboundTag": "block"
      },
      {%- if xray_block_quic_outbound | default(true) %}
      {
        "type": "field",
        "comment": "Probe-defense: blackhole outbound QUIC (UDP/443) to deny a UDP/443 leak fingerprint. TRADE-OFF: this disables HTTP/3 for every proxied client — browsers and apps transparently fall back to HTTP/2 over TCP (slower on lossy / high-latency links, no functional break). Disable per-deploy with xray_block_quic_outbound=false; see roles/xray/README.md.",
        "network": "udp",
        "port": "443",
        "outboundTag": "block"
      },
      {%- endif %}
      {
        "type": "field",
        "comment": "RFC1918 / link-local / loopback should never egress",
        "ip": [
          "geoip:private",
          "127.0.0.0/8",
          "169.254.0.0/16"
        ],
        "outboundTag": "block"
      },
      {% if not (vpn.enable_cascade_ingress | default(false)) and (vpn.enable_warp_outbound | default(false)) and ((vpn.warp_outbound_routes | default([])) | length > 0) %}
      {%- for r in vpn.warp_outbound_routes %}
      {
        "type": "field",
        "comment": "WARP split-hop egress rule #{{ loop.index }}",
        {%- for k, v in r.items() %}
        {{ k | to_json }}: {{ v | to_json }},
        {%- endfor %}
        "outboundTag": "warp-out"
      },
      {%- endfor %}
      {% endif %}
      {%- if vpn.enable_cascade_ingress | default(false) %}
      {
        "type": "field",
        "comment": "Cascade adapter is TCP-only; UDP is fail-closed until equivalent per-destination classification exists",
        "network": "udp",
        "outboundTag": "block"
      },
      {% endif -%}
      {
        "type": "field",
        "comment": "{% if vpn.enable_cascade_ingress | default(false) %}Default TCP traffic enters the loopback classifier adapter{% else %}Default — direct freedom outbound with UseIP strategy{% endif %}",
        "network": "{% if vpn.enable_cascade_ingress | default(false) %}tcp{% else %}tcp,udp{% endif %}",
        "outboundTag": "{% if vpn.enable_cascade_ingress | default(false) %}cascade-classifier{% else %}direct{% endif %}"
      }
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 2,
        "downlinkOnly": 5,
        "bufferSize": 4
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  }
}
