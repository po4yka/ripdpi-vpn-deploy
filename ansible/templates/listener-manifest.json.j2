{% set ns = namespace(listeners=[]) %}
{% set subscription_only = vpn_subscription_only | default(false) %}
{% set xray_enabled = (vpn.enable_xray_reality | default(true)) and not subscription_only %}
{% set xray_cohorts = (xray.cohorts | default([])) if xray is defined else [] %}
{# Terraform edge contract is intentionally independent; site.yml compares it
   with this pre-task runtime manifest before any listener is converged. #}
{% if xray_enabled and (xray_cohorts | length > 0) %}
{% for cohort in xray_cohorts %}
{% set _ = ns.listeners.append({
  "role": "xray",
  "protocol": "tcp",
  "port": cohort.port | int,
  "enabled": true,
  "reason": "P0 REALITY cohort " ~ (cohort.name | default(loop.index))
}) %}
{% endfor %}
{% else %}
{% set _ = ns.listeners.append({
  "role": "xray",
  "protocol": "tcp",
  "port": xray_port | int,
  "enabled": xray_enabled,
  "reason": "P0 REALITY primary listener"
}) %}
{% set _xray_fallback_port = xray_fallback_port | int %}
{% set _ = ns.listeners.append({
  "role": "xray-fallback",
  "protocol": "tcp",
  "port": _xray_fallback_port,
  "enabled": xray_enabled and _xray_fallback_port > 0,
  "reason": "P0 REALITY fallback listener"
}) %}
{% endif %}
{% set _nginx_xhttp_fallback = (nginx_xhttp.fallback_enabled | default(false)) if nginx_xhttp is defined else false %}
{% set _ = ns.listeners.append({
  "role": "public-site-http",
  "protocol": "tcp",
  "port": 80,
  "enabled": (vpn.enable_nginx_xhttp | default(true)) and not subscription_only,
  "reason": "HTTP redirect for the public HTTPS site"
}) %}
{% set _ = ns.listeners.append({
  "role": "nginx-xhttp-fallback",
  "protocol": "tcp",
  "port": nginx_xhttp_fallback_port | int,
  "enabled": (vpn.enable_nginx_xhttp | default(true)) and not subscription_only and _nginx_xhttp_fallback,
  "reason": "P1 direct XHTTP fallback listener"
}) %}
{% set _ = ns.listeners.append({
  "role": "nginx-xhttp",
  "protocol": "tcp",
  "port": nginx_xhttp_public_port | int,
  "enabled": (vpn.enable_nginx_xhttp | default(true)) and not subscription_only,
  "reason": "P1 direct XHTTP listener"
}) %}
{% set _ = ns.listeners.append({
  "role": "hysteria",
  "protocol": "udp",
  "port": hysteria_port | int,
  "enabled": (vpn.enable_hysteria | default(false)) and not subscription_only,
  "reason": "P2 Hysteria2 listener"
}) %}
{% set _hysteria_range = hysteria_port_range | string %}
{% set _ = ns.listeners.append({
  "role": "hysteria",
  "protocol": "udp",
  "range": _hysteria_range,
  "enabled": (vpn.enable_hysteria | default(false)) and not subscription_only and (_hysteria_range | length > 0),
  "reason": "P2 Hysteria2 port-hopping range"
}) %}
{% set awg_instances = (amneziawg_secrets.instances | default([])) if amneziawg_secrets is defined else [] %}
{% if awg_instances | length > 0 %}
{% for inst in awg_instances %}
{% set _ = ns.listeners.append({
  "role": "amneziawg",
  "protocol": "udp",
  "port": inst.listen_port | int,
  "enabled": (vpn.enable_amneziawg | default(false)) and not subscription_only,
  "reason": "P2 AmneziaWG instance " ~ (inst.name | default(loop.index))
}) %}
{% endfor %}
{% else %}
{% set _ = ns.listeners.append({
  "role": "amneziawg",
  "protocol": "udp",
  "port": (amneziawg | default({})).listen_port | default(amneziawg_listen_port) | int,
  "enabled": (vpn.enable_amneziawg | default(false)) and not subscription_only,
  "reason": "P2 AmneziaWG listener"
}) %}
{% endif %}
{% set _awg_evidence_mode = real_vps_awg_nat_mode | default('fail_closed') %}
{% set _ = ns.listeners.append({
  "role": "awg-evidence",
  "protocol": "udp",
  "port": real_vps_awg_nat_listen_port | default(51920) | int,
  "enabled": _awg_evidence_mode == "server",
  "reason": "recurring real-VPS AWG evidence listener"
}) %}
{% set _ = ns.listeners.append({
  "role": "awg-evidence-echo-tcp",
  "protocol": "tcp",
  "port": real_vps_awg_nat_tcp_echo_port | default(10001) | int,
  "enabled": _awg_evidence_mode == "echo",
  "reason": "owner-controlled AWG evidence TCP echo"
}) %}
{% set _ = ns.listeners.append({
  "role": "awg-evidence-echo-udp",
  "protocol": "udp",
  "port": real_vps_awg_nat_udp_echo_port | default(10002) | int,
  "enabled": _awg_evidence_mode == "echo",
  "reason": "owner-controlled AWG evidence UDP echo"
}) %}
{% set _ = ns.listeners.append({
  "role": "subscription-host",
  "protocol": "tcp",
  "port": (subscription | default({})).port | default(subscription_port) | int,
  "enabled": (vpn.enable_subscription_host | default(false)) or subscription_only,
  "reason": "subscription delivery HTTPS listener"
}) %}
{% set _ = ns.listeners.append({
  "role": "honeypot",
  "protocol": "tcp",
  "port": (honeypot | default({})).port | default(honeypot_port) | int,
  "enabled": (vpn.enable_honeypot | default(false)) and not subscription_only,
  "reason": "active-probing canary listener"
}) %}
{% set _ = ns.listeners.append({
  "role": "dns-morph-bridge",
  "protocol": "udp",
  "port": (dns_morph_bridge | default({})).listen_port | default(dns_morph_bridge_listen_port) | int,
  "enabled": (vpn.enable_dns_morph_bridge | default(false)) and not subscription_only,
  "reason": "DNS-Morph bootstrap listener"
}) %}
{% set _ = ns.listeners.append({
  "role": "hysteria-realm",
  "protocol": "tcp",
  "port": (hysteria_realm | default({})).listen_port | default(hysteria_realm_listen_port) | int,
  "enabled": (vpn.enable_hysteria_realm | default(false)) and not subscription_only,
  "reason": "Hysteria Realm rendezvous listener"
}) %}
{% for variant in (snell | default({})).variants | default([]) %}
{% set _ = ns.listeners.append({
  "role": "snell-" ~ variant.id,
  "protocol": "tcp",
  "port": variant.listen_port | int,
  "enabled": (vpn.enable_snell | default(false)) and not subscription_only,
  "reason": "P3 Snell research variant " ~ variant.id
}) %}
{% endfor %}
{% set _ = ns.listeners.append({
  "role": "cdn-front",
  "protocol": "tcp",
  "port": (cdn_front | default({})).port | default(cdn_front_port) | int,
  "enabled": (vpn.enable_cdn_front | default(false)) and not subscription_only,
  "reason": "CDN-fronted XHTTP listener"
}) %}
{% set _ = ns.listeners.append({
  "role": "naive",
  "protocol": "tcp",
  "port": (naive | default({})).bind_port | default(naive_bind_port) | int,
  "enabled": (vpn.enable_naive | default(false)) and not subscription_only,
  "reason": "NaiveProxy public listener"
}) %}
{# pre_task scope: role defaults are NOT loaded here, so every lookup is
   default-guarded and mirrors ansible/roles/*/defaults/main.yml. #}
{% set _probe_ports = (probe_matrix_target | default({})).ports | default({}) %}
{% for probe_listener in [
  {"name": "mtproto", "port": _probe_ports.mtproto | default(0)},
  {"name": "xhttp-vless", "port": _probe_ports.xhttp_vless | default(0)},
  {"name": "xhttp-trojan", "port": _probe_ports.xhttp_trojan | default(0)},
  {"name": "tcp-trojan", "port": _probe_ports.tcp_trojan | default(0)},
  {"name": "tls-non-443", "port": _probe_ports.tls_non_443 | default(0)}
] %}
{% set _ = ns.listeners.append({
  "role": "probe-matrix-" ~ probe_listener.name,
  "protocol": "tcp",
  "port": probe_listener.port | int,
  "enabled": (vpn.enable_probe_matrix_target | default(false)) and not subscription_only,
  "reason": "owned probe matrix " ~ probe_listener.name ~ " listener"
}) %}
{% endfor %}
{% set _ = ns.listeners.append({
  "role": "split-hop-ingress",
  "protocol": "udp",
  "port": (split_hop_ingress | default({})).listen_port | default(split_hop_ingress_listen_port) | int,
  "enabled": (vpn.enable_split_hop_ingress | default(false)) and not subscription_only,
  "reason": "split-hop responder listener"
}) %}
{{ ns.listeners | to_json }}
