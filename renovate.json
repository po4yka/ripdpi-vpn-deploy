{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "schedule": ["on weekend"],
  "packageRules": [
    {
      "description": "Group all Terraform provider updates into one weekly PR",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["provider"],
      "groupName": "terraform providers",
      "schedule": ["on weekend"]
    },
    {
      "description": "Group all Rust crate updates into one weekly PR",
      "matchManagers": ["cargo"],
      "groupName": "rust crates",
      "schedule": ["on weekend"]
    },
    {
      "description": "One PR per GitHub Actions update with digest pinning; preserve version comment",
      "matchManagers": ["github-actions"],
      "separateMinorPatch": false,
      "addLabels": ["dependencies", "github-actions"]
    }
  ],
  "customManagers": [
    {
      "description": "Hysteria-realm (sing-box) version pin in Ansible role defaults",
      "customType": "regex",
      "fileMatch": ["^ansible/roles/hysteria-realm/defaults/main\\.yml$"],
      "matchStrings": [
        "hysteria_realm:\\s*\\n(?:[^\\n]*\\n)*?\\s+version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "depNameTemplate": "SagerNet/sing-box",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "Snell research candidate sing-box version pin",
      "customType": "regex",
      "fileMatch": ["^ansible/roles/snell/defaults/main\\.yml$"],
      "matchStrings": ["snell:\\s*\\n(?:[^\\n]*\\n)*?\\s+version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"],
      "depNameTemplate": "SagerNet/sing-box",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
