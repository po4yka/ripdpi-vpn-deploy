# Copy to staging.tfvars and fill. Use a different REALITY keypair, target,
# and admin SSH key from prod. Do NOT commit staging.tfvars.

server_name = "vpn-staging-fi1"
zone        = "fi-hel1"
plan        = "1xCPU-1GB"

storage_template = "UPCLOUD_TEMPLATE_UUID"
storage_size_gb  = 20

admin_user           = "deploy"
admin_ssh_public_key = "ssh-ed25519 AAAA_STAGING_PUBLIC_KEY operator@laptop"
ssh_port             = 22

allowed_ssh_cidrs = ["203.0.113.42/32"]

enable_hysteria = true
# Phase 1 is always false. Change to true only after this exact staging node
# passes guest-firewall, SSH and outbound acceptance.
enable_provider_firewall = false
public_listeners = [
  { name = "xray", protocol = "tcp", port = 443 },
  { name = "xray-fallback", protocol = "tcp", port = 2053 },
  { name = "nginx-xhttp", protocol = "tcp", port = 8443 },
  { name = "hysteria", protocol = "udp", port = 443 },
  { name = "amneziawg", protocol = "udp", port = 51820 },
]
build_env       = "staging"

labels = {
  project = "vpn-deploy"
  env     = "staging"
}
