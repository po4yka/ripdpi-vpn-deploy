# Copy to staging.tfvars and fill. Do NOT commit staging.tfvars.
# Export VULTR_API_KEY before planning; never place the API key here.

server_name = "vpn-staging-ams1"
region      = "ams"
plan        = "vc2-1c-1gb"
os_id       = 2284 # Debian 13; see variables.tf validation for approved ids

admin_user           = "deploy"
admin_ssh_public_key = "ssh-ed25519 AAAA_STAGING_PUBLIC_KEY operator@laptop"
ssh_port             = 22

allowed_ssh_cidrs = ["203.0.113.42/32"]

enable_hysteria = true
public_listeners = [
  { name = "xray", protocol = "tcp", port = 443 },
  { name = "xray-fallback", protocol = "tcp", port = 2053 },
  { name = "nginx-xhttp", protocol = "tcp", port = 8443 },
  { name = "hysteria", protocol = "udp", port = 443 },
  { name = "amneziawg", protocol = "udp", port = 51820 },
]
build_env       = "staging"

labels = {
  project = "vpn-deploy"
  env     = "staging"
}
