#cloud-config

package_update: true
package_upgrade: false
package_reboot_if_required: false

users:
  - default
  - name: ${admin_user}
    gecos: VPN Deploy User
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${admin_ssh_public_key}

ssh_pwauth: false
disable_root: true

packages:
  - python3
  - python3-apt
  - sudo
  - ca-certificates
  - curl
  - jq

write_files:
  - path: /etc/ssh/sshd_config.d/10-cloud-init-hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      Port ${ssh_port}
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      X11Forwarding no

  - path: /etc/vpn-build-id
    owner: root:root
    permissions: "0644"
    content: |
      provisioned_by=cloud-init
      next_stage=ansible
      build_env=${build_env}

runcmd:
  # Validate and reload sshd only on first boot so subsequent reboots do not
  # drop active tunnels. Newer distro images ship socket-activated SSH with
  # the service inactive on first boot, where a bare reload fails; enable the
  # unit first (a no-op when it is already active). Keep the marker in the
  # same success chain: external waiters must never observe completion after
  # a failed validation or activation.
  - [sh, -c, "test -f /var/lib/cloud-init-vpn-bootstrap.done || { install -d -m 0755 /run/sshd && /usr/sbin/sshd -t && systemctl enable --now ssh && systemctl reload ssh && touch /var/lib/cloud-init-vpn-bootstrap.done; }"]

final_message: "VPN VPS bootstrap complete after $UPTIME seconds"
