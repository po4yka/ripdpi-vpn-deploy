<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{% block title %}{{ site.name }}{% endblock %}</title>
<link rel="canonical" href="{{ site.origin }}{% block path %}/{% endblock %}">
<link rel="alternate" type="application/atom+xml" href="{{ site.origin }}/feed.xml">
<link rel="stylesheet" href="/assets/main.css">
</head>
<body>
<header><a href="/">{{ site.name }}</a> — {{ site.subject }}</header>
<main>{% block main %}{% endblock %}</main>
</body>
</html>
