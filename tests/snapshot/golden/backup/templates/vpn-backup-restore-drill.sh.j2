#!/usr/bin/env bash
# Managed by Ansible role `backup`. Restores into private runtime storage only.
set -euo pipefail
umask 077

: "${RUNTIME_DIRECTORY:?systemd must provide RUNTIME_DIRECTORY}"
: "${STATE_DIRECTORY:?systemd must provide STATE_DIRECTORY}"

export RESTIC_PASSWORD_FILE=/etc/restic/password

REPO="/var/backups/vpn-restic"
REPOSITORY_SOURCE="local"


restore_target="${RUNTIME_DIRECTORY}/restore"
snapshot_metadata=""
marker="${STATE_DIRECTORY}/restore-drill-last-success.json"
marker_tmp=""

# Claim the target atomically. A prior directory, file, or dangling symlink is
# not ours, and must fail before any cleanup is armed.
mkdir -- "$restore_target"
restore_owned=true

remove_restore() {
  if [[ "$restore_owned" == true ]]; then
    restore_owned=false
    rm -rf -- "$restore_target"
    test ! -e "$restore_target" && test ! -L "$restore_target"
  fi
}

cleanup() {
  local status=$?
  remove_restore || status=1
  if [[ -n "$snapshot_metadata" ]]; then
    rm -f -- "$snapshot_metadata" || status=1
  fi
  if [[ -n "$marker_tmp" ]]; then
    rm -f -- "$marker_tmp" || status=1
  fi
  exit "$status"
}
trap cleanup EXIT

snapshot_metadata=$(mktemp "${RUNTIME_DIRECTORY}/.snapshot.XXXXXXXXXX")
restic -r "$REPO" --no-cache snapshots --tag vpn-stack --latest 1 --json > "$snapshot_metadata"

mapfile -t snapshot < <(python3 - "$snapshot_metadata" <<'PY'
import datetime as dt
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    snapshots = json.load(handle)
if not snapshots:
    raise SystemExit("no vpn-stack snapshot")
snapshot = snapshots[-1]
snapshot_time = dt.datetime.fromisoformat(snapshot["time"].replace("Z", "+00:00"))
age = dt.datetime.now(dt.timezone.utc) - snapshot_time.astimezone(dt.timezone.utc)
if age > dt.timedelta(hours=36):
    raise SystemExit(f"latest vpn-stack snapshot is stale: {age}")
print(snapshot["id"])
print(snapshot["time"])
PY
)
snapshot_id="${snapshot[0]:?snapshot id missing}"
snapshot_time="${snapshot[1]:?snapshot time missing}"

restic -r "$REPO" --no-cache restore "$snapshot_id" --target "$restore_target"

restored_path() {
  # Absolute links belong to the archived filesystem, never the live host.
  python3 - "$restore_target" "$1" <<'PY'
import os
import stat
import sys
from pathlib import Path, PurePosixPath

root = Path(sys.argv[1]).resolve(strict=True)
pending = list(PurePosixPath(sys.argv[2]).parts)
parts = []
links = 0
try:
    while pending:
        part = pending.pop(0)
        if part in ('', '.'):
            continue
        if part == '/' or (part == '..' and not parts):
            raise ValueError
        if part == '..':
            parts.pop()
            continue
        candidate = root.joinpath(*parts, part)
        info = candidate.lstat()
        if stat.S_ISLNK(info.st_mode):
            links += 1
            if links > 40:
                raise ValueError
            target = PurePosixPath(os.readlink(candidate))
            if target.is_absolute():
                parts = []
                target = target.relative_to('/')
            pending = list(target.parts) + pending
        else:
            parts.append(part)
    print(root.joinpath(*parts))
except (OSError, ValueError):
    raise SystemExit('restore drill: required artifact unavailable in snapshot') from None
PY
}

require_file() {
  local relative_path="$1"
  local artifact
  artifact="$(restored_path "$relative_path")" || return 1
  if [[ ! -f "$artifact" || ! -s "$artifact" ]]; then
    echo "restore drill: required artifact missing or empty: $relative_path" >&2
    return 1
  fi
}

require_regular_file() {
  local artifact
  artifact="$(restored_path "$1")" || return 1
  [[ -f "$artifact" ]] || return 1
}

require_directory() {
  local artifact
  artifact="$(restored_path "$1")" || return 1
  [[ -d "$artifact" ]] || return 1
}

validate_json() {
  local artifact
  artifact="$(restored_path "$1")" || return 1
  python3 -m json.tool "$artifact" >/dev/null
}

require_nonempty_directory() {
  local relative_path="$1"
  local artifact
  artifact="$(restored_path "$relative_path")" || return 1
  if [[ ! -d "$artifact" ]] ||
     ! find "$artifact" -maxdepth 1 -type f -size +0c -print -quit | grep -q .; then
    echo "restore drill: required artifact directory empty: $relative_path" >&2
    return 1
  fi
}

require_file "etc/nftables.conf"
require_file "etc/ssh/sshd_config.d/20-ansible-hardening.conf"
require_file "etc/sysctl.d/90-vpn.conf"
require_nonempty_directory "etc/systemd/system"

require_file "etc/xray/config.json"
validate_json "etc/xray/config.json"


require_file "etc/nginx/sites-available/vpn-xhttp.conf"
require_file "etc/nginx/tls/vpn.example.com.fullchain.pem"
require_file "etc/nginx/tls/vpn.example.com.key"



require_file "etc/hysteria/config.yaml"
require_file "etc/hysteria/server.fullchain.pem"
require_file "etc/hysteria/server.key"




require_file "etc/amnezia/amneziawg/awg0.conf"





require_nonempty_directory "etc/nginx"


















require_file "etc/vpn-watchdog.env"
require_file "etc/vpn-watchdog-notifications.json"

require_file "etc/vpn-watchdog-reality.json"



# Restored files contain live credentials. Remove and verify cleanup before
# publishing any success signal.
remove_restore
rm -f -- "$snapshot_metadata"
snapshot_metadata=""

marker_tmp=$(mktemp "${STATE_DIRECTORY}/.restore-drill-last-success.json.XXXXXXXXXX")
python3 - "$marker_tmp" "$marker" "$REPOSITORY_SOURCE" "$snapshot_id" "$snapshot_time" <<'PY'
import datetime as dt
import json
import os
import sys

path, marker_path, repository_source, snapshot_id, snapshot_time = sys.argv[1:]
payload = {
    "version": 1,
    "repository_source": repository_source,
    "snapshot_id": snapshot_id,
    "snapshot_time": snapshot_time,
    "verified_at": dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z"),
}
with open(path, "w", encoding="utf-8") as handle:
    json.dump(payload, handle, sort_keys=True)
    handle.write("\n")
os.chmod(path, 0o600)
# Atomic replacement never treats a directory (or its symlink) as a container.
os.replace(path, marker_path)
PY
marker_tmp=""
echo "restore drill: verified snapshot ${snapshot_id:0:8} from ${REPOSITORY_SOURCE} repository"
