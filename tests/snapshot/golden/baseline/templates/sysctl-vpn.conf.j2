# TCP performance tuning for proxy traffic.
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_mtu_probing = 1

# The declared VPN transports do not use Multipath TCP.
net.mptcp.enabled = 0

# Queue discipline and BBR availability are optional; hardening remains mandatory.
-net.core.default_qdisc = fq
-net.ipv4.tcp_congestion_control = bbr

# Optional socket performance support; mandatory hardening below stays fatal.
-net.core.rmem_max = 7500000
-net.core.wmem_max = 7500000

# Spoof protection
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1

# Forwarding overrides for AWG and split-hop egress live in 91-vpn-forward.conf.
net.ipv4.ip_forward = 0
net.ipv6.conf.all.forwarding = 0

# Connection budget (Hysteria + many concurrent VLESS streams)
net.core.somaxconn = 4096
net.ipv4.tcp_max_syn_backlog = 4096
# Above the per-unit LimitNOFILE (1048576) so one transport cannot take every host descriptor.
fs.file-max = 2097152

# Connection tracking budget for NAT and stateful filtering. The kernel default
# follows memory size (7680 entries on a 1 GiB host). The keys exist only while
# nf_conntrack is loaded, so they are optional here; the role loads the module
# and modules-load.d loads it before systemd-sysctl at boot.
-net.netfilter.nf_conntrack_buckets = 32768
-net.netfilter.nf_conntrack_max = 131072
-net.netfilter.nf_conntrack_udp_timeout = 60
-net.netfilter.nf_conntrack_udp_timeout_stream = 180

# IPv6: keep RA off by default; if the host has only IPv4, no harm done
net.ipv6.conf.default.accept_ra = 0
net.ipv6.conf.all.accept_ra = 0

# Kernel hardening
fs.protected_hardlinks = 1
fs.protected_symlinks = 1
fs.suid_dumpable = 0
kernel.sysrq = 0
kernel.core_uses_pid = 1
kernel.randomize_va_space = 2
kernel.kptr_restrict = 2
kernel.yama.ptrace_scope = 2
kernel.unprivileged_userns_clone = 0
# Unprivileged BPF is disabled on the supported kernels, so level 2 is the
# only JIT hardening level that has an effect.
net.core.bpf_jit_harden = 2
# One-way until reboot; no component loads a kernel image at runtime.
kernel.kexec_load_disabled = 1
