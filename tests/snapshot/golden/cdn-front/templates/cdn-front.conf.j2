# Cloudflare-fronted nginx vhost for Xray XHTTP. See
# docs/decisions/0001-cdn-not-filtered-path-baseline.md for the threat-model boundary on when CDN is
# worth running.

server {
    # Trust applies only to this CDN-facing listener.
    include /etc/cdn-front/cloudflare.real_ip;

    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;

    server_name {{ nginx_xhttp.server_name }};

    server_tokens off;

    ssl_certificate     /etc/nginx/tls/{{ nginx_xhttp.server_name }}.fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/{{ nginx_xhttp.server_name }}.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;


    # XHTTP upstream — proxy_pass to the Xray localhost inbound. nginx
    # rewrites X-Forwarded-For from CF-Connecting-IP via the real-IP
    # restoration above, so Xray sees the visitor IP, not the CF egress.
    location {{ xray.xhttp_path }} {
        proxy_pass http://127.0.0.1:10085;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        access_log off;
        error_log /dev/null crit;
        # Streaming-friendly: stream-up needs an unbuffered, unbounded request body.
        client_max_body_size 0;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
    }

    # Any other path gets an ordinary 404. A silent close after the handshake
    # marks the origin for an active probe. The page is nginx's own, not the
    # public site's: a shared body would link this name to the direct site.
    location / {
        return 404;
    }
}
