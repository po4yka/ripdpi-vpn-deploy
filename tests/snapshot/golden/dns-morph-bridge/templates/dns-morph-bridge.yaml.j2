# Managed by Ansible role `dns-morph-bridge`. Hand edits will be overwritten.
#
# Role-owned daemon input contract. The operator-supplied binary must accept
# these fields; render checks do not establish protocol compatibility.

listen:
  address: "0.0.0.0"
  port: 53

forward:
  # Active-probing-defense path. Every query that does not match the
  # DNS-Morph handshake shape is forwarded verbatim to the localhost
  # responder, which returns local authoritative answers or REFUSED.
  address: "127.0.0.1"
  port: 5353
  protocol: udp

morph:
  # Per-bridge private Ed25519 seed (32 bytes, canonical padded base64).
  # Clients pin its derived public key in their
  # bootstrap config. Rotation invalidates every issued client config.
  signing_key: "REPLACE_WITH_ED25519_BASE64_OR_LEAVE_BLANK_IF_DISABLED"

  # Where decoded fragments egress to. Empty string requires explicit
  # dns_morph_bridge_allow_echo_only for isolated tests.
  upstream_endpoint: ""

limits:
  # Per-minute cap on the active-probing-defense path (handshake-shaped
  # queries are exempt). See defaults/main.yml for the disk-fill rationale.
  events_per_minute_max: 5000

log:
  dir: "/var/log/dns-morph-bridge"
