[Unit]
Description=Refresh Xray geodata
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vpn-geodata-refresh.sh

# Hardening floor for a root oneshot: strict read-only filesystem view,
# private tmp, no privilege escalation or kernel surfaces. The only
# writable surfaces are the selected assets and private acceptance journal.
# The shared generation controller owns service/process and policy mutation.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=/usr/local/share/xray

ReadWritePaths=/var/lib/ripdpi/transport-runtime
# The exact native parser initializes its declared frontend-owned log file.
ReadWritePaths=-/var/log/xray
# Admission reads that UID's executable/log authority and verifies kernel policy.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_NET_ADMIN
