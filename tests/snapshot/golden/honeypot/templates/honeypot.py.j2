#!/usr/bin/env python3
"""Active-probing canary listener.

Accepts every TCP connection on the configured port, reads the first
up-to-512 bytes (which is the TLS ClientHello for HTTPS probes), then
closes. Logs:

  * one JSON line per connection to /var/log/honeypot/connections.log
  * a Prometheus textfile under {{ (monitoring | default({})).node_exporter_textfile_dir | default('/var/lib/node_exporter/textfile') }} with rolling
    per-minute counters

The point isn't to be a "good" honeypot — it's to count probe events
and surface SNI / source-IP / timing distribution. A spike here often
precedes TSPU mass-probing the real REALITY port; the watchdog's
active_probing class detects it on the production side, this one
detects it on the canary port before pivot.

Managed by Ansible role honeypot; do not hand-edit.
"""
from __future__ import annotations

import json
import logging
import pathlib
import socket
import struct
import sys
import threading
import time
from collections import deque

LISTEN_ADDR = "{{ honeypot_listen_addr | default('0.0.0.0') }}"
LISTEN_PORT = 4443
LISTEN_IPV6 = False
LOG_DIR = pathlib.Path("/var/log/honeypot")
TEXTFILE_DIR = pathlib.Path("{{ (monitoring | default({})).node_exporter_textfile_dir | default('/var/lib/node_exporter/textfile') }}")
EVENTS_PER_MINUTE_MAX = 1000
MAX_CONCURRENT_CONNECTIONS = 64
# Total per-connection budget measured from accept time. A per-recv
# timeout resets on every delivered chunk, so a reader dribbling one
# byte per interval could pin a worker slot indefinitely; the absolute
# monotonic deadline bounds the slot-hold instead.
CONNECTION_DEADLINE_SECONDS = 10
# Cap unique-IP and unique-SNI sets to avoid unbounded memory growth
# under mass-scan conditions (mirrors the bounded _recent_minutes deque).
UNIQUE_SETS_MAX = 50000

logging.basicConfig(
    format="honeypot[%(process)d]: %(levelname)s %(message)s",
    level=logging.INFO, stream=sys.stderr,
)

LOG_DIR.mkdir(parents=True, exist_ok=True)
TEXTFILE_DIR.mkdir(parents=True, exist_ok=True)

_events_lock = threading.Lock()
_workers = threading.BoundedSemaphore(MAX_CONCURRENT_CONNECTIONS)
_recent_minutes: deque[tuple[int, int]] = deque(maxlen=60)  # (minute_epoch, count)
_total_events = 0
_unique_ips: set[str] = set()
_unique_snis: set[str] = set()
_slot_exhaustion_drops = 0
_input_errors_total = 0
_reported_input_errors = 0


def _record_input_error() -> None:
    """Record a bounded producer error without exporting error details."""
    global _input_errors_total
    with _events_lock:
        _input_errors_total += 1


def _prune_recent_minutes(now_min: int) -> None:
    """Keep only calendar minutes in [now-59, now]. Caller holds _events_lock."""
    oldest_min = now_min - 59
    while _recent_minutes and _recent_minutes[0][0] < oldest_min:
        _recent_minutes.popleft()
    # A backward wall-clock adjustment must not leave future buckets visible.
    while _recent_minutes and _recent_minutes[-1][0] > now_min:
        _recent_minutes.pop()


def _extract_sni(buf: bytes) -> str | None:
    """Quick-and-dirty SNI parse. Returns None on anything malformed."""
    try:
        if len(buf) < 5 or buf[0] != 0x16:  # not a handshake record
            return None
        # Skip record header (5) + handshake type/len/version/random (4+2+32) + session id
        i = 5 + 4 + 2 + 32
        if i + 1 > len(buf): return None
        sid_len = buf[i]; i += 1 + sid_len
        if i + 2 > len(buf): return None
        cs_len = struct.unpack(">H", buf[i:i+2])[0]; i += 2 + cs_len
        if i + 1 > len(buf): return None
        cm_len = buf[i]; i += 1 + cm_len
        if i + 2 > len(buf): return None
        ext_total = struct.unpack(">H", buf[i:i+2])[0]; i += 2
        end = min(i + ext_total, len(buf))
        while i + 4 <= end:
            ext_type = struct.unpack(">H", buf[i:i+2])[0]
            ext_len = struct.unpack(">H", buf[i+2:i+4])[0]; i += 4
            if ext_type == 0:  # server_name
                if i + 5 > len(buf): return None
                name_len = struct.unpack(">H", buf[i+3:i+5])[0]
                return buf[i+5:i+5+name_len].decode("ascii", errors="replace")
            i += ext_len
    except Exception:
        return None
    return None


def _flush_textfile() -> None:
    """Write a fresh prom textfile reflecting the rolling counters."""
    global _reported_input_errors
    now_min = int(time.time()) // 60
    with _events_lock:
        _prune_recent_minutes(now_min)
        per_min = list(_recent_minutes)
        total = _total_events
        unique_ips = len(_unique_ips)
        unique_snis = len(_unique_snis)
        slot_drops = _slot_exhaustion_drops
        input_errors = _input_errors_total
        reported_input_errors = _reported_input_errors
    out = TEXTFILE_DIR / "vpn_honeypot.prom"
    tmp = out.with_suffix(".prom.tmp")
    last_minute_count = (
        per_min[-1][1] if per_min and per_min[-1][0] == now_min else 0
    )
    sixty_minute_count = sum(c for _, c in per_min)
    error_state = "error" if input_errors > reported_input_errors else "ok"
    lines = [
        "# HELP vpn_honeypot_collection_success Whether the latest detector publication completed",
        "# TYPE vpn_honeypot_collection_success gauge",
        "vpn_honeypot_collection_success 1",
        "# HELP vpn_honeypot_last_success_timestamp_seconds Unix timestamp of the latest detector publication",
        "# TYPE vpn_honeypot_last_success_timestamp_seconds gauge",
        f"vpn_honeypot_last_success_timestamp_seconds {int(time.time())}",
        "# HELP vpn_honeypot_input_progress_total Accepted detector inputs since service start",
        "# TYPE vpn_honeypot_input_progress_total counter",
        f"vpn_honeypot_input_progress_total {total}",
        "# HELP vpn_honeypot_input_errors_total Bounded input processing errors since service start",
        "# TYPE vpn_honeypot_input_errors_total counter",
        f"vpn_honeypot_input_errors_total {input_errors}",
        "# HELP vpn_honeypot_error_state Whether the detector has observed an input processing error",
        "# TYPE vpn_honeypot_error_state gauge",
        'vpn_honeypot_error_state{state="' + error_state + '"} 1',
        "# HELP vpn_honeypot_events_total Total probe events seen since service start",
        "# TYPE vpn_honeypot_events_total counter",
        f"vpn_honeypot_events_total {total}",
        "# HELP vpn_honeypot_events_last_minute Events in the current calendar minute",
        "# TYPE vpn_honeypot_events_last_minute gauge",
        f"vpn_honeypot_events_last_minute {last_minute_count}",
        "# HELP vpn_honeypot_events_60min Events in the most recent 60 minutes",
        "# TYPE vpn_honeypot_events_60min gauge",
        f"vpn_honeypot_events_60min {sixty_minute_count}",
        "# HELP vpn_honeypot_unique_ips Cumulative unique source IPs seen",
        "# TYPE vpn_honeypot_unique_ips gauge",
        f"vpn_honeypot_unique_ips {unique_ips}",
        "# HELP vpn_honeypot_unique_snis Cumulative unique SNIs seen",
        "# TYPE vpn_honeypot_unique_snis gauge",
        f"vpn_honeypot_unique_snis {unique_snis}",
        "# HELP vpn_honeypot_slot_exhaustion_drops_total Connections closed because every worker slot was busy",
        "# TYPE vpn_honeypot_slot_exhaustion_drops_total counter",
        f"vpn_honeypot_slot_exhaustion_drops_total {slot_drops}",
    ]
    tmp.write_text("\n".join(lines) + "\n")
    tmp.replace(out)
    with _events_lock:
        _reported_input_errors = max(_reported_input_errors, input_errors)


def _bump(source_ip: str, sni: str | None) -> bool:
    """Returns True if this event is below the per-minute cap, False to drop."""
    global _total_events
    now_min = int(time.time()) // 60
    with _events_lock:
        _prune_recent_minutes(now_min)
        if not _recent_minutes or _recent_minutes[-1][0] != now_min:
            _recent_minutes.append((now_min, 0))
        cur_min_count = _recent_minutes[-1][1]
        if cur_min_count >= EVENTS_PER_MINUTE_MAX:
            return False
        _recent_minutes[-1] = (now_min, cur_min_count + 1)
        _total_events += 1
        if len(_unique_ips) < UNIQUE_SETS_MAX:
            _unique_ips.add(source_ip)
        if sni and len(_unique_snis) < UNIQUE_SETS_MAX:
            _unique_snis.add(sni)
    return True


def _flush_loop() -> None:
    while True:
        time.sleep(15)
        try:
            _flush_textfile()
        except Exception as exc:
            logging.warning("textfile flush failed: %s", exc)


def _handle(conn: socket.socket, addr: tuple) -> None:
    src_ip, src_port = addr[0], addr[1]
    # Absolute monotonic deadline computed at accept time. Each recv is
    # capped by the remaining budget, so a reader dribbling one byte per
    # interval cannot reset its own timeout and pin this slot forever.
    deadline = time.monotonic() + CONNECTION_DEADLINE_SECONDS
    buf = b""
    try:
        while len(buf) < 512:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break  # total slot-hold budget exhausted
            conn.settimeout(remaining)
            chunk = conn.recv(512 - len(buf))
            if not chunk:
                break
            buf += chunk
    except socket.timeout:
        pass  # deadline reached mid-read
    except Exception as exc:
        _record_input_error()
        logging.debug("recv error from %s: %s", src_ip, exc)
    finally:
        try: conn.close()
        except Exception: pass

    sni = _extract_sni(buf) if buf else None
    if not _bump(src_ip, sni):
        return  # dropped by per-minute cap

    event = {
        "ts": int(time.time()),
        "src_ip": src_ip,
        "src_port": src_port,
        "bytes": len(buf),
        "sni": sni,
        "first16_hex": buf[:16].hex() if buf else "",
    }
    try:
        with (LOG_DIR / "connections.log").open("a") as fh:
            fh.write(json.dumps(event) + "\n")
    except OSError as exc:
        _record_input_error()
        logging.warning("event log write failed: %s", exc)


def _create_listener_sockets() -> list[socket.socket]:
    """Bind every enabled address family before reporting startup success."""
    specs = [(socket.AF_INET, LISTEN_ADDR)]
    if LISTEN_IPV6:
        specs.append((socket.AF_INET6, "::"))
    listeners: list[socket.socket] = []
    try:
        for family, address in specs:
            listener = socket.socket(family, socket.SOCK_STREAM)
            listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            if family == socket.AF_INET6:
                listener.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
            listener.bind((address, LISTEN_PORT))
            listener.listen(128)
            listeners.append(listener)
    except Exception:
        for listener in listeners:
            listener.close()
        raise
    return listeners


def _accept_loop(listener: socket.socket) -> None:
    global _slot_exhaustion_drops
    address = listener.getsockname()[0]
    logging.info("honeypot listening on %s:%d", address, LISTEN_PORT)
    while True:
        conn, addr = listener.accept()
        if not _workers.acquire(blocking=False):
            # Slot exhaustion: count the drop instead of closing silently.
            with _events_lock:
                _slot_exhaustion_drops += 1
            conn.close()
            continue
        def worker(conn: socket.socket = conn, addr: tuple = addr) -> None:
            try:
                _handle(conn, addr)
            finally:
                _workers.release()
        threading.Thread(target=worker, daemon=True).start()


def main() -> None:
    threading.Thread(target=_flush_loop, daemon=True).start()
    listeners = _create_listener_sockets()
    for listener in listeners[1:]:
        threading.Thread(target=_accept_loop, args=(listener,), daemon=True).start()
    _accept_loop(listeners[0])


if __name__ == "__main__":
    main()
