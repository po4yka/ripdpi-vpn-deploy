{
  "log": {
    "level": "warn",
    "output": "/var/log/hysteria-realm/sing-box.log",
    "timestamp": true
  },
  "services": [
    {
      "type": "hysteria-realm",
      "tag": "realm",
      "listen": "::",
      "listen_port": 8444,
      "tcp_fast_open": false,
      "users": [{
        "name": "realm-control",
        "token": "REPLACE_WITH_LONG_RANDOM_REALM_AUTH_TOKEN",
        "max_realms": 16
      }],
      "tls": {
        "enabled": true,
        "server_name": "{{ nginx_xhttp.server_name | default('vpn.example.com') }}",
        "certificate_path": "{{ hysteria_realm.config_dir }}/server.fullchain.pem",
        "key_path": "{{ hysteria_realm.config_dir }}/server.key",
        "alpn": ["h2", "http/1.1"]
      }
    }
  ]
}
