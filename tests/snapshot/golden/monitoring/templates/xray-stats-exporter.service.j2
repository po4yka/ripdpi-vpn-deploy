[Unit]
Description=Export redacted Xray StatsService counters
After=xray.service
# Requisite, not Requires: a timer run must fail, never start an Xray that was stopped on purpose.
Requisite=xray.service

[Service]
Type=oneshot
User=prometheus
Group=prometheus
SupplementaryGroups=node_exporter_textfile
ExecStart=/usr/local/sbin/xray-stats-exporter --server 127.0.0.1:10086 --output /var/lib/node_exporter/textfile/vpn_xray.prom

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/node_exporter/textfile
