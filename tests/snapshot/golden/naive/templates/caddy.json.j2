{
  "logging": {
    "logs": {
      "default": {
        "writer": {"output": "file", "filename": "/var/log/naive/access.log"},
        "level": "INFO",
        "exclude": ["http.log.access.log0"]
      },
      "log0": {
        "writer": {"output": "file", "filename": "/var/log/naive/site-error.log"},
        "level": "ERROR",
        "include": ["http.log.access.log0"]
      }
    }
  },
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [":443"],
          "protocols": ["h1", "h2"],
          "automatic_https": {"disable": true},
          "tls_connection_policies": [{"certificate_selection": {"any_tag": ["cert0"]}}],
          "logs": {"default_logger_name": "log0"},
          "routes": [{"handle": [
            {"handler": "encode", "encodings": {"gzip": {}, "zstd": {}}, "prefer": ["zstd", "gzip"]},
            {"handler": "subroute", "routes": [{"handle": [

              {
                "handler": "forward_proxy",
                "auth_credentials": [

                  "Y0dodmJtVTZVa1ZRVEVGRFJWOVhTVlJJWDFCRlVsOUVSVlpKUTBWZlRrRkpWa1ZmVUVGVFUxZFBVa1E9"

                ],
                "hide_ip": true,
                "hide_via": true,
                "probe_resistance": {"domain": "REPLACE_WITH_LONG_RANDOM"}
              },

              {"handler": "file_server", "root": "/var/www/naive-decoy", "hide": ["/etc/naive/caddy.json", "/etc/naive/server.key", "/etc/naive/server.fullchain.pem"]}
            ]}]}
          ]}]
        }
      }
    },
    "tls": {
      "certificates": {
        "load_files": [{
          "certificate": "/etc/naive/server.fullchain.pem",
          "key": "/etc/naive/server.key",
          "tags": ["cert0"]
        }]
      }
    }
  }
}
