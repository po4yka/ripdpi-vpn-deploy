# Managed by Ansible role `nginx-xhttp`. Direct (no CDN) baseline.
# CDN-fronted variant lives in docs/decisions/0001-cdn-not-filtered-path-baseline.md as opt-in.






# Combined field layout without the client address, referer or user agent, so
# status-column tooling (awk '$9') keeps working on these logs.
log_format vpn_public '- - - [$time_local] "$request" $status $body_bytes_sent "-" "-"';

server {
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;

    server_name vpn.example.com;

    server_tokens off;
    root /var/www/public-site;
    index index.html;

    ssl_certificate     /etc/nginx/tls/vpn.example.com.fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/vpn.example.com.key;

    ssl_protocols       TLSv1.3;
    ssl_ecdh_curve      X25519;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:vpn:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=0" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;



    # XHTTP path → Xray localhost inbound
    location /REPLACE_WITH_PRIVATE_XHTTP_PATH/ {
        access_log off;
        error_log /dev/null crit;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";

        # Upstream refusals and an absent upstream answer as the ordinary site
        # 404, so a probe sees one identity whether or not Xray is running.
        proxy_intercept_errors on;
        error_page 404 502 503 504 =404 /404.html;

        # Streaming-friendly
        client_max_body_size 0;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_pass http://127.0.0.1:10085;
    }

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    location = /feed.xml {
        types { }
        default_type application/atom+xml;
        try_files $uri =404;
    }

    # Public site for ordinary browser and scanner requests.
    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/vpn-xhttp.access.log vpn_public;
    error_log  /var/log/nginx/vpn-xhttp.error.log warn;
}



# HTTP → HTTPS redirect (so the host looks like a normal website)
server {
    listen 80;
    listen [::]:80;
    server_name vpn.example.com;
    server_tokens off;
    # The redirected path can carry a bearer token; never log it.
    access_log off;
    error_log /dev/null crit;
    return 301 https://$host:8443$request_uri;
}
