# Managed by Ansible role `nginx-xhttp`. Direct (no CDN) baseline.
# CDN-fronted variant lives in docs/decisions/0001-cdn-not-filtered-path-baseline.md as opt-in.
# Keep the status column and omit request URIs, including alternate encodings.
log_format vpn_public '- - - [$time_local] "$request_method - $server_protocol" $status $body_bytes_sent "-" "-"';

# The original URI is still available when the final location is an error page.
map $request_uri $vpn_public_loggable {
    ~^/routing/ 0;
    ~^/REPLACE_WITH_PRIVATE_XHTTP_PATH(?:/|\?|$) 0;
    default 1;
}

server {
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;

    server_name vpn.example.com;

    server_tokens off;
    root /var/www/public-site;
    index index.html;

    ssl_certificate     /etc/nginx/tls/vpn.example.com.fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/vpn.example.com.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ecdh_curve      X25519:prime256v1:secp384r1;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:vpn:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=0" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;


    # Without this exact match nginx answers the path without its trailing
    # slash with a 301, which tells a probe that the prefix is routed.
    location = /REPLACE_WITH_PRIVATE_XHTTP_PATH {
        access_log off;
        error_log /dev/null crit;
        return 404;
    }

    # XHTTP path → Xray localhost inbound
    location /REPLACE_WITH_PRIVATE_XHTTP_PATH/ {
        access_log off;
        error_log /dev/null crit;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";

        # Upstream refusals and an absent upstream answer as the ordinary site
        # 404, so a probe sees one identity whether or not Xray is running.
        proxy_intercept_errors on;
        error_page 400 401 403 404 405 408 409 413 429 500 501 502 503 504 =404 /404.html;

        # Streaming-friendly
        client_max_body_size 0;
        client_body_timeout 3600s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_pass http://127.0.0.1:10085;
    }

    error_page 404 /404.html;

    location = /404.html {
        # The server's URI filter also applies after this redirect.
        internal;
    }

    location = /feed.xml {
        types { }
        default_type application/atom+xml;
        try_files $uri =404;
    }

    # Refreshed by model-news.timer outside the published site tree; the page
    # uses the bundled identity, so an operator-owned site never serves it.
    location = /news.html {
        root /var/lib/model-news;
        try_files $uri =404;
    }

    # Public site for ordinary browser and scanner requests.
    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/vpn-xhttp.access.log vpn_public if=$vpn_public_loggable;
    error_log  /var/log/nginx/vpn-xhttp.error.log warn;
}

# Plain HTTP for the primary host (so the host looks like a normal website)
server {
    listen 80;
    listen [::]:80;
    server_name vpn.example.com;
    server_tokens off;
    # A client can send any bearer path over HTTP; never log it.
    access_log off;
    error_log /dev/null crit;
    root /var/www/public-site;
    index index.html;
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
    location / {
        try_files $uri $uri/ =404;
    }
}

# A handshake without SNI or with a foreign name, such as a scan of the node
# address, is refused before any certificate is sent, so the address does not
# disclose the hostname. A request that carries the right SNI and another Host
# gets the site's ordinary 404 page and never reaches the XHTTP path.
server {
    listen 8443 ssl http2 default_server;
    listen [::]:8443 ssl http2 default_server;
    server_name _;
    ssl_reject_handshake on;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ecdh_curve      X25519:prime256v1:secp384r1;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:vpn:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    root /var/www/public-site;
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
    location / {
        return 404;
    }
}

# Any other Host, such as the node address, gets the site's ordinary 404 page.
# This file is the only owner of the default server: its transaction retires the
# packaged default site, which the earlier managed-TLS publication does not.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    root /var/www/public-site;
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
    location / {
        return 404;
    }
}
