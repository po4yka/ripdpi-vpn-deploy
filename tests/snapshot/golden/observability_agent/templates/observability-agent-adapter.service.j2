[Unit]
Description=RIPDPI schema-2 observability manifest adapter
After=node-manifest.service

[Service]
Type=oneshot
User=prometheus
Group=prometheus
SupplementaryGroups=node_exporter_textfile
ExecStart=/usr/local/libexec/observability-agent-adapter.py --manifest /var/lib/ripdpi-vpn-deploy/manifest.json --output /var/lib/node_exporter/textfile/observability-agent.prom --node-id  --expected-source-revision 1111111111111111111111111111111111111111 --expected-deployable-digest 2222222222222222222222222222222222222222222222222222222222222222
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=64M
TasksMax=16
LimitNOFILE=1024
ReadWritePaths=/var/lib/node_exporter/textfile
