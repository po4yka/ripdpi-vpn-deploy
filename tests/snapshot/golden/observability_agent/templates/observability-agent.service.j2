[Unit]
Description=RIPDPI bounded observability remote-write agent
After=network-online.target
Wants=network-online.target

[Service]
Slice=observability-agent.slice
Type=simple
User=observability-agent
Group=observability-agent
LoadCredential=client.crt:/etc/observability-agent/credentials/generations/3333333333333333333333333333333333333333333333333333333333333333/client.crt
LoadCredential=client.key:/etc/observability-agent/credentials/generations/3333333333333333333333333333333333333333333333333333333333333333/client.key
LoadCredential=receiver-ca.crt:/etc/observability-agent/credentials/generations/3333333333333333333333333333333333333333333333333333333333333333/receiver-ca.crt
LoadCredential=prometheus.yml:/etc/observability-agent/credentials/generations/3333333333333333333333333333333333333333333333333333333333333333/prometheus.yml
WorkingDirectory=%d
ExecStart=/usr/local/bin/vmagent-observability-agent -promscrape.config=%d/prometheus.yml -remoteWrite.url=https://100.64.0.2:9443/remote-write/v1/nodes/node-01 -remoteWrite.tlsCAFile=%d/receiver-ca.crt -remoteWrite.tlsCertFile=%d/client.crt -remoteWrite.tlsKeyFile=%d/client.key -remoteWrite.tlsServerName=100.64.0.2 -remoteWrite.forcePromProto=true -remoteWrite.queues=1 -remoteWrite.inmemoryQueues=0 -remoteWrite.keepDanglingQueues=true -remoteWrite.tmpDataPath=/var/lib/observability-agent/queue -remoteWrite.maxDiskUsagePerURL=536870912 -remoteWrite.maxRowsPerBlock=1000 -remoteWrite.maxBlockSize=1048576 -remoteWrite.flushInterval=5s -memory.allowedBytes=67108864 -maxLabelsPerTimeseries=16 -maxLabelNameLen=64 -maxLabelValueLen=128 -httpListenAddr=127.0.0.1:19090
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=192M
TasksMax=64
LimitNOFILE=65536
ReadWritePaths=/var/lib/observability-agent/queue
UMask=0077

[Install]
WantedBy=multi-user.target
