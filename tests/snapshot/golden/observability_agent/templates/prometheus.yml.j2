global:
  scrape_interval: 60s
  external_labels:
    environment: "staging"
    node: "node-01"

scrape_configs:
  - job_name: node-exporter
    sample_limit: 1800
    label_limit: 16
    static_configs:
      - targets: ["127.0.0.1:9100"]
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: "^(node_(cpu|memory|filesystem|time|boot|network|disk|filefd)_.*|node_load(1|5|15)|observability_push_.*|vpn_(xray_stats|observability_|watchdog_|backup_|certificate_|honeypot_|policy_ratelimit_|burn_).*)$"
        action: keep
      - source_labels: [mountpoint]
        regex: "^$|^/$"
        action: keep
      - source_labels: [device]
        regex: "^$|^(lo|eth[0-9]+|ens[0-9]+|enp[0-9a-z]+|vda[0-9]*|sda[0-9]*|nvme[0-9]+n[0-9]+p?[0-9]*)$"
        action: keep
      - regex: "^(__name__|job|cpu|mode|device|fstype|mountpoint|node|role|state|kind)$"
        action: labelkeep
  - job_name: node-exporter-required-services
    sample_limit: 150
    label_limit: 16
    static_configs:
      - targets: ["127.0.0.1:9100"]
    metric_relabel_configs:
      - source_labels: [__name__, name, state]
        regex: "^node_systemd_unit_state;(caddy-naive[.]service|hysteria-server[.]service|nginx[.]service|observability-agent[.]service|observability-alertmanager[.]service|observability-disk-guard[.]service|observability-ingress[.]service|observability-prometheus[.]service|xray[.]service);(active|failed)$"
        action: keep
      - regex: "^(__name__|job|name|state)$"
        action: labelkeep
  - job_name: observability-agent
    sample_limit: 50
    label_limit: 16
    static_configs:
      - targets: ["127.0.0.1:19090"]
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: "^(process_(cpu_seconds_total|resident_memory_bytes|open_fds|max_fds|start_time_seconds)|go_(goroutines|threads)|vm_rows_ignored_total|vmagent_remotewrite_(pending_data_bytes|pending_inmemory_blocks|queue_blocked|errors_total|packets_dropped_total|samples_dropped_total|retries_count_total|bytes_sent_total|blocks_sent_total)|vm_persistentqueue_(bytes_pending|bytes_dropped_total|blocks_dropped_total|bytes_written_total|blocks_written_total|bytes_read_total|blocks_read_total))$"
        action: keep
      - source_labels: [__name__, reason]
        regex: "^(vm_rows_ignored_total;(too_long_label_name|too_long_label_value|too_many_labels)|[^;]+;)$"
        action: keep
      - regex: "^(__name__|job|reason)$"
        action: labelkeep
