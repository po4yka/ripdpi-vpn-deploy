global:
  resolve_timeout: 3m
route:
  receiver: telegram-primary
  group_by: [alertname, environment, node, component, policy, profile, vantage, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 6h
  routes:
    - receiver: telegram-critical
      matchers: ['severity="critical"']
      repeat_interval: 1h
    - receiver: telegram-primary
      matchers: ['severity="warning"']
      repeat_interval: 6h

receivers:
  - name: telegram-primary
    webhook_configs:
      - url: http://127.0.0.1:19095/alert
        send_resolved: true
        max_alerts: 5
        timeout: 20s
        http_config:
          authorization:
            type: Bearer
            credentials_file: /run/credentials/observability-alertmanager.service/telegram-relay-auth-token
  - name: telegram-critical
    webhook_configs:
      - url: http://127.0.0.1:19095/alert
        send_resolved: true
        max_alerts: 5
        timeout: 20s
        http_config:
          authorization:
            type: Bearer
            credentials_file: /run/credentials/observability-alertmanager.service/telegram-relay-auth-token

inhibit_rules:
  - source_matchers: ['alertname="ObservabilityBackupStageFailed"']
    target_matchers: ['alertname="ObservabilityBackupEvidenceStale"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityNodeDiskSpaceCritical"']
    target_matchers: ['alertname="ObservabilityNodeDiskSpaceLow"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityNodeInodesCritical"']
    target_matchers: ['alertname="ObservabilityNodeInodesLow"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityCertificateExpiresCritical"']
    target_matchers: ['alertname="ObservabilityCertificateExpiresSoon"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityDetectorEvidenceStale"']
    target_matchers: ['alertname="ObservabilityDetectorInputStalled"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityDetectorCollectionFailed"']
    target_matchers: ['alertname="ObservabilityDetectorEvidenceStale"']
    equal: [environment, node, component]
  - source_matchers: ['alertname="ObservabilityDetectorCollectionFailed"']
    target_matchers: ['alertname="ObservabilityDetectorInputStalled"']
    equal: [environment, node, component]
