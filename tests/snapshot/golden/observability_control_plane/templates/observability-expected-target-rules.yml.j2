groups:
  - name: observability_expected_targets
    rules:
      - alert: ObservabilityExpectedTargetMissing
        expr: >-
          vpn_observability_expected_target
          unless on (node, role)
          (
          vector(0)
          )
        for: 3m
        labels:
          severity: warning
          component: expected-target
          environment: "staging"
        annotations:
          incident_family: expected-target-absence
          evidence_class: no-required-family
          source_generation: ""
          summary: An expected target publishes no required metrics.
          runbook: docs/how-to/monitoring-alerts.md#expected-target-absence
          action: "The target sends no data. Check its agent and its private path to the collector."
      - alert: ObservabilityTargetEvidenceStale
        expr: vpn_observability_evidence_state{state="stale"} == 1
        for: 3m
        labels:
          severity: warning
          component: expected-target
          environment: "staging"
        annotations:
          incident_family: target-evidence-freshness
          evidence_class: stale-evidence
          source_generation: ""
          summary: Target evidence is stale.
          runbook: docs/how-to/monitoring-alerts.md#target-evidence-freshness
          action: "Check the agent and adapter timers on this target."
      - alert: ObservabilitySourceIdentityMismatch
        expr: >-
          (vpn_observability_node_manifest_identity{state="mismatch"} == 1)
          or
          (vpn_observability_evidence_state{role=~"source-revision|deployable-digest",state="mismatch"} == 1)
        for: 3m
        labels:
          severity: warning
          component: expected-target
          environment: "staging"
        annotations:
          incident_family: source-identity
          evidence_class: identity-mismatch
          source_generation: ""
          summary: Node runs a different source revision or deployable digest than expected.
          runbook: docs/how-to/monitoring-alerts.md#source-identity
          action: "Expected during a rollout. If it persists after the deploy, run make verify for this node."
      - alert: ObservabilityControlPlaneResourceOrPipelineUnhealthy
        expr: >-
          vpn_observability_evidence_state{role=~"tsdb-capacity|expected-target-pipeline",state!="fresh"} == 1
        for: 3m
        labels:
          severity: warning
          component: expected-target
          environment: "staging"
        annotations:
          incident_family: control-plane-health
          evidence_class: resource-or-pipeline-unhealthy
          source_generation: ""
          summary: Control-plane capacity or expected-target pipeline is unhealthy.
          runbook: docs/how-to/monitoring-alerts.md#control-plane-health
          action: "Run make observability-status. Check collector disk use and the expected-target adapter."
