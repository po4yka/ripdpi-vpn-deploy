# Write-only ingestion. Prometheus, status and administrative APIs stay loopback-only.
limit_req_zone $ssl_client_s_dn zone=observability_remote_write_rate:10m rate=20r/s;
limit_conn_zone $ssl_client_s_dn zone=observability_remote_write_conn:10m;
limit_conn_zone $server_addr zone=observability_remote_write_total:1m;

map $ssl_client_s_dn $observability_remote_write_node {
    default "";

}

server {
    listen 100.64.0.2:9443 ssl http2;
    server_name 100.64.0.2;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_certificate /run/credentials/observability-ingress.service/server.crt;
    ssl_certificate_key /run/credentials/observability-ingress.service/server.key;
    ssl_client_certificate /run/credentials/observability-ingress.service/client-ca.crt;
    ssl_crl /run/credentials/observability-ingress.service/client.crl;
    ssl_verify_client on;
    client_max_body_size 8m;
    access_log off;
    error_log /dev/null crit;

    location ~ "^/remote-write/v1/nodes/([A-Za-z0-9][A-Za-z0-9_.-]{0,63})$" {
        if (-f /var/lib/observability-disk-guard/latched) { return 503; }
        if ($request_method != POST) { return 405; }
        if ($args != "") { return 400; }
        if ($ssl_client_verify != SUCCESS) { return 403; }
        if ($observability_remote_write_node = "") { return 403; }
        if ($observability_remote_write_node != $1) { return 403; }
        limit_conn observability_remote_write_conn 4;
        limit_conn observability_remote_write_total 4;
        limit_req zone=observability_remote_write_rate burst=40 nodelay;
        rewrite ^ /api/v1/write break;
        proxy_pass http://127.0.0.1:9090;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_http_version 1.1;
        proxy_set_header Host "127.0.0.1:9090";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_pass_request_headers off;
        proxy_set_header Content-Type $content_type;
        proxy_set_header Content-Encoding $http_content_encoding;
        proxy_set_header X-Prometheus-Remote-Write-Version $http_x_prometheus_remote_write_version;
    }


    location / { return 404; }
}
