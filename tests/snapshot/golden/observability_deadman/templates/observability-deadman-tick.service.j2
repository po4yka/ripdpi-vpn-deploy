[Unit]
Description=Evaluate independent observability dead-man and secondary route
After=observability-deadman.service

[Service]
Type=oneshot
User=observability-deadman
Group=observability-deadman
LoadCredential=pulse-token:/etc/observability-deadman/credentials/pulse-token
LoadCredential=telegram-bot-token:/etc/observability-deadman/credentials/telegram-bot-token
LoadCredential=reverse-health-ca:/etc/observability-deadman/credentials/reverse-health-ca.pem
LoadCredential=reverse-health-client-cert:/etc/observability-deadman/credentials/reverse-health-client.crt
LoadCredential=reverse-health-client-key:/etc/observability-deadman/credentials/reverse-health-client.key
ExecStart=/usr/local/libexec/observability-deadman.py tick --config /etc/observability-deadman/deadman-current.json --state /var/lib/observability-deadman/state.json
# Two Telegram request/read bounds, one capped retry delay, two reverse-health
# request bounds, and durable state updates fit below this fail-closed ceiling.
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/observability-deadman
ReadOnlyPaths=/etc/observability-deadman /usr/local/libexec/observability-deadman.py
MemoryMax=64M
TasksMax=16
LimitNOFILE=1024
