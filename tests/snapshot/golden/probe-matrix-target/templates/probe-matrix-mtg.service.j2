[Unit]
Description=Probe matrix MTProto target
After=network-online.target
Wants=network-online.target

[Service]
User=probe-mtg
Group=probe-mtg
ExecStart=/usr/local/bin/probe-matrix-mtg run /etc/probe-matrix/mtg.toml
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
