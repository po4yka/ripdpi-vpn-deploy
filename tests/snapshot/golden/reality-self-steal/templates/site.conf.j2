# Managed by Ansible role `reality-self-steal`.
# Combined field layout without the client address, referer or user agent.
log_format vpn_self_steal '- - - [$time_local] "$request" $status $body_bytes_sent "-" "-"';
server {
    listen 127.0.0.1:8443 ssl http2;
    server_name edge.vpn.example.com;

    server_tokens off;
    root /var/www/reality-self-steal;
    index index.html;

    ssl_certificate /etc/nginx/reality-self-steal/current/fullchain.pem;
    ssl_certificate_key /etc/nginx/reality-self-steal/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # REALITY clients offer X25519 only, so it stays first.
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:reality_self_steal:1m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/reality-self-steal.access.log vpn_self_steal;
    error_log /var/log/nginx/reality-self-steal.error.log warn;
}
