[Unit]
Description=Load validated split-hop egress NAT policy
After=local-fs.target systemd-sysctl.service nftables.service
Wants=nftables.service
Before=wg-quick@shop0.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -c -f /etc/wireguard/split-hop-egress.nft
ExecStart=/usr/sbin/nft -f /etc/wireguard/split-hop-egress.nft

[Install]
WantedBy=multi-user.target
