destroy table inet split_hop_ingress
table inet split_hop_ingress {
  chain output {
    type route hook output priority mangle; policy accept;
    meta nfproto ipv6 ct direction original meta skuid { 971, 972 } reject with icmpv6 type admin-prohibited
    meta nfproto ipv4 ct state new ct direction original meta skuid { 971, 972 } ct mark set 1
    ct mark 1 meta mark set ct mark
  }
  chain egress_guard {
    # OUTPUT retains its original interface after marking; check final egress here.
    type filter hook postrouting priority 0; policy accept;
    meta nfproto ipv4 ct direction original meta skuid { 971, 972 } oifname != { "lo", "shop0" } drop
    # Rerouted sockets chose their MSS from the public route; fit the tunnel MTU.
    oifname "shop0" tcp flags syn tcp option maxseg size set rt mtu
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    meta nfproto ipv4 ct direction original ct mark 1 oifname "shop0" snat ip to 10.200.0.1
  }
}
