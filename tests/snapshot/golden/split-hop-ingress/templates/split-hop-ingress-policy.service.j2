[Unit]
Description=Retain split-hop ingress recipient boundary
After=local-fs.target systemd-sysctl.service nftables.service
Wants=nftables.service
# Recipient egress units must not start ahead of the boundary at boot.
Before=wg-quick@shop0.service ripdpi-transport-generation.service ripdpi-transport-normalizer.service ripdpi-transport-direct.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -c -f /etc/wireguard/split-hop-ingress.nft
ExecStart=/usr/sbin/nft -f /etc/wireguard/split-hop-ingress.nft
# Marked flows keep an error route whenever the tunnel route is absent: the tunnel's
# own default shadows this one and disappears with the device. An existing rule refuses.
ExecStartPost=-/usr/sbin/ip rule add fwmark 1 table 200
ExecStartPost=/usr/sbin/ip route replace unreachable default table 200 metric 4294967295
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
