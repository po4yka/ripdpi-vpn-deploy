#!/usr/bin/env python3
"""Subscription delivery service. Listens on 127.0.0.1; nginx proxies
both /bootstrap/<token> (single-use) and /sub/<token> (long-lived).

Three properties matter:

  * Hashed-on-disk storage. The plaintext token never touches disk —
    the operator hands the URL to the client, the service hashes the
    inbound URL token with sha256 and reads from
    subscription_dir/<route>/<hex>. A disk copy alone is not a usable
    subscription URL.

  * Per-token expiry. The sidecar <hash>.meta JSON file can carry an
    `expires` field (ISO date string or unix epoch). The service
    refuses to serve and on /bootstrap/ also deletes both files.

  * Audit log of reads. One JSONL record per successful or rejected
    fetch, written to reads_log. Records carry only the hash prefix
    (first 8 chars), source IP, route, and bytes — enough to detect
    mass-pull patterns without leaking secrets to disk.

Revocation: the file revoked_file holds one hash per line. The service
reloads it on every request so updates take effect instantly without
needing a service restart.

Managed by Ansible role subscription-host; do not hand-edit.
"""
from __future__ import annotations

import datetime as _dt
import contextlib
import fcntl
import time
import uuid
import errno
import hashlib
import json
import logging
import os
import pathlib
import re
import socket
import stat
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SUBSCRIPTION_DIR = pathlib.Path("/var/lib/vpn-subscription")
LISTEN_ADDR      = "127.0.0.1"
LISTEN_PORT      = 8445
READS_LOG        = pathlib.Path("/var/log/vpn-subscription/reads.log")
REVOKED_FILE     = pathlib.Path("/var/lib/vpn-subscription/revoked")
MIRROR_GENERATIONS = SUBSCRIPTION_DIR / ".vpn-sub-mirror-generations"
MIRROR_CURRENT = SUBSCRIPTION_DIR / ".vpn-sub-mirror-current"
CONSUMED_BOOTSTRAP_DIR = SUBSCRIPTION_DIR / ".vpn-bootstrap-consumed"

BOOTSTRAP_REPLAY_HORIZON = 2592000
BOOTSTRAP_MAX_LIFETIME = 604800
BOOTSTRAP_MAX_MARKERS = 10000
READS_LOG_MAX_BYTES = 10485760
READS_LOG_BACKUP_COUNT = 4
BOOTSTRAP_TOKEN_RE = re.compile(r"^b1_([0-9]{10})_([A-Za-z0-9_-]{43})$")
FENCE_NAME = ".vpn-bootstrap-retired-before"
STATE_LOCK_NAME = ".vpn-bootstrap-state.lock"

PATH_RE = re.compile(r"^/(bootstrap|sub)/([A-Za-z0-9_-]{16,64})$")

_lock = threading.Lock()
# The tombstone directory is immutable for this service process. A replacement
# after startup is unsafe because it could hide a previously consumed token.
_consumption_directory_identity: tuple[int, int] | None = None

logging.basicConfig(
    format="vpn-bootstrap[%(process)d]: %(levelname)s %(message)s",
    level=logging.INFO,
    stream=sys.stderr,
)


def _hash(token: str) -> str:
    return hashlib.sha256(token.encode("ascii")).hexdigest()


def _open_revocation():
    descriptor = os.open(REVOKED_FILE, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    try:
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1
                or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o600):
            raise OSError("unsafe revocation authority")
        return os.fdopen(descriptor, "r", encoding="ascii")
    except BaseException:
        os.close(descriptor)
        raise


def _is_revoked(token_hash: str) -> bool | None:
    try:
        # Re-open safely on every request so replacement cannot bypass authority.
        with _open_revocation() as fh:
            for line in fh:
                entry = line.strip().lower()
                if not entry or entry.startswith("#"):
                    continue
                if not re.fullmatch(r"[0-9a-f]{64}", entry):
                    raise ValueError("invalid revocation authority")
                if entry == token_hash.strip().lower():
                    return True
    except (OSError, UnicodeError, ValueError):
        logging.error("revocation authority unavailable or unsafe")
        return None
    return False


def _audit(route: str, token_hash: str, outcome: str, src_ip: str, n_bytes: int) -> None:
    record = {
        "ts": int(_dt.datetime.now(tz=_dt.timezone.utc).timestamp()),
        "iso": _dt.datetime.now(tz=_dt.timezone.utc).isoformat(timespec="seconds"),
        "route": route,
        "token_prefix": token_hash[:8],
        "outcome": outcome,
        "src_ip": src_ip,
        "bytes": n_bytes,
    }
    try:
        _audit_append((json.dumps(record, sort_keys=True) + "\n").encode())
    except (OSError, ValueError):
        logging.warning("audit append unavailable or unsafe")


def _unique_authority_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate replay authority key")
        result[key] = value
    return result


def _sync_directory(descriptor):
    try:
        os.fsync(descriptor)
    except OSError as exc:
        if not (sys.platform != "linux" and exc.errno == errno.EINVAL):
            raise


def _private_file(directory, name, flags=os.O_RDONLY, *, create=False):
    descriptor = os.open(name, flags | os.O_NOFOLLOW | os.O_NONBLOCK | (os.O_CREAT if create else 0), 0o600, dir_fd=directory)
    metadata = os.fstat(descriptor)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid()
            or metadata.st_nlink != 1 or stat.S_IMODE(metadata.st_mode) != 0o600):
        os.close(descriptor)
        raise ValueError("unsafe private authority")
    return descriptor


@contextlib.contextmanager
def _state_authority():
    root = os.open(SUBSCRIPTION_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    lock = None
    try:
        metadata = os.fstat(root)
        if metadata.st_uid != os.geteuid() or metadata.st_mode & 0o077:
            raise ValueError("unsafe subscription authority")
        lock = _private_file(root, STATE_LOCK_NAME, os.O_RDWR)
        fcntl.flock(lock, fcntl.LOCK_EX)
        # Retained directory and lock must still be the named authority.
        named = SUBSCRIPTION_DIR.lstat()
        lock_named = os.stat(STATE_LOCK_NAME, dir_fd=root, follow_symlinks=False)
        if (named.st_dev, named.st_ino) != (metadata.st_dev, metadata.st_ino) or (lock_named.st_dev, lock_named.st_ino) != (os.fstat(lock).st_dev, os.fstat(lock).st_ino):
            raise ValueError("changed subscription authority")
        yield root
    finally:
        if lock is not None:
            os.close(lock)
        os.close(root)


def _read_fence(root):
    descriptor = _private_file(root, FENCE_NAME)
    if os.fstat(descriptor).st_size > 1024:
        os.close(descriptor)
        raise ValueError("oversized retirement authority")
    with os.fdopen(descriptor, "r", encoding="ascii") as stream:
        value = json.loads(stream.read(1025), object_pairs_hook=_unique_authority_object)
    if (not isinstance(value, dict) or set(value) != {"schema", "retired_before"}
            or type(value["schema"]) is not int or value["schema"] != 1 or type(value["retired_before"]) is not int
            or not 0 <= value["retired_before"] <= 9999999999):
        raise ValueError("invalid retirement authority")
    return value["retired_before"]


def _commit_fence(root, value):
    # Confirm existing provisioned authority before replacing it.
    if value <= _read_fence(root):
        return
    temporary = FENCE_NAME + "." + uuid.uuid4().hex
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=root)
    try:
        with os.fdopen(descriptor, "w", encoding="ascii") as stream:
            stream.write(json.dumps({"schema": 1, "retired_before": value}) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, FENCE_NAME, src_dir_fd=root, dst_dir_fd=root)
        _sync_directory(root)
    finally:
        try:
            os.unlink(temporary, dir_fd=root)
        except FileNotFoundError:
            pass


def _marker_records(directory):
    names = os.listdir(directory)
    if len(names) > 100000:
        raise ValueError("consumption authority exceeds hard bound")
    records = []
    for name in names:
        if not re.fullmatch(r"[0-9a-f]{64}", name):
            raise ValueError("unexpected consumption entry")
        descriptor = _private_file(directory, name)
        if os.fstat(descriptor).st_size > 1024:
            os.close(descriptor)
            raise ValueError("oversized consumption marker")
        with os.fdopen(descriptor, "r", encoding="ascii") as stream:
            raw = stream.read(1025)
        # Legacy empty markers are consumed authority, never guessed/deleted.
        if raw == "":
            records.append((name, None))
            continue
        value = json.loads(raw, object_pairs_hook=_unique_authority_object)
        if (not isinstance(value, dict) or set(value) != {"schema", "issued", "expires"}
                or type(value["schema"]) is not int or value["schema"] != 1 or type(value["issued"]) is not int
                or type(value["expires"]) is not int or not 0 < value["issued"] < value["expires"] <= 9999999999
                or value["expires"] - value["issued"] > BOOTSTRAP_REPLAY_HORIZON):
            raise ValueError("malformed consumption marker")
        records.append((name, value))
    return records


def _maintain_locked(root, now):
    fence = _read_fence(root)
    directory = _open_consumption_directory()
    if directory is None:
        raise ValueError("unsafe consumption directory")
    try:
        records = _marker_records(directory)
        retired = max(fence, max(0, now - BOOTSTRAP_REPLAY_HORIZON))
        _commit_fence(root, retired)  # acknowledged durability BEFORE any deletion
        for name, record in records:
            if record is not None and record["issued"] <= retired:
                os.unlink(name, dir_fd=directory)
        _sync_directory(directory)
        return sum(record is None or record["issued"] > retired for _, record in records)
    finally:
        os.close(directory)


def _bootstrap_issued(token, root, now):
    match = BOOTSTRAP_TOKEN_RE.fullmatch(token)
    if not match:
        return None
    issued = int(match[1])
    if issued <= _read_fence(root) or issued > now or now >= issued + BOOTSTRAP_MAX_LIFETIME:
        return None
    return issued


def _audit_append(data=None):
    directory = os.open(READS_LOG.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    lock = None
    opened = []
    try:
        info = os.fstat(directory)
        if info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise ValueError("unsafe audit directory")
        lock = _private_file(directory, ".reads.lock", os.O_RDWR, create=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
        # Inspect the full supported archive namespace before changing metadata
        # or deleting excess history after a retention-policy contraction.
        names = [READS_LOG.name] + [READS_LOG.name + "." + str(i) for i in range(1, 15)]
        for name in names:
            try:
                fd = os.open(name, os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
            except FileNotFoundError:
                continue
            metadata = os.fstat(fd)
            if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid() or metadata.st_nlink != 1:
                os.close(fd)
                raise ValueError("unsafe audit file")
            opened.append((name, fd, metadata))
        for name, fd, metadata in opened:
            named = os.stat(name, dir_fd=directory, follow_symlinks=False)
            if (named.st_dev, named.st_ino) != (metadata.st_dev, metadata.st_ino):
                raise ValueError("changed audit authority")
            if name != READS_LOG.name and int(name.rsplit(".", 1)[1]) > READS_LOG_BACKUP_COUNT:
                os.unlink(name, dir_fd=directory)
                continue
            os.fchmod(fd, 0o600)
            if metadata.st_size > READS_LOG_MAX_BYTES:
                with os.fdopen(os.dup(fd), "r+b") as stream:
                    stream.seek(-READS_LOG_MAX_BYTES, os.SEEK_END)
                    tail = stream.read().partition(b"\n")[2]
                    stream.seek(0)
                    stream.write(tail)
                    stream.truncate()
        _sync_directory(directory)
        if data is None:
            return
        if len(data) > READS_LOG_MAX_BYTES:
            raise ValueError("audit record exceeds bound")
        current = _private_file(directory, READS_LOG.name, os.O_RDWR, create=True)
        size = os.fstat(current).st_size
        os.close(current)
        if size + len(data) > READS_LOG_MAX_BYTES:
            for i in range(READS_LOG_BACKUP_COUNT, 0, -1):
                source = READS_LOG.name if i == 1 else READS_LOG.name + "." + str(i - 1)
                try:
                    os.replace(source, READS_LOG.name + "." + str(i), src_dir_fd=directory, dst_dir_fd=directory)
                except FileNotFoundError:
                    pass
        fd = _private_file(directory, READS_LOG.name, os.O_WRONLY | os.O_APPEND, create=True)
        with os.fdopen(fd, "ab") as stream:
            stream.write(data)
    finally:
        for _, fd, _ in opened:
            os.close(fd)
        if lock is not None:
            os.close(lock)
        os.close(directory)


def _validate_bounds():
    for value, minimum, maximum in ((BOOTSTRAP_MAX_LIFETIME, 60, 2592000), (BOOTSTRAP_MAX_MARKERS, 1, 100000), (READS_LOG_MAX_BYTES, 4096, 104857600), (READS_LOG_BACKUP_COUNT, 1, 14)):
        if type(value) is not int or not minimum <= value <= maximum:
            raise ValueError("invalid retention bounds")


def _now_utc() -> _dt.datetime:
    return _dt.datetime.now(tz=_dt.timezone.utc)


def _payload_root() -> pathlib.Path | None:
    """Use the mirror generation only when its private pointer is trustworthy.

    Direct deployments never create this pointer and retain the legacy
    `subscription_dir/{sub,bootstrap}` layout unchanged.
    """
    try:
        pointer = MIRROR_CURRENT.lstat()
    except FileNotFoundError:
        try:
            MIRROR_GENERATIONS.lstat()
        except FileNotFoundError:
            return SUBSCRIPTION_DIR
        logging.error("mirror current pointer is missing")
        return None
    if not stat.S_ISLNK(pointer.st_mode):
        logging.error("mirror current pointer is not a symlink")
        return None
    try:
        target = pathlib.PurePath(os.readlink(MIRROR_CURRENT))
        if target.is_absolute() or ".." in target.parts:
            raise ValueError("pointer escapes generation root")
        generation = SUBSCRIPTION_DIR / target
        if generation.parent != MIRROR_GENERATIONS or not generation.name.startswith("generation-"):
            raise ValueError("pointer has unexpected target")
        root_meta = MIRROR_GENERATIONS.lstat()
        generation_meta = generation.lstat()
        for path, metadata in ((MIRROR_GENERATIONS, root_meta), (generation, generation_meta)):
            if (
                not stat.S_ISDIR(metadata.st_mode)
                or stat.S_ISLNK(metadata.st_mode)
                or metadata.st_uid != os.geteuid()
                or metadata.st_mode & 0o077
            ):
                raise ValueError(f"unsafe mirror generation path: {path}")
    except (OSError, ValueError) as exc:
        logging.error("mirror generation is unavailable: %s", exc)
        return None
    return generation


def _consumption_tombstone(token_hash: str) -> pathlib.Path:
    if not re.fullmatch(r"[0-9a-f]{64}", token_hash):
        raise ValueError("invalid bootstrap token digest")
    return CONSUMED_BOOTSTRAP_DIR / token_hash


def _open_consumption_directory() -> int | None:
    """Open the service-owned tombstone directory through retained fds."""
    global _consumption_directory_identity
    flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
    root: int | None = None
    directory: int | None = None
    retained = False
    try:
        root = os.open(SUBSCRIPTION_DIR, flags)
        directory = os.open(".vpn-bootstrap-consumed", flags, dir_fd=root)
        root_metadata = os.fstat(root)
        directory_metadata = os.fstat(directory)
        named_root = SUBSCRIPTION_DIR.lstat()
        identity = (directory_metadata.st_dev, directory_metadata.st_ino)
        if (
            not stat.S_ISDIR(root_metadata.st_mode)
            or root_metadata.st_uid != os.geteuid()
            or root_metadata.st_mode & 0o077
            or (root_metadata.st_dev, root_metadata.st_ino)
            != (named_root.st_dev, named_root.st_ino)
            or not stat.S_ISDIR(directory_metadata.st_mode)
            or directory_metadata.st_uid != os.geteuid()
            or directory_metadata.st_mode & 0o077
            or (
                _consumption_directory_identity is not None
                and _consumption_directory_identity != identity
            )
        ):
            logging.error("bootstrap consumption state is unsafe")
            return None
        if _consumption_directory_identity is None:
            _consumption_directory_identity = identity
        retained = True
        return directory
    except OSError as exc:
        logging.error("bootstrap consumption state is unavailable: %s", exc)
        return None
    finally:
        if root is not None:
            os.close(root)
        if directory is not None and not retained:
            os.close(directory)


def _trusted_consumption_directory() -> bool:
    directory = _open_consumption_directory()
    if directory is None:
        return False
    os.close(directory)
    return True


def _bootstrap_consumed(token_hash: str) -> bool | None:
    """Read a durable one-token marker without following a supplied path."""
    try:
        name = _consumption_tombstone(token_hash).name
    except ValueError as exc:
        logging.error("bootstrap consumption state read failed: %s", exc)
        return None
    directory = _open_consumption_directory()
    if directory is None:
        return None
    try:
        try:
            metadata = os.stat(name, dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            return False
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            logging.error("bootstrap consumption marker is unsafe")
            return None
        return True
    except OSError as exc:
        logging.error("bootstrap consumption state read failed: %s", exc)
        return None
    finally:
        os.close(directory)


def _record_bootstrap_consumption(token_hash: str, issued: int) -> bool | None:
    """Durably consume one bootstrap token before its payload is delivered."""
    try:
        name = _consumption_tombstone(token_hash).name
    except ValueError as exc:
        logging.error("bootstrap consumption state write failed: %s", exc)
        return None
    directory = _open_consumption_directory()
    if directory is None:
        return None
    descriptor: int | None = None
    try:
        try:
            descriptor = os.open(
                name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
                dir_fd=directory,
            )
        except FileExistsError:
            # A second service process won the durable consume race. Do not
            # deliver the bytes this process already read.
            os.close(directory)
            directory = None
            consumed = _bootstrap_consumed(token_hash)
            return False if consumed else None
        os.fchmod(descriptor, 0o600)
        data = (json.dumps({"schema": 1, "issued": issued, "expires": issued + BOOTSTRAP_MAX_LIFETIME}) + "\n").encode()
        remaining = memoryview(data)
        while remaining:
            count = os.write(descriptor, remaining)
            if count <= 0:
                raise OSError("short marker write")
            remaining = remaining[count:]
        os.fsync(descriptor)
    except OSError as exc:
        logging.error("bootstrap consumption state write failed: %s", exc)
        if descriptor is not None:
            try:
                os.unlink(name, dir_fd=directory)
            except OSError:
                pass
        os.close(directory)
        directory = None
        return None
    finally:
        if descriptor is not None:
            os.close(descriptor)
    try:
        os.fsync(directory)
    except OSError as exc:
        # The macOS fixture filesystem rejects directory fsync; production
        # Linux must acknowledge the durability boundary.
        if not (sys.platform != "linux" and exc.errno == errno.EINVAL):
            logging.error("bootstrap consumption directory sync failed: %s", exc)
            return None
    finally:
        os.close(directory)
    # Reopen through the named namespace. This catches a directory swap after
    # the marker write; the process identity also blocks later resurrection.
    if _bootstrap_consumed(token_hash) is not True:
        logging.error("bootstrap consumption marker readback failed")
        return None
    return True


def _expired(meta_path: pathlib.Path) -> bool | None:
    if not meta_path.is_file():
        return False
    try:
        meta = json.loads(meta_path.read_text())
        if not isinstance(meta, dict):
            raise ValueError("expiry metadata must be an object")
    except (OSError, ValueError) as exc:
        logging.error("expiry metadata read failed: %s", exc)
        return None
    expires = meta.get("expires")
    if expires is None:
        return False
    now = _now_utc()
    if isinstance(expires, (int, float)):
        try:
            exp_dt = _dt.datetime.fromtimestamp(float(expires), tz=_dt.timezone.utc)
        except (OSError, OverflowError, ValueError) as exc:
            logging.error("expiry timestamp is invalid: %s", exc)
            return None
    else:
        try:
            exp_dt = _dt.datetime.fromisoformat(str(expires))
            if exp_dt.tzinfo is None:
                exp_dt = exp_dt.replace(tzinfo=_dt.timezone.utc)
            else:
                exp_dt = exp_dt.astimezone(_dt.timezone.utc)
        except ValueError as exc:
            logging.error("expiry metadata is invalid: %s", exc)
            return None
    return exp_dt <= now


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):  # silence default per-request log
        return

    def _src_ip(self) -> str:
        return self.headers.get("X-Real-IP") or self.client_address[0]

    def do_GET(self):  # noqa: N802
        m = PATH_RE.match(self.path)
        if not m:
            self.send_error(404)
            return
        route, token = m.group(1), m.group(2)
        token_hash = _hash(token)
        src_ip = self._src_ip()
        single_use = (route == "bootstrap")

        try:
            with _lock, _state_authority() as authority:
                now = int(time.time())
                issued = None
                marker_count = 0
                if single_use:
                    issued = _bootstrap_issued(token, authority, now)
                    if issued is None:
                        _audit(route, token_hash, "retired-or-invalid", src_ip, 0)
                        self.send_error(410, "Gone")
                        return
                revoked = _is_revoked(token_hash)
                if revoked is None:
                    _audit(route, token_hash, "revocation-unavailable", src_ip, 0)
                    self.send_error(503, "Service Unavailable")
                    return
                if revoked:
                    _audit(route, token_hash, "revoked", src_ip, 0)
                    self.send_error(410, "Gone")
                    return
                if single_use:
                    consumed = _bootstrap_consumed(token_hash)
                    if consumed is None:
                        _audit(route, token_hash, "consumption-unavailable", src_ip, 0)
                        self.send_error(503, "Service Unavailable")
                        return
                    if consumed:
                        _audit(route, token_hash, "consumed", src_ip, 0)
                        self.send_error(410, "Gone")
                        return
                payload_root = _payload_root()
                if payload_root is None:
                    _audit(route, token_hash, "mirror-state-invalid", src_ip, 0)
                    self.send_error(503, "Service Unavailable")
                    return
                route_dir = payload_root / route
                path = route_dir / token_hash
                meta_path = route_dir / f"{token_hash}.meta"
                try:
                    data = path.read_bytes()
                except FileNotFoundError:
                    _audit(route, token_hash, "unknown", src_ip, 0)
                    self.send_error(410, "Gone")
                    return
                expired = _expired(meta_path)
                if expired is None:
                    _audit(route, token_hash, "expiry-unavailable", src_ip, 0)
                    self.send_error(503, "Service Unavailable")
                    return
                if expired:
                    _audit(route, token_hash, "expired", src_ip, 0)
                    # On /bootstrap/, purge the payload so the next read for
                    # the same token also returns 410 fast. On /sub/, leave
                    # the payload — an admin may bump the .meta date.
                    if single_use:
                        try: path.unlink()
                        except FileNotFoundError: pass
                        try: meta_path.unlink()
                        except FileNotFoundError: pass
                    self.send_error(410, "Gone")
                    return
                if single_use:
                    marker_count = _maintain_locked(authority, now)
                    if _bootstrap_issued(token, authority, now) is None:
                        _audit(route, token_hash, "retired-or-invalid", src_ip, 0)
                        self.send_error(410, "Gone")
                        return
                    if marker_count >= BOOTSTRAP_MAX_MARKERS:
                        _audit(route, token_hash, "consumption-capacity", src_ip, 0)
                        self.send_error(503, "Service Unavailable")
                        return
                    # Record the external no-follow tombstone before delivery.
                    # Mirror generations may restore this payload on a later pull.
                    consumed = _record_bootstrap_consumption(token_hash, issued)
                    if consumed is None:
                        _audit(route, token_hash, "consumption-unavailable", src_ip, 0)
                        self.send_error(503, "Service Unavailable")
                        return
                    if not consumed:
                        _audit(route, token_hash, "consumed", src_ip, 0)
                        self.send_error(410, "Gone")
                        return
                    try: path.unlink()
                    except FileNotFoundError: pass
                    if meta_path.is_file():
                        try: meta_path.unlink()
                        except FileNotFoundError: pass
        except (OSError, ValueError):
            _audit(route, token_hash, "state-unavailable", src_ip, 0)
            self.send_error(503, "Service Unavailable")
            return

        _audit(route, token_hash, "consumed", src_ip, len(data))
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Robots-Tag", "noindex, nofollow")
        self.end_headers()
        self.wfile.write(data)


def main(arguments=()):
    _validate_bounds()
    if list(arguments) == ["--maintain"]:
        with _state_authority() as authority:
            _maintain_locked(authority, int(time.time()))
        _audit_append()
        return
    if arguments:
        raise ValueError("unsupported service arguments")
    with _state_authority() as authority:
        _read_fence(authority)
    # Only convergence may provision revocation authority. Restart cannot
    # invent an empty deny list after loss of durable state.
    if _is_revoked("") is None:
        raise RuntimeError("revocation authority is not safely provisioned")
    for sub in ("bootstrap", "sub"):
        (SUBSCRIPTION_DIR / sub).mkdir(parents=True, exist_ok=True)
    if not _trusted_consumption_directory():
        raise RuntimeError("bootstrap consumption state is not safely provisioned")
    READS_LOG.parent.mkdir(parents=True, exist_ok=True)
    server = ThreadingHTTPServer((LISTEN_ADDR, LISTEN_PORT), Handler)
    logging.info("listening on http://%s:%d/  dir=%s",
                 LISTEN_ADDR, LISTEN_PORT, SUBSCRIPTION_DIR)
    try:
        server.serve_forever()
    finally:
        server.server_close()


if __name__ == "__main__":
    main(sys.argv[1:])
