[Unit]
Description=VPN subscription payload mirror (pull hashed-on-disk tree from build worker)
Documentation=https://github.com/po4yka/vpn-deploy/blob/main/docs/SUBSCRIPTION-HOST-SEPARATION.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vpn-bootstrap
Group=vpn-bootstrap
ExecStart=/usr/local/bin/vpn-sub-mirror.sh

# Hardening — mirrors vpn-bootstrap.service.j2. MemoryDenyWriteExecute is
# intentionally omitted: the mirror invokes rsync/ssh (and optionally
# restic), which may map writable+executable pages on some libc builds.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vpn-subscription
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=yes
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Keep resource mutations denied except rsync's startup setrlimit call. The
# default seccomp action is SIGSYS, so denying that call prevents every pull.
SystemCallFilter=~@privileged @resources
SystemCallFilter=setrlimit

[Install]
WantedBy=multi-user.target
