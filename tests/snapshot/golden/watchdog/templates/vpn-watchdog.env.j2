# Loaded by /etc/systemd/system/vpn-watchdog.service.
# 0600 root:root.

WATCHDOG_PROVIDER=ntfy

NTFY_URL=https://ntfy.sh
NTFY_TOPIC=REPLACE_WITH_LONG_RANDOM_TOPIC



FAIL_THRESHOLD=3
STATE_FILE=/var/lib/vpn-watchdog/state
ALERTS_PER_HOUR_MAX=4
KICKS_PER_HOUR_MAX=3

ENABLE_XRAY=true
ENABLE_NGINX_XHTTP=true
ENABLE_HYSTERIA=true
ENABLE_AMNEZIAWG=true

XRAY_PORT=443
XRAY_API_SERVER=127.0.0.1:10086
XRAY_REALITY_CONFIG=/etc/vpn-watchdog-reality.json
XRAY_REALITY_PROBE_TIMEOUT=15
XRAY_REALITY_PROBE_URL="https://REPLACE_WITH_OWNED_204_CANARY/healthz"
XRAY_REALITY_PROBE_EXPECTED_STATUS=204
XRAY_REALITY_PROBES=443:31082,2053:31083

NGINX_PORT=443
HYSTERIA_PORT=443
AWG_INTERFACE=awg0
