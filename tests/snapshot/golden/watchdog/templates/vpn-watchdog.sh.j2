#!/usr/bin/env bash
# Probes each enabled transport. After FAIL_THRESHOLD consecutive failures,
# restarts failed transport units and pushes an alert via ntfy.sh / Pushover.
# Recovery and notification rate limits are kept in $STATE_FILE.
set -euo pipefail

# Loaded by systemd EnvironmentFile=
: "${FAIL_THRESHOLD:=3}"
: "${STATE_FILE:=/var/lib/vpn-watchdog/state}"
: "${ALERTS_PER_HOUR_MAX:=4}"
: "${KICKS_PER_HOUR_MAX:=3}"
: "${XRAY_BIN:=/usr/local/bin/xray}"
: "${HYSTERIA_BIN:=/usr/local/bin/hysteria}"
: "${TRANSPORT_GENERATION_BIN:=/usr/local/libexec/ripdpi-transport-egress/generation.py}"
: "${XRAY_VALIDATE_BIN:=/usr/local/libexec/vpn-xray-validate}"
: "${XRAY_API_SERVER:=127.0.0.1:10086}"
: "${XRAY_REALITY_CONFIG:=/etc/vpn-watchdog-reality.json}"
: "${XRAY_REALITY_PROBES:=}"
: "${XRAY_XHTTP_PROBES:=}"
: "${XRAY_REALITY_PROBE_URL:=}"
: "${XRAY_REALITY_PROBE_EXPECTED_STATUS:=204}"
: "${XRAY_REALITY_PROBE_TIMEOUT:=15}"
: "${XRAY_REALITY_TARGET:=}"
: "${XRAY_REALITY_SNI:=}"
: "${WATCHDOG_STATE_BIN:=/usr/local/libexec/vpn-watchdog-state.py}"
: "${WATCHDOG_NOTIFY_BIN:=/usr/local/libexec/vpn-watchdog-notify.py}"
HOSTNAME="${HOSTNAME:-$(hostname -f 2>/dev/null || hostname)}"

mkdir -p "$(dirname "$STATE_FILE")"

# State format (key=value, one per line):
#   consecutive_fails=<n>
#   last_alert_epoch=<unix>
#   alerts_this_hour=<n>
#   alerts_hour_started=<unix>
#   kicks_this_hour=<n>
#   kicks_hour_started=<unix>
declare -A STATE
# Validate the complete prior budget before any recovery or notification action.
budget="$("$WATCHDOG_STATE_BIN" read "$STATE_FILE")"
while IFS='=' read -r k v; do
  [[ -n "$k" ]] && STATE["$k"]="$v"
done <<< "$budget"
STATE[consecutive_fails]="${STATE[consecutive_fails]:-0}"
STATE[last_alert_epoch]="${STATE[last_alert_epoch]:-0}"
STATE[alerts_this_hour]="${STATE[alerts_this_hour]:-0}"
STATE[alerts_hour_started]="${STATE[alerts_hour_started]:-$(date +%s)}"
STATE[kicks_this_hour]="${STATE[kicks_this_hour]:-0}"
STATE[kicks_hour_started]="${STATE[kicks_hour_started]:-$(date +%s)}"

probe_results=()
probe_failures=()
probe_failure_count=0
declare -A failed_units=()
declare -A invalid_units=()

probe() {
  local name="$1"; shift
  if "$@" >/dev/null 2>&1; then
    probe_results+=("OK    $name")
  else
    probe_results+=("FAIL  $name")
    probe_failures+=("$name")
    probe_failure_count=$(( probe_failure_count + 1 ))
  fi
}

probe_unit() {
  local unit="$1"; shift
  local failures_before=$probe_failure_count
  probe "$@"
  if (( probe_failure_count > failures_before )); then
    failed_units["$unit"]=1
  fi
}

# A failed configuration check withholds recovery for its unit: a restart
# would stop a running service that still holds its last valid configuration.
probe_config() {
  local unit="$1"; shift
  local failures_before=$probe_failure_count
  probe_unit "$unit" "$@"
  if (( probe_failure_count > failures_before )); then
    invalid_units["$unit"]=1
  fi
}

xray_probe_pid=""

cleanup_reality_client() {
  local deadline
  if [[ -n "$xray_probe_pid" ]] && kill -0 "$xray_probe_pid" 2>/dev/null; then
    kill "$xray_probe_pid" 2>/dev/null || true
    deadline=$(( SECONDS + 2 ))
    while kill -0 "$xray_probe_pid" 2>/dev/null && (( SECONDS < deadline )); do
      sleep 0.1
    done
    if kill -0 "$xray_probe_pid" 2>/dev/null; then
      kill -KILL "$xray_probe_pid" 2>/dev/null || true
    fi
    deadline=$(( SECONDS + 2 ))
    while kill -0 "$xray_probe_pid" 2>/dev/null && (( SECONDS < deadline )); do
      sleep 0.1
    done
    if kill -0 "$xray_probe_pid" 2>/dev/null; then
      echo "watchdog: owned client cleanup unconfirmed" >&2
      return 1
    fi
    wait "$xray_probe_pid" 2>/dev/null || true
  fi
  xray_probe_pid=""
}

# A stable private directory is only a kernel lock, never a persistent lease.
# Children inherit fd 9, so a surviving owned client also retains exclusion.
probe_claim="${STATE_FILE}.probe"
mkdir -p -m 0700 "$probe_claim"
if ! python3 -c 'import os,stat,sys; s=os.lstat(sys.argv[1]); sys.exit(not (stat.S_ISDIR(s.st_mode) and s.st_uid==os.geteuid() and stat.S_IMODE(s.st_mode)==0o700))' "$probe_claim"; then
  echo "watchdog: unsafe private probe lock" >&2
  exit 1
fi
exec 9<"$probe_claim"
if ! flock -n 9; then
  echo "watchdog: private probe lock unavailable" >&2
  exit 1
fi
# Re-read after admission: a completed concurrent invocation may have published
# a newer budget between the ancestry check and acquiring the kernel lock.
budget="$("$WATCHDOG_STATE_BIN" read "$STATE_FILE")"
while IFS='=' read -r k v; do
  [[ -n "$k" ]] && STATE["$k"]="$v"
done <<< "$budget"
trap cleanup_reality_client EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

persist_state() {
  local key
  for key in consecutive_fails last_alert_epoch alerts_this_hour alerts_hour_started kicks_this_hour kicks_hour_started; do
    echo "${key}=${STATE[$key]}"
  done | "$WATCHDOG_STATE_BIN" write "$STATE_FILE"
}

socks_listener_ready() {
  local port="$1"
  ss -lnt | awk -v suffix=":${port}" '$4 ~ (suffix "$") { found=1 } END { exit !found }'
}

socks_listener_owned() {
  local port="$1"
  ss -lntp | awk -v address="127.0.0.1:${port}" -v owner="pid=${xray_probe_pid}," \
    '$4 == address && index($0, owner) { found=1 } END { exit !found }'
}

reality_canary_round_trip() {
  local socks_port="$1"
  local status
  kill -0 "$xray_probe_pid" 2>/dev/null || return 1
  socks_listener_owned "$socks_port" || return 1
  status="$(curl -sS -o /dev/null -w '%{http_code}' \
    --max-time "$XRAY_REALITY_PROBE_TIMEOUT" \
    --noproxy '' --proxy "socks5h://127.0.0.1:${socks_port}" \
    "$XRAY_REALITY_PROBE_URL")" || return 1
  kill -0 "$xray_probe_pid" 2>/dev/null || return 1
  socks_listener_owned "$socks_port" || return 1
  [[ "$status" == "$XRAY_REALITY_PROBE_EXPECTED_STATUS" ]]
}

probe_reality_listeners() {
  local spec server_port socks_port label
  local -a probe_specs=() labels=()
  if [[ "${ENABLE_XRAY:-true}" == true ]]; then
    IFS=',' read -r -a probe_specs <<< "$XRAY_REALITY_PROBES"
    for spec in "${probe_specs[@]}"; do labels+=(REALITY); done
  fi
  if [[ "${ENABLE_NGINX_XHTTP:-false}" == true ]]; then
    IFS=',' read -r -a xhttp_specs <<< "$XRAY_XHTTP_PROBES"
    for spec in "${xhttp_specs[@]}"; do probe_specs+=("$spec"); labels+=(XHTTP); done
  fi

  if [[ -z "$XRAY_REALITY_PROBE_URL" || ! -r "$XRAY_REALITY_CONFIG" || -z "${probe_specs[*]}" ]]; then
    probe "xray REALITY round-trip configured" false
    return
  fi

  # Never adopt a foreign SOCKS listener, even while our client is alive.
  for spec in "${probe_specs[@]}"; do
    socks_port="${spec#*:}"
    if socks_listener_ready "$socks_port"; then
      probe "xray REALITY private listener occupied" false
      return
    fi
  done

  "$XRAY_BIN" run -config "$XRAY_REALITY_CONFIG" >/dev/null 2>&1 &
  xray_probe_pid=$!

  local deadline=$(( $(python3 -c 'import time; print(time.monotonic_ns())') + XRAY_REALITY_PROBE_TIMEOUT * 1000000000 ))
  local all_ready=0
  while (( $(python3 -c 'import time; print(time.monotonic_ns())') < deadline )); do
    kill -0 "$xray_probe_pid" 2>/dev/null || break
    all_ready=1
    for spec in "${probe_specs[@]}"; do
      socks_port="${spec#*:}"
      if ! socks_listener_ready "$socks_port"; then
        all_ready=0
        break
      fi
    done
    (( all_ready == 1 )) && break
    sleep 0.2
  done

  local index=0
  for spec in "${probe_specs[@]}"; do
    label="${labels[$index]}"
    index=$(( index + 1 ))
    server_port="${spec%%:*}"
    socks_port="${spec#*:}"
    if (( all_ready == 1 )) && kill -0 "$xray_probe_pid" 2>/dev/null; then
      probe "xray ${label} TCP/${server_port} round-trip" \
        reality_canary_round_trip "$socks_port"
    else
      probe "xray ${label} TCP/${server_port} round-trip" false
    fi
  done

  cleanup_reality_client
}

probe_hysteria_round_trip() {
  local port="${HYSTERIA_PROBE_SOCKS_PORT:-31110}" deadline
  local config="${CREDENTIALS_DIRECTORY:-/run/credentials/vpn-watchdog.service}/hysteria.yaml"
  if [[ ! -r "$config" || -z "$XRAY_REALITY_PROBE_URL" ]] || socks_listener_ready "$port"; then
    probe "hysteria authenticated probe unavailable" false
    return
  fi
  "$HYSTERIA_BIN" client -c "$config" >/dev/null 2>&1 &
  xray_probe_pid=$!
  deadline=$(( SECONDS + XRAY_REALITY_PROBE_TIMEOUT ))
  while (( SECONDS < deadline )); do
    kill -0 "$xray_probe_pid" 2>/dev/null || break
    socks_listener_ready "$port" && break
    sleep 0.2
  done
  # An authentication/trust/target failure is red, but never restart authority.
  if kill -0 "$xray_probe_pid" 2>/dev/null && socks_listener_ready "$port"; then
    probe "hysteria authenticated round-trip" reality_canary_round_trip "$port"
  else
    probe "hysteria authenticated round-trip" false
  fi
  cleanup_reality_client
}

if [[ "${ENABLE_XRAY:-true}" == "true" ]]; then
  probe_unit "xray.service" "xray.service active" systemctl is-active --quiet xray
  IFS=',' read -r -a reality_listeners <<< "$XRAY_REALITY_PROBES"
  for listener in "${reality_listeners[@]}"; do
    server_port="${listener%%:*}"
    probe_unit "xray.service" "xray TCP/${server_port} listening" \
      bash -c "ss -lnt | awk '{print \$4}' | grep -q ':${server_port}\$'"
  done
  probe_config "xray.service" "xray config valid" \
    "$XRAY_VALIDATE_BIN" --config /etc/xray/config.json
  probe_unit "xray.service" "xray StatsService query" \
    "$XRAY_BIN" api statsquery "--server=${XRAY_API_SERVER}"
fi

if [[ "${ENABLE_NGINX_XHTTP:-true}" == "true" ]]; then
  probe_unit "nginx.service" "nginx.service active" systemctl is-active --quiet nginx
  probe_config "nginx.service" "nginx -t" nginx -t
  for port in "${NGINX_PORT:?NGINX_PORT is required}" "${NGINX_FALLBACK_PORT:-0}"; do
    if (( port > 0 )); then
      probe_unit "nginx.service" "nginx XHTTP TCP/${port} listening" \
        timeout 2 bash -c "</dev/tcp/127.0.0.1/${port}"
    fi
  done
  # The backend belongs to Xray. A backend outage never restarts nginx.
  probe_unit "xray.service" "XHTTP backend active" systemctl is-active --quiet xray
  probe_unit "xray.service" "XHTTP backend TCP/${XHTTP_BACKEND_PORT:?XHTTP_BACKEND_PORT is required} listening" \
    timeout 2 bash -c "</dev/tcp/127.0.0.1/${XHTTP_BACKEND_PORT}"
fi

if [[ "${ENABLE_XRAY:-true}" == true || "${ENABLE_NGINX_XHTTP:-false}" == true ]]; then
  probe_reality_listeners
fi

if [[ "${ENABLE_HYSTERIA:-false}" == "true" ]]; then
  probe_unit "hysteria-server.service" "hysteria-server active" systemctl is-active --quiet hysteria-server
  probe_unit "hysteria-server.service" "hysteria UDP/${HYSTERIA_PORT} listening" \
    bash -c "ss -lnu | awk '{print \$4}' | grep -q ':${HYSTERIA_PORT}\$'"
  probe_hysteria_round_trip
fi

if [[ "${ENABLE_AMNEZIAWG:-false}" == "true" ]]; then
  IFS=',' read -r -a awg_interfaces <<< "${AWG_INTERFACES:?AWG_INTERFACES is required}"
  for interface in "${awg_interfaces[@]}"; do
    probe_unit "awg-quick@${interface}.service" "AWG iface ${interface} up" \
      awg show "$interface"
  done
fi

# Always check load + disk, soft signals
probe "disk root <90%" \
  bash -c '[[ $(df --output=pcent / | tail -1 | tr -d " %") -lt 90 ]]'

# ---------------------------------------------------------------------------
# Failure-class detectors. Each detector that fires adds a tag to the
# alert. Operators index runbooks off the tag instead of triaging a
# generic up/down failure. See docs/how-to/incident.md for the mapping
# (policy_reject_spike → "blackhole/VLESS-reject spike"; tcp_listen_wedge
# → "wedged listener"; nginx_403_spike → "probe/scrape wave").
# ---------------------------------------------------------------------------
declare -A classes=()

xray_access="/var/lib/vpn-xray-logs/access.log"
if [[ "${ENABLE_XRAY:-true}" == "true" && -r "$xray_access" ]]; then
  recent_reject="$(tail -n 2000 "$xray_access" 2>/dev/null \
    | grep -c -E '(\[[^]]*\bblock\])|(^| )rejected( |$)' || true)"
  if [[ "${recent_reject:-0}" -gt 20 ]]; then
    classes[policy_reject_spike]="${recent_reject} blackhole/VLESS-reject events in tail"
  fi
fi

nginx_access="/var/log/nginx/access.log"
if [[ "${ENABLE_NGINX_XHTTP:-true}" == "true" && -r "$nginx_access" ]]; then
  recent_403="$(tail -n 2000 "$nginx_access" 2>/dev/null \
    | awk '$9==403{n++} END{print n+0}')"
  if [[ "${recent_403:-0}" -gt 50 ]]; then
    classes[nginx_403_spike]="${recent_403} 403 responses in tail"
  fi
fi

# REALITY target drift: the borrowed site must still answer the exact handshake
# a REALITY client sends (TLS 1.3, X25519 key share, ALPN h2, trusted chain for
# the first server name). A loopback target is the owned self-steal site and
# is covered by the nginx probes above.
reality_target_handshake() {
  python3 - "$XRAY_REALITY_TARGET" "$XRAY_REALITY_SNI" <<'PY'
import socket, ssl, sys
target, sni = sys.argv[1], sys.argv[2]
host, port = target.rsplit(":", 1)
context = ssl.create_default_context()
context.minimum_version = ssl.TLSVersion.TLSv1_3
context.set_alpn_protocols(["h2", "http/1.1"])
try:
    context.set_ecdh_curve("X25519")
except (ValueError, ssl.SSLError):
    pass  # older OpenSSL bindings cannot pin the group; the controller validator still does
with socket.create_connection((host.strip("[]"), int(port)), timeout=10) as raw:
    with context.wrap_socket(raw, server_hostname=sni) as tls:
        sys.exit(0 if tls.selected_alpn_protocol() == "h2" else 2)
PY
}
if [[ "${ENABLE_XRAY:-true}" == "true" && -n "$XRAY_REALITY_TARGET" && -n "$XRAY_REALITY_SNI" \
      && "$XRAY_REALITY_TARGET" != 127.* && "$XRAY_REALITY_TARGET" != "[::1]:"* ]]; then
  if ! reality_target_handshake >/dev/null 2>&1; then
    classes[reality_target_drift]="REALITY target no longer completes a TLS 1.3/X25519/h2 handshake for the configured name"
  fi
fi

if [[ "${ENABLE_XRAY:-true}" == "true" ]]; then
  for listener in "${reality_listeners[@]}"; do
    server_port="${listener%%:*}"
    if ! timeout 2 bash -c "</dev/tcp/127.0.0.1/${server_port}" 2>/dev/null; then
      classes[tcp_listen_wedge]="cannot open configured xray TCP listener"
    fi
  done
fi

now=$(date +%s)

if (( probe_failure_count > 0 )); then
  STATE[consecutive_fails]=$(( STATE[consecutive_fails] + 1 ))
else
  STATE[consecutive_fails]=0
fi

# Reset hourly alert counter if hour rolled over
if (( now - STATE[alerts_hour_started] >= 3600 )); then
  STATE[alerts_hour_started]=$now
  STATE[alerts_this_hour]=0
fi

if (( now - STATE[kicks_hour_started] >= 3600 )); then
  STATE[kicks_hour_started]=$now
  STATE[kicks_this_hour]=0
fi

kick_results=()
if (( STATE[consecutive_fails] >= FAIL_THRESHOLD )); then
  for unit in "${!failed_units[@]}"; do
    if [[ -n "${invalid_units[$unit]:-}" ]]; then
      kick_results+=("RESTART WITHHELD  $unit (config invalid)")
      continue
    fi
    if (( STATE[kicks_this_hour] >= KICKS_PER_HOUR_MAX )); then
      break
    fi
    if [[ "$unit" == "xray.service" || "$unit" == "hysteria-server.service" ]]; then
      recovery=(python3 -Es "$TRANSPORT_GENERATION_BIN" recover
        --config /etc/ripdpi/transport-egress/generation.json
        --normalizer-config /etc/ripdpi/transport-egress/normalizer.json --unit "$unit")
    else
      recovery=(systemctl restart "$unit")
    fi
    # Reserve the durable attempt before an external action or notification.
    STATE[kicks_this_hour]=$(( STATE[kicks_this_hour] + 1 ))
    persist_state
    if "${recovery[@]}"; then
      kick_results+=("RESTARTED  $unit")
    else
      kick_results+=("RESTART FAILED  $unit")
    fi
  done
fi

should_alert=0
if (( STATE[consecutive_fails] >= FAIL_THRESHOLD )) \
   && (( STATE[alerts_this_hour] < ALERTS_PER_HOUR_MAX )); then
  should_alert=1
fi
# An active failure-class event is always alert-worthy even without N
# consecutive probe failures (a policy_reject_spike can be live without
# breaking the listener). The non-emptiness check uses ${!classes[*]}
# (returns the keys) rather than the array-length form, because the
# array-length form embeds a Jinja2 comment delimiter inside this
# bash-via-Jinja2 template.
if [[ -n "${!classes[*]}" ]] \
   && (( STATE[alerts_this_hour] < ALERTS_PER_HOUR_MAX )); then
  should_alert=1
fi

result_text="$(printf '%s\n' "${probe_results[@]}")"
class_summary="${!classes[*]}"

# Build class block for the alert body + ntfy tag list.
class_lines=""
class_tags=""
for cls in "${!classes[@]}"; do
  class_lines+="class=${cls}: ${classes[$cls]}"$'\n'
  class_tags+=",class:${cls}"
done

if (( should_alert )); then
  fail_list="$(printf '%s, ' "${probe_failures[@]}" | sed 's/, $//')"
  if [[ -n "$fail_list" ]]; then
    title="VPN[$HOSTNAME] failing: ${fail_list}"
  else
    title="VPN[$HOSTNAME] class signal: ${class_summary}"
  fi
  body="consecutive_fails=${STATE[consecutive_fails]}
${class_lines}${result_text}"

  STATE[last_alert_epoch]=$now
  STATE[alerts_this_hour]=$(( STATE[alerts_this_hour] + 1 ))
  persist_state
  if ! printf '%s' "$body" | "$WATCHDOG_NOTIFY_BIN" \
    --title "$title" --tags "warning,vpn,${HOSTNAME}${class_tags}" --timeout 10; then
    echo "watchdog: notification delivery failed" >&2
  fi

fi

# Persist the final diagnostic counters even when no action was requested.
persist_state

# Always log to journal so `journalctl -u vpn-watchdog.service` shows status
echo "watchdog: consecutive_fails=${STATE[consecutive_fails]} alerts_this_hour=${STATE[alerts_this_hour]} kicks_this_hour=${STATE[kicks_this_hour]} classes=${class_summary:-none}"
printf '%s\n' "${probe_results[@]}"
if [[ -n "${kick_results[*]}" ]]; then
  printf '%s\n' "${kick_results[@]}"
fi
if [[ -n "${!classes[*]}" ]]; then
  printf '%s' "$class_lines"
fi

# Preserve the failed result for systemd and external health checks. The timer
# remains scheduled independently of the oneshot service's exit status.
(( probe_failure_count == 0 ))
