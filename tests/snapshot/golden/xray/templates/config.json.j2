
{
  "log": {
    "loglevel": "warning",
    "access": "{{ xray_log_dir | default('/var/log/xray') }}/access.log",
    "error": "{{ xray_log_dir | default('/var/log/xray') }}/error.log"
  },
  "api": {
    "tag": "api",
    "listen": "127.0.0.1:10086",
    "services": ["StatsService"]
  },
  "stats": {},
  "dns": {
    "servers": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "queryStrategy": "UseIP",
    "tag": "dns-inbound"
  },
  "inbounds": [
    {
      "tag": "vless-reality-primary",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "REPLACE_WITH_UUID",
            "flow": "xtls-rprx-vision",
            "email": "phone-primary"
          },
          {
            "id": "REPLACE_WITH_DEDICATED_WATCHDOG_UUID",
            "flow": "xtls-rprx-vision",
            "email": "watchdog-primary"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "REPLACE_WITH_LOW_PROFILE_HTTPS_TARGET:443",
          "xver": 0,
          "serverNames": ["REPLACE_WITH_LOW_PROFILE_HOSTNAME"],
          "privateKey": "REPLACE_WITH_PRIVATE_KEY",
          "shortIds": [
            "REPLACE_WITH_8HEX",
            "REPLACE_WITH_DEDICATED_WATCHDOG_8HEX"
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "vless-reality-fallback",
      "listen": "0.0.0.0",
      "port": 2053,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "REPLACE_WITH_UUID",
            "flow": "xtls-rprx-vision",
            "email": "phone-fallback"
          },
          {
            "id": "REPLACE_WITH_DEDICATED_WATCHDOG_UUID",
            "flow": "xtls-rprx-vision",
            "email": "watchdog-fallback"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "REPLACE_WITH_LOW_PROFILE_HTTPS_TARGET:443",
          "xver": 0,
          "serverNames": ["REPLACE_WITH_LOW_PROFILE_HOSTNAME"],
          "privateKey": "REPLACE_WITH_PRIVATE_KEY",
          "shortIds": [
            "REPLACE_WITH_8HEX",
            "REPLACE_WITH_DEDICATED_WATCHDOG_8HEX"
          ]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "tag": "vless-xhttp-localhost",
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "REPLACE_WITH_UUID",
            "email": "phone-xhttp"
          },
          {
            "id": "REPLACE_WITH_DEDICATED_WATCHDOG_UUID",
            "email": "watchdog-xhttp"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/app-sync",
          "mode": "auto"
        },
        "sockopt": {
          "trustedXForwardedFor": ["127.0.0.1"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"],
        "metadataOnly": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "socks",
      "settings": {"servers": [{
        "address": "127.0.0.1", "port": 12080,
        "users": [{"user": "normalizer-direct-xray", "pass": "REPLACE_WITH_TRANSPORT_DIRECT_XRAY_PASSWORD"}]
      }]}
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "comment": "Probe-defense: block BitTorrent on the exit (graylist correlates BT)",
        "protocol": ["bittorrent"],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "comment": "Probe-defense: blackhole outbound QUIC (UDP/443) to deny a UDP/443 leak fingerprint. TRADE-OFF: this disables HTTP/3 for every proxied client — browsers and apps transparently fall back to HTTP/2 over TCP (slower on lossy / high-latency links, no functional break). Disable per-deploy with xray_block_quic_outbound=false; see roles/xray/README.md.",
        "network": "udp",
        "port": "443",
        "outboundTag": "block"
      },
      {
        "type": "field",
        "comment": "Default recipient traffic enters the guarded metadata normalizer",
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 2,
        "downlinkOnly": 5,
        "bufferSize": 4
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  }
}
