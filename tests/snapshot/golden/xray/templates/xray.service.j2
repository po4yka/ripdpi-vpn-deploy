[Unit]
Description=Xray Service
Documentation=https://xtls.github.io/
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
User=xray
Group=xray
Environment=XRAY_LOCATION_ASSET={{ xray_geodata_asset_dir if (vpn.enable_geodata | default(false) | bool) else xray_bundled_asset_dir }}
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Self-heal log file ownership before each start. A previous failed start
# (e.g. systemd briefly starting xray as root before User=xray took effect,
# or a misconfigured first converge) can leave access.log/error.log root-
# owned, after which xray crash-loops on "permission denied". Run as root
# via the `+` prefix; the rest of the unit still runs as User=xray. This
# is idempotent and cheap (~1ms), so it pays for itself the first time it
# rescues a drifted install.
ExecStartPre=+/bin/sh -c '[ -e {{ xray_log_dir | default('/var/log/xray') }}/access.log ] || install -o xray -g xray -m 0640 /dev/null {{ xray_log_dir | default('/var/log/xray') }}/access.log; [ -e {{ xray_log_dir | default('/var/log/xray') }}/error.log ] || install -o xray -g xray -m 0640 /dev/null {{ xray_log_dir | default('/var/log/xray') }}/error.log; chown xray:xray {{ xray_log_dir | default('/var/log/xray') }}/access.log {{ xray_log_dir | default('/var/log/xray') }}/error.log; chmod 0640 {{ xray_log_dir | default('/var/log/xray') }}/access.log {{ xray_log_dir | default('/var/log/xray') }}/error.log'

ExecStart=/usr/local/bin/xray run -config {{ xray_config_dir | default('/etc/xray') }}/config.json
Restart=on-failure
RestartSec=5s

LimitNOFILE=1048576

PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadWritePaths={{ xray_log_dir | default('/var/log/xray') }} /var/lib/xray {{ xray_config_dir | default('/etc/xray') }}

[Install]
WantedBy=multi-user.target
