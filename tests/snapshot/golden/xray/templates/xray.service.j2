[Unit]
Description=Xray Service
Documentation=https://xtls.github.io/
After=network-online.target nss-lookup.target
Wants=network-online.target
BindsTo=ripdpi-transport-normalizer.service
After=ripdpi-transport-normalizer.service

[Service]
Type=exec
User=xray
Group=xray
Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray
Environment=XRAY_RUNTIME_BINARY=/opt/xray/releases/v26.3.27/xray
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Convergence provisions logs beneath a root-owned directory. Startup performs
# no privileged repair of runtime paths.
ExecStart=/opt/xray/releases/v26.3.27/xray run -config /etc/xray/config.json
Restart=on-failure
RestartSec=5s

LimitNOFILE=1048576

PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
ReadWritePaths={{ xray_log_dir | default('/var/log/xray') }} /var/lib/xray /etc/xray

[Install]
WantedBy=multi-user.target
