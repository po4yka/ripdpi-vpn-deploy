#compdef vpnd
_vpnd() {
    local context="" word
    for word in ${words[2,-2]}; do
        case "$context:$word" in
            :deploy) context=deploy ;;
            :reconverge) context=reconverge ;;
            :share) context=share ;;
            :doctor) context=doctor ;;
            :probe) context=probe ;;
            :probe-matrix) context=probe-matrix ;;
            :preflight) context=preflight ;;
            :fleet) context=fleet ;;
            fleet:status) context='fleet status' ;;
            fleet:rotate) context='fleet rotate' ;;
            fleet:drift) context='fleet drift' ;;
            :host) context=host ;;
            host:list) context='host list' ;;
            host:show) context='host show' ;;
            host:add) context='host add' ;;
            host:remove) context='host remove' ;;
            :ai-docs) context=ai-docs ;;
            :update) context=update ;;
            :completions) context=completions ;;
        esac
    done
    case "$context" in
        '') local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--version:show program'"'"'s version number and exit' '-V:show program'"'"'s version number and exit' 'deploy:Interactive deploy wizard.' 'reconverge:Idempotent re-deploy against existing hosts.' 'share:Bundled recipient handoff (URL, QR, sing-box and app cards).' 'doctor:Diagnostic bundle.' 'probe:Profile-aware probing.' 'probe-matrix:Multi-protocol simultaneity DPI probe across a configured matrix.' 'preflight:Pre-deploy guards.' 'fleet:Fleet-wide operations.' 'host:Local host registry.' 'ai-docs:Machine-readable docs endpoints.' 'update:Check for a newer vpnd release (cached 24 h).' 'completions:Emit shell completions to stdout.'); _describe 'vpnd' suggestions ;;
        deploy) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--skip-precheck:Skip running pre-deploy guards (mirrors SKIP_PRECHECK=1).' '--tag-on-success:Tag a known-good commit after a successful verify run.'); _describe 'vpnd' suggestions ;;
        reconverge) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--host:Limit to a single host from the registry.' '--dry-run:Stop after dry-run; do not apply.'); _describe 'vpnd' suggestions ;;
        share) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--qr:Also emit a QR code image.' '--type:QR payload type (default\: singbox).' singbox:singbox uri:uri '--out:Output directory (default\: ./share/<client>/).' '--token-stdin:Read the opaque subscription token from stdin.' '--token-file:Read the opaque subscription token from a 0600 file.'); _describe 'vpnd' suggestions ;;
        doctor) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--host:Host alias from the registry; omitted = active env'"'"'s primary host.' '--ai:Format output as a clipboard-ready prompt for an AI assistant.' '--clip:Copy AI prompt to the system clipboard (requires --ai).' '--bundle:Pack a diagnostic gzip-tar bundle at this path (orthogonal to --ai).'); _describe 'vpnd' suggestions ;;
        probe) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--host:Host alias from the registry; omitted = active env'"'"'s primary host.' '--profile:Which profile to probe (default\: all).' p0:p0 p1:p1 p2:p2 all:all); _describe 'vpnd' suggestions ;;
        probe-matrix) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--duration:Run duration; plain seconds or NN{s,m,h,d} (default\: 4h).' '--poll-interval-seconds:Poll interval between matrix sweeps (seconds); overrides config.' '--config:Matrix config YAML (default\: <root>/vpnd/config/probe-matrix.yaml).' '--output:Report JSON output (default\: <root>/vpnd/state/probe-matrix-<unix-ms>.json).' '--json:Emit a machine-readable run summary instead of the human path line.'); _describe 'vpnd' suggestions ;;
        preflight) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--skip-certs:Skip the certificate-validity check (faster smoke).'); _describe 'vpnd' suggestions ;;
        fleet) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' 'status:Summary table across every host\:env pair.' 'rotate:Coordinated rotation across the fleet.' 'drift:Diff fleet state against the last known-good tag.'); _describe 'vpnd' suggestions ;;
        'fleet status') local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).'); _describe 'vpnd' suggestions ;;
        'fleet rotate') local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--plan:Path to the fleet plan YAML.' '--resume:Resume a partially-completed rotation.' '--dry-run:Show what would happen without making changes.'); _describe 'vpnd' suggestions ;;
        'fleet drift') local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).'); _describe 'vpnd' suggestions ;;
        host) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' 'list:List registered hosts.' 'show:Show one host record.' 'add:Add a host record.' 'remove:Remove a host record.'); _describe 'vpnd' suggestions ;;
        'host list') local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--json:Emit a machine-readable JSON array instead of the table.'); _describe 'vpnd' suggestions ;;
        'host show') local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--json:Emit compact single-line JSON instead of the pretty form.'); _describe 'vpnd' suggestions ;;
        'host add') local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Host environment.' '--provider:Host cloud provider.' '--ipv4:Host IPv4 address.' '--ipv6:Host IPv6 address.'); _describe 'vpnd' suggestions ;;
        'host remove') local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).'); _describe 'vpnd' suggestions ;;
        ai-docs) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '--out:Output directory (default\: ./ai-docs/).'); _describe 'vpnd' suggestions ;;
        update) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print the GitHub API URL that would be queried and exit without fetching.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).'); _describe 'vpnd' suggestions ;;
        completions) local -a suggestions; suggestions=('-h:show this help message and exit' '--help:show this help message and exit' '--explain:Print underlying invocations without running them.' '--yes:Skip interactive confirmation.' '-y:Skip interactive confirmation.' '--root:Override repository root (VPN_DEPLOY_ROOT; default\: discover from cwd).' '--env:Target environment (VPN_ENV; default\: prod).' '-e:Target environment (VPN_ENV; default\: prod).' '--provider:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).' '-p:Cloud provider Terraform root (VPN_PROVIDER; default\: upcloud).'); _describe 'vpnd' suggestions ;;
    esac
}
_vpnd "$@"
